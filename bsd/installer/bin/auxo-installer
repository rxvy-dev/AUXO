#!/usr/bin/env python3
"""auxo-installer — install AuxoBSD from the live session.

  auxo-installer              the graphical installer (needs root: the desktop icon uses sudo)
  auxo-installer --dry-run    go through every page, print the commands, change nothing
"""
import os
import sys

sys.path[:0] = [os.environ.get("AUXO_LIB", "/usr/local/lib/auxo"),
                os.environ.get("AUXO_INSTALLER_LIB", "/usr/local/lib/auxo/installer")]

from auxo_bsdinstall.gui import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
