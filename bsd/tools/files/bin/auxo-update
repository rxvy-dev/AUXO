#!/bin/sh
# auxo-update — update the whole AuxoBSD system, safely:
#   1. a ZFS boot environment of the current system (go back with auxo-rollback or the boot menu)
#   2. FreeBSD base system security/errata updates (freebsd-update)
#   3. every package (pkg), and Void Linux packages too if xbps is on
#
#   auxo-update        ask before upgrading packages
#   auxo-update -y     don't ask
set -u
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
yes=""
[ "${1:-}" = "-y" ] && yes=1

step() { printf '\033[1m::\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }

snap=$(sed -n 's/^SNAPSHOTS="\{0,1\}\([a-z]*\).*/\1/p' /etc/auxo/auxo.conf 2>/dev/null)
rootfs=$(mount -p | awk '$2 == "/" {print $3}')
if [ "$rootfs" = cd9660 ]; then
    echo "auxo-update: this is the live session; install AuxoBSD first" >&2
    exit 1
fi

if [ "$rootfs" = zfs ] && [ "${snap:-on}" != off ]; then
    be="auxo-$(date +%Y%m%d-%H%M%S)"
    step "boot environment $be (if something breaks: auxo-rollback, or pick it in the boot menu)"
    bectl create "$be" || warn "couldn't create a boot environment; continuing without one"
fi

kern_before=$(freebsd-version -k)
step "FreeBSD base system"
# exits non-zero when there is simply nothing to install
PAGER="cat" freebsd-update --not-running-from-cron fetch || warn "freebsd-update fetch failed"
PAGER="cat" freebsd-update --not-running-from-cron install || true

step "packages"
pkg update || warn "couldn't refresh the package catalogue"
if [ -n "$yes" ]; then pkg upgrade -y; else pkg upgrade; fi
pkg autoremove -y >/dev/null 2>&1 || true

if [ -x /compat/void/usr/bin/xbps-install ] && [ -x /usr/local/bin/xbps-install ]; then
    step "Void Linux packages (xbps)"
    /usr/local/bin/xbps-install -Su -y || warn "xbps update failed"
fi

if [ -n "${SUDO_USER:-}" ]; then
    # shellcheck disable=SC2016  # expands in the user's shell, on purpose
    su "$SUDO_USER" -c 'mkdir -p "$HOME/.local/state/auxo" && touch "$HOME/.local/state/auxo/last-update"' \
        2>/dev/null || true
fi

kern_after=$(freebsd-version -k)
echo
if [ "$kern_before" != "$kern_after" ]; then
    step "the kernel was updated ($kern_before → $kern_after): reboot to use it"
else
    step "all up to date"
fi
