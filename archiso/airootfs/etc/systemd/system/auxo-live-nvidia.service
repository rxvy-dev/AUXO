[Unit]
Description=Auxo live: load NVIDIA driver when booted with auxo.nvidia=1
ConditionKernelCommandLine=auxo.nvidia=1
Before=display-manager.service systemd-user-sessions.service
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/bin/modprobe -r nouveau
ExecStart=/usr/bin/modprobe nvidia_drm modeset=1 fbdev=1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
