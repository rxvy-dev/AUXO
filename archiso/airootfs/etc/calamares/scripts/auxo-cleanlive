#!/usr/bin/env bash
# Runs inside the target chroot (Calamares shellprocess@cleanlive).
set -u

# 0. /boot must not be btrfs-compressed. GRUB can fail to read zstd-compressed
#    kernels/initramfs on btrfs ("premature end of file ... vmlinuz-linux").
#    New files inherit the no-compress flag, so set it first, then rewrite
#    anything unpackfs already put there (microcode images, grub files).
if [[ $(stat -f -c %T /boot 2>/dev/null) == btrfs ]]; then
  mkdir -p /boot
  chattr +m /boot 2>/dev/null || true
  btrfs property set /boot compression none 2>/dev/null || true
  find /boot -xdev -type d -exec chattr +m {} + 2>/dev/null || true
  while IFS= read -r -d '' f; do
    cp -a -- "$f" "$f.auxo-tmp" && mv -f -- "$f.auxo-tmp" "$f"
  done < <(find /boot -xdev -type f -print0)
  echo "disabled btrfs compression on /boot"
fi

# 1. kernels: copy vmlinuz for every installed kernel (same as the kernel's pacman hook)
for dir in /usr/lib/modules/*/; do
  [[ -f $dir/pkgbase && -f $dir/vmlinuz ]] || continue
  pkgbase=$(<"$dir/pkgbase")
  install -Dm644 "$dir/vmlinuz" "/boot/vmlinuz-$pkgbase"
  echo "installed /boot/vmlinuz-$pkgbase"
done

# 2. live-only configuration
rm -f  /etc/mkinitcpio.conf.d/archiso.conf \
       /etc/sudoers.d/10-auxo-live \
       /etc/sddm.conf.d/00-auxo-live.conf \
       /etc/modprobe.d/auxo-live-nvidia.conf \
       /etc/xdg/autostart/auxo-live-welcome.desktop \
       /etc/pacman.d/hooks/uncomment-mirrors.hook \
       /etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
       /etc/systemd/journald.conf.d/volatile-storage.conf \
       /etc/systemd/logind.conf.d/do-not-suspend.conf \
       /etc/ssh/sshd_config.d/10-archiso.conf \
       /root/.automated_script.sh /root/.zlogin \
       /usr/local/bin/choose-mirror /usr/local/bin/livecd-sound \
       /usr/local/bin/auxo-live-setup /usr/local/bin/auxo-install /usr/local/bin/auxo-netcheck /usr/local/bin/auxo-release-disk \
       /usr/share/applications/auxo-install.desktop
rm -rf /usr/local/share/livecd-sound /etc/systemd/system/getty@tty1.service.d

# 3. live-only services
for u in choose-mirror.service pacman-init.service livecd-alsa-unmuter.service etc-pacman.d-gnupg.mount \
         auxo-live-nvidia.service auxo-live-setup.service; do
  rm -f "/etc/systemd/system/$u" /etc/systemd/system/*.wants/"$u"
done

# 4. the installer itself and the archiso initramfs hooks
pacman -Rns --noconfirm calamares mkinitcpio-archiso 2>/dev/null || true

# 5. sane permissions / defaults
chmod 700 /root
sed -i 's#^root:x:0:0:root:/root:/usr/bin/zsh#root:x:0:0:root:/root:/bin/bash#' /etc/passwd
mkdir -p /etc/auxo
rm -rf /etc/calamares /usr/share/auxo/calamares-modules
sync
exit 0
