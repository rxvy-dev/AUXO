#!/usr/bin/env bash
# auxo-release-disk — free a disk that is "busy" so the installer can repartition it.
#
#   sudo auxo-release-disk                 # show what is holding each disk (changes nothing)
#   sudo auxo-release-disk /dev/nvme0n1    # release that disk (asks before doing anything)
#   sudo auxo-release-disk /dev/nvme0n1 --wipe   # release and erase partition table + signatures
#
# It releases, in this order: leftover installer mounts (/tmp/calamares-root-*),
# any mount of the disk's partitions, swap, LVM, LUKS, mdraid, then processes
# still holding the partitions open. It never touches the live USB.
set -uo pipefail

R='\e[31m'; G='\e[32m'; Y='\e[33m'; B='\e[1m'; N='\e[0m'
say()  { printf "${B}▲${N} %s\n" "$*"; }
warn() { printf "${Y}!${N} %s\n" "$*"; }
die()  { printf "${R}error:${N} %s\n" "$*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

DEV=""; WIPE=0
for a in "$@"; do
  case "$a" in
    --wipe) WIPE=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    /dev/*) DEV=$a ;;
    *) die "unknown argument: $a" ;;
  esac
done

parts_of() { lsblk -lnpo NAME "$1" | tail -n +2; }

# Unmount one mount point. For real on-disk filesystems, first stop processes
# using it (a lazy unmount alone would keep the filesystem — and the disk — alive).
# Pseudo/bind filesystems (/dev, /proc, /sys, /run binds) are only detached:
# killing their users would kill the whole live session.
release_mount() {
  local t=$1 fs
  fs=$(findmnt -no FSTYPE --mountpoint "$t" 2>/dev/null | head -n1)
  case "$fs" in
    devtmpfs|proc|sysfs|tmpfs|devpts|efivarfs|securityfs|cgroup*|pstore|bpf|tracefs|debugfs|mqueue|hugetlbfs|fusectl|configfs|autofs|"")
      umount "$t" 2>/dev/null || umount -l "$t" ;;
    *)
      umount "$t" 2>/dev/null && return 0
      fuser -k -TERM -m "$t" >/dev/null 2>&1; sleep 1
      umount "$t" 2>/dev/null && return 0
      fuser -k -KILL -m "$t" >/dev/null 2>&1; sleep 1
      umount "$t" 2>/dev/null || umount -l "$t" ;;
  esac
}

report() {
  local d=$1 p h
  printf "\n${B}%s${N}  %s\n" "$d" "$(lsblk -dno MODEL,SIZE "$d" | xargs)"
  for p in $d $(parts_of "$d"); do
    local base; base=$(basename "$p")
    local mnt; mnt=$(grep -h "^$p " /proc/*/mounts 2>/dev/null | awk '{print $2}' | sort -u | xargs)
    local sw; sw=$(awk -v p="$p" '$1==p{print "swap"}' /proc/swaps)
    local holders; holders=$(find /sys/class/block/"$base"/holders -mindepth 1 -maxdepth 1 -printf '%f ' 2>/dev/null)
    local procs; procs=$(fuser "$p" 2>/dev/null | xargs)
    [[ -n $mnt$sw$holders$procs ]] || continue
    printf "  %-16s" "$p"
    [[ -n $mnt ]] && printf " mounted:%s" "$mnt"
    [[ -n $sw ]] && printf " swap"
    [[ -n $holders ]] && printf " held-by:%s" "$holders"
    [[ -n $procs ]] && printf " open-by-pids:%s" "$procs"
    printf "\n"
  done
}

LIVE=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null | sed 's/[0-9]*$//; s/p$//')

if [[ -z $DEV ]]; then
  say "Leftover installer mounts:"
  findmnt -rno TARGET | grep '^/tmp/calamares-root-' || echo "  none"
  for d in $(lsblk -dnpo NAME,TYPE | awk '$2=="disk"{print $1}'); do report "$d"; done
  echo; echo "Release a disk with:  sudo $0 /dev/<disk>"
  exit 0
fi

[[ -b $DEV ]] || die "$DEV is not a block device"
t=$(lsblk -dno TYPE "$DEV")
[[ $t == disk || ( $t == loop && ${AUXO_ALLOW_LOOP:-0} == 1 ) ]] || die "$DEV is a partition — pass the whole disk (e.g. /dev/nvme0n1)"
[[ -n $LIVE && $DEV == "$LIVE"* ]] && die "$DEV is the live USB you booted from"

lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DEV"
report "$DEV"
echo
if (( WIPE )); then
  printf "${R}${B}This will ERASE every partition on %s (%s).${N}\n" "$DEV" "$(lsblk -dno MODEL,SIZE "$DEV" | xargs)"
  read -rp "Type the disk name (e.g. nvme0n1) to confirm: " ans
  [[ $ans == "$(basename "$DEV")" ]] || die "not confirmed"
else
  read -rp "Release $DEV (unmount, swapoff, close LVM/LUKS/RAID, stop processes using it)? [y/N] " ans
  [[ ${ans,,} == y* ]] || exit 1
fi

say "stopping the installer if it is still running"
pkill -x calamares 2>/dev/null && sleep 2

say "unmounting leftover installer targets"
# every mount under any /tmp/calamares-root-*, deepest first — the root itself may
# already be gone while /dev, /proc, /sys binds are still hanging off it
for t in $(findmnt -rno TARGET | grep '^/tmp/calamares-root-' | sort -r); do
  release_mount "$t" && echo "  $t"
done

say "unmounting $DEV and its partitions"
for p in "$DEV" $(parts_of "$DEV"); do
  # every mount of this partition, deepest first (btrfs subvolumes can be mounted many times)
  for t in $(findmnt -rno TARGET -S "$p" | sort -r); do
    for sub in $(findmnt -rno TARGET | grep "^$t/" | sort -r); do release_mount "$sub"; done
    release_mount "$t"; echo "  $p  $t"
  done
done

say "swap"
for p in "$DEV" $(parts_of "$DEV"); do swapoff "$p" 2>/dev/null && echo "  swapoff $p"; done

say "LVM / LUKS / RAID holders"
for p in "$DEV" $(parts_of "$DEV"); do
  for h in /sys/class/block/"$(basename "$p")"/holders/*; do
    [[ -e $h ]] || continue
    hn=$(basename "$h")
    if [[ $hn == md* ]]; then
      mdadm --stop "/dev/$hn" && echo "  stopped /dev/$hn"
    elif [[ $hn == dm-* ]]; then
      name=$(cat "/sys/class/block/$hn/dm/name")
      uuid=$(cat "/sys/class/block/$hn/dm/uuid" 2>/dev/null)
      for t in $(findmnt -rno TARGET -S "/dev/mapper/$name" | sort -r); do umount -R -l "$t"; done
      swapoff "/dev/mapper/$name" 2>/dev/null
      case "$uuid" in
        LVM-*)  vg=$(lvs --noheadings -o vg_name "/dev/mapper/$name" 2>/dev/null | xargs)
                [[ -n $vg ]] && vgchange -an "$vg" && echo "  deactivated VG $vg" ;;
        CRYPT-*) cryptsetup close "$name" && echo "  closed LUKS $name" ;;
        *)      dmsetup remove "$name" && echo "  removed dm $name" ;;
      esac
    fi
  done
done

say "processes still using $DEV"
for p in "$DEV" $(parts_of "$DEV"); do
  pids=$(fuser "$p" 2>/dev/null | xargs)
  if [[ -n $pids ]]; then
    ps -o pid=,comm= -p ${pids// /,} | sed 's/^/  killing /'
    fuser -k -TERM "$p" >/dev/null 2>&1; sleep 1; fuser -k -KILL "$p" >/dev/null 2>&1
  fi
done

if (( WIPE )); then
  say "erasing signatures and partition table"
  for p in $(parts_of "$DEV" | sort -r); do wipefs -af "$p" >/dev/null; done
  wipefs -af "$DEV" || die "wipefs still failed — run '$0' (no args) and paste the output"
  sgdisk --zap-all "$DEV" >/dev/null 2>&1 || true
fi
partprobe "$DEV" 2>/dev/null; udevadm settle

echo; report "$DEV"
if [[ -z $(for p in "$DEV" $(parts_of "$DEV"); do fuser "$p" 2>/dev/null; ls /sys/class/block/"$(basename "$p")"/holders 2>/dev/null; grep -h "^$p " /proc/*/mounts 2>/dev/null; done) ]]; then
  printf "${G}✓ %s is free.${N} Start the installer again.\n" "$DEV"
else
  warn "something is still holding $DEV (see above). Rebooting the live USB always clears it."
fi
