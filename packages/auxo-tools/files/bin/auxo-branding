#!/bin/sh
# Applies Auxo's name to os-release and the login banner. Run by the auxo-tools
# package on install and by auxo-update after updates (base-files owns these files).
cat > /etc/os-release <<'OS'
NAME="Auxo Linux"
PRETTY_NAME="Auxo Linux"
ID=auxo
ID_LIKE=void
BUILD_ID=rolling
ANSI_COLOR="38;2;167;139;250"
HOME_URL="https://auxolinux.com/"
DOCUMENTATION_URL="https://auxolinux.com/docs/"
SUPPORT_URL="https://discord.gg/XbQ66dH5a7"
BUG_REPORT_URL="https://github.com/rxvy-dev/AUXO/issues"
LOGO=auxo-logo
OS
printf '\033[1mAuxo Linux\033[0m \\r (\\l)\n\n' > /etc/issue
