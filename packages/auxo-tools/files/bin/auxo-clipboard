#!/bin/sh
# auxo-clipboard — your clipboard history in a searchable list (Hyprland and Sway).
#   auxo-clipboard          pick something you copied earlier; it goes back on the clipboard
#   auxo-clipboard clear    forget the history
# The history is kept by `wl-paste --watch cliphist store`, started by the Auxo rices.
if ! command -v cliphist >/dev/null 2>&1; then
  notify-send "Clipboard history" "It isn't installed yet: sudo xbps-install cliphist" 2>/dev/null
  exit 1
fi
case "$1" in
  clear) cliphist wipe && notify-send "Clipboard history" "Cleared" 2>/dev/null; exit 0 ;;
  -h|--help) sed -n '2,5s/^# //p' "$0"; exit 0 ;;
esac
pkill -x wofi && exit 0           # pressed again: close it
sel=$(cliphist list | wofi --dmenu --prompt "Clipboard history" --insensitive --width 620 --height 440 \
      --cache-file /dev/null) || exit 0
printf '%s' "$sel" | cliphist decode | wl-copy
