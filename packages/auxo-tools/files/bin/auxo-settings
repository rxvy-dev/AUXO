    def export_rice(self):
        f, _ = QFileDialog.getSaveFileName(self, "Export your rice", os.path.join(HOME, f"my-rice{auxo_look.RICE_EXT}"),
                                           f"Auxo rice (*{auxo_look.RICE_EXT})")
        if f:
            if not f.endswith(auxo_look.RICE_EXT):
                f += auxo_look.RICE_EXT
            name, ok = QInputDialog.getText(self, "Name your rice", "Name shown when someone imports it:",
                                            text=f"{ME}'s Auxo rice")
            self.run(["look", "export", f, "--name", name if ok and name else f"{ME}'s Auxo rice"],
                     label=f"Rice saved to {os.path.basename(f)}")

    def import_rice(self):
        f, _ = QFileDialog.getOpenFileName(self, "Import a rice", HOME, f"Auxo rice (*{auxo_look.RICE_EXT});;All files (*)")
        if not f:
            return
        try:
            changes, acc, desk, name = auxo_look.rice_import(open(f).read())
        except (OSError, auxo_look.LookError) as e:
            QMessageBox.warning(self, "Import a rice", f"Couldn't read that file: {e}")
            return

        def accent_too(code):
            self.reload_look()
            if code == 0 and acc and acc != conf().get("ACCENT", DEFAULT):
                if QMessageBox.question(self, name, f"This rice uses the {acc} accent. Switch to it too?") \
                        == QMessageBox.StandardButton.Yes:
                    self.run(["accent", acc], root=True, label=f"Accent → {acc}",
                             done=lambda c: (self.restyle(), self.preview.update(), self.refresh_desktops()))
        self.run(["look", "import", f], label=f"Imported “{name}”", done=accent_too)

    def reload_look(self):
        """Read look.conf again and move every control to match (after a preset, import or reset)."""
        self.look = auxo_look.load(HOME)
        self.preview.set_look(self.look)
        widgets = [(self.s_gaps, "gaps"), (self.s_round, "rounding"), (self.s_border, "border")]
        for s_, k in widgets:
            s_.blockSignals(True)
            s_.setValue(int(self.look[k]))
            s_.blockSignals(False)
        for k, b in self.chk.items():
            b.blockSignals(True)
            b.setChecked(self.look[k] == "on")
            b.blockSignals(False)
        for d, b in ((self.mode_btns, "mode"), (self.bar_btns, "bar")):
            for v, btn in d.items():
                btn.setChecked(self.look[b] == v)
        self.size_spin.blockSignals(True)
        self.size_spin.setValue(int(self.look["font_size"]))
        self.size_spin.blockSignals(False)
        for cb, k in ((self.ui_font, "ui_font"), (self.mono_font, "mono_font")):
            cb.blockSignals(True)
            cb.setCurrentFont(QFont(self.look[k]))
            cb.blockSignals(False)
        for lbl, k in self.slider_labels:
            lbl.setText(f"{self.look[k]} px")
        self.restyle()

    def live_conf(self):
        conf_, path = {}, os.path.join(HOME, ".config/auxo/wallpaper-live.conf")
        try:
            import shlex
            for line in open(path):
                k, _, v = line.strip().partition("=")
                if k and not k.startswith("#"):
                    conf_[k] = shlex.split(v)[0] if v.strip() else ""
        except (OSError, ValueError):
            pass
        return conf_

    def live_mode_changed(self, *_a):
        mode = self.live_mode.currentData()
        self.live_video_row.setVisible(mode == "video")
        self.live_dn_row.setVisible(mode == "daynight")

    def choose_live_video(self):
        f, _ = QFileDialog.getOpenFileName(self, "Choose a video wallpaper", os.path.join(HOME, "Videos"),
                                           "Videos and GIFs (*.mp4 *.webm *.mkv *.mov *.gif)")
        if f:
            self.live_video_file = f
            self.live_video.setText(os.path.basename(f))

    def choose_live_pic(self, which):
        f, _ = QFileDialog.getOpenFileName(self, f"Choose the {which} wallpaper", os.path.join(HOME, "Pictures"),
                                           "Images (*.png *.jpg *.jpeg *.webp *.bmp)")
        if f:
            setattr(self, f"live_{which}", f)
            getattr(self, f"live_{which}_btn").setText(f"{which.capitalize()}: {os.path.basename(f)}")

    def apply_live_wallpaper(self):
        mode = self.live_mode.currentData()
        if mode == "video":
            f = getattr(self, "live_video_file", None) or self.live_conf().get("VIDEO")
            if not f:
                self.status.setText("Choose a video first")
                return
            args = ["video", f]
        elif mode == "daynight":
            args = ["daynight", self.live_day, self.live_night, "--day", self.live_day_at.time().toString("HH:mm"),
                    "--night", self.live_night_at.time().toString("HH:mm")]
        else:
            args = ["still"]
        self.run_prog(LIVE_WALL, args, label="Live wallpaper", shown="auxo-wallpaper")

    def choose_wallpaper(self):
        f, _ = QFileDialog.getOpenFileName(self, "Choose a wallpaper", os.path.join(HOME, "Pictures"),
                                           "Images (*.png *.jpg *.jpeg *.webp *.bmp)")
        if f:
            self.set_look("wallpaper", f, now=True)

    def page_windows(self):
        w, lay = self.page()
        self.heading(lay, "Windows & bar", "Gaps, rounded corners, borders, blur and the bar. The preview "
                                           "shows the result; your desktop follows a moment after you let go.")
        self.preview = LookPreview(self.look)
        lay.addWidget(self.preview)
        self.section(lay, "Presets", "Hyprland, Sway, i3, Chrono and the bars", keys="style theme lite fast old pc")
        grid = QGridLayout()
        grid.setSpacing(8)
        for i, (k, (name, desc, _v)) in enumerate(auxo_look.PRESETS.items()):
            b = QPushButton(name)
            b.setToolTip(desc)
            b.clicked.connect(lambda _=False, k=k, n=name: self.run(["look", "preset", k], label=f"Preset: {n}",
                                                                      done=lambda c: self.reload_look()))
            grid.addWidget(b, 0, i)
        lay.addLayout(grid)
        self.slider_labels = []

        def slider(key, lo, hi, unit="px"):
            self.section(lay, auxo_look.LABELS[key], auxo_look.REACH[key])
            row = QHBoxLayout()
            s = QSlider(Qt.Orientation.Horizontal)
            s.setRange(lo, hi)
            s.setValue(int(self.look[key]))
            val = QLabel(f"{self.look[key]} {unit}")
            val.setMinimumWidth(56)
            self.slider_labels.append((val, key))
            s.valueChanged.connect(lambda v: (val.setText(f"{v} {unit}"), self.set_look(key, v)))
            row.addWidget(s, 1)
            row.addWidget(val)
            lay.addLayout(row)
            return s

        self.s_gaps = slider("gaps", 0, 40)
        self.s_round = slider("rounding", 0, 30)
        self.s_border = slider("border", 0, 8)
        for key, text in (("blur", "Blur behind see-through windows and bars"),
                          ("transparency", "See-through bars and terminals, slightly faded unfocused windows")):
            self.section(lay, auxo_look.LABELS[key], auxo_look.REACH[key])
            c = QCheckBox(text)
            self.chk[key] = c
            c.setChecked(self.look[key] == "on")
            c.toggled.connect(lambda v, k=key: self.set_look(k, "on" if v else "off", now=True))
            lay.addWidget(c)
        self.section(lay, "Bar position", auxo_look.REACH["bar"])
        row = QHBoxLayout()
        grp = QButtonGroup(self)
        self.bar_btns = {}
        for pos in ("top", "bottom"):
            b = QPushButton(pos.title())
            self.bar_btns[pos] = b
            b.setCheckable(True)
            b.setChecked(self.look["bar"] == pos)
            b.setMinimumWidth(110)
            b.clicked.connect(lambda _=False, pos=pos: self.set_look("bar", pos, now=True))
            grp.addButton(b)
            row.addWidget(b)
        row.addStretch(1)
        lay.addLayout(row)
        reset = QPushButton("Back to the Auxo defaults")
        reset.clicked.connect(self.reset_look)
        r2 = QHBoxLayout()
        r2.addStretch(1)
        r2.addWidget(reset)
        lay.addLayout(r2)
        lay.addStretch(1)
        return w

    def reset_look(self):
        def after(code):
            if code == 0:
                self.reload_look()
        self.run(["look", "reset", "gaps", "rounding", "border", "blur", "transparency", "animations", "bar"],
                 label="Look back to the Auxo defaults", done=after)

    def page_desktop(self):
        w, lay = self.page()
        self.heading(lay, "Desktop", "Every desktop comes riced by Auxo in your accent. Switching installs it "
                                     "(internet needed) and you pick it at the next login — nothing is reinstalled.")
        self.desk_grid = QGridLayout()
        self.desk_grid.setSpacing(14)
        lay.addLayout(self.desk_grid)
        self.refresh_desktops()
        lay.addStretch(1)
        return w

    def refresh_desktops(self):
        if not hasattr(self, "desk_grid"):
            return
        while self.desk_grid.count():
            it = self.desk_grid.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        current = conf().get("DESKTOP", "")
        keys = [k for k in DESKTOPS if k != "none"]
        for i, k in enumerate(keys):
            c = self.card()
            c.setProperty("current", "true" if k == current else "false")
            v = QVBoxLayout(c)
            v.setContentsMargins(14, 14, 14, 14)
            img = QLabel()
            img.setPixmap(paint_desktop(k))
            v.addWidget(img)
            name = DESKTOPS[k]["name"].replace(" (Auxo rice)", "")
            t = QLabel(f"<b>{name}</b>" + ("  <span style='color:%s'>· current</span>" % accent_hex()[0] if k == current else ""))
            v.addWidget(t)
            d = QLabel(DESKTOP_INFO.get(k, ""))
            d.setObjectName("sub")
            d.setWordWrap(True)
            v.addWidget(d)
            row = QHBoxLayout()
            if k == "hyprland" and k == current:
                styles = QHBoxLayout()
                styles.addWidget(QLabel("Style:"))
                cur_style = conf().get("RICE_HYPRLAND", "hyprland")
                grp = QButtonGroup(c)
                tips = {"hyprland": "Floating bar, the classic Auxo look",
                        "hyprland-mac": "Liquid Glass: menu bar, dock, Launchpad, Control Center, Spotlight search",
                        "hyprland-win": "Taskbar with Start in the middle, Quick settings, Windows keys"}
                for rice_name, text in (("hyprland", "Auxo"), ("hyprland-mac", "Mac"), ("hyprland-win", "Windows")):
                    sb = QPushButton(text)
                    sb.setCheckable(True)
                    sb.setChecked(rice_name == cur_style)
                    sb.setToolTip(tips[rice_name])
                    sb.clicked.connect(lambda _=False, r=rice_name, t=text: self.run(
                        ["rice", r], root=True, label=f"Hyprland style → {t}",
                        done=lambda code: (self.reload_look(), self.refresh_desktops())))
                    grp.addButton(sb)
                    styles.addWidget(sb)
                styles.addStretch(1)
                v.addLayout(styles)
            if k == current:
                b = QPushButton("Re-apply the Auxo rice")
                rice = "kde" if k == "plasma" else (conf().get("RICE_HYPRLAND", k) if k == "hyprland" else k)
                b.clicked.connect(lambda _=False, r=rice: self.run(["rice", r], root=True, label=f"Auxo {r} rice"))
            else:
                b = QPushButton("Switch to " + name.split(" (")[0])
                b.setObjectName("primary")
                b.clicked.connect(lambda _=False, k=k: self.switch_desktop(k))
            row.addWidget(b)
            row.addStretch(1)
            v.addLayout(row)
            self.desk_grid.addWidget(c, i // 3, i % 3)

    # ── Displays ──
    def page_displays(self):
        w, lay = self.page()
        self.heading(lay, "Displays", "Resolution, refresh rate, scaling, rotation and where each screen sits. "
                                      "Drag a screen to move it. For the Hyprland, Sway and i3 rices; no password needed.")
        self.disp_note = QLabel()
        self.disp_note.setObjectName("reach")
        self.disp_note.setWordWrap(True)
        lay.addWidget(self.disp_note)
        self.canvas = MonitorCanvas()
        self.canvas.on_select = self._disp_select
        self.canvas.on_moved = lambda: self._disp_dirty(True)
        lay.addWidget(self.canvas)
        self.section(lay, "Screen", keys="monitor screen display resolution refresh rate hz scale hidpi rotate vrr freesync gsync")
        self.disp_name = QLabel("—")
        lay.addWidget(self.disp_name)
        g = QGridLayout()
        g.setHorizontalSpacing(14)
        self.disp_mode = QComboBox()
        self.disp_scale = QComboBox()
        for v in ("auto", "1", "1.25", "1.5", "1.75", "2"):
            self.disp_scale.addItem("Automatic" if v == "auto" else f"{float(v) * 100:.0f}%", v)
        self.disp_rot = QComboBox()
        for v in ("0", "90", "180", "270"):
            self.disp_rot.addItem("Normal" if v == "0" else f"Rotated {v}°", v)
        self.disp_vrr = QCheckBox("Variable refresh rate (FreeSync / G-Sync)")
        self.disp_on = QCheckBox("Use this screen")
        self.disp_ws = QLineEdit(placeholderText="e.g. 1-5")
        for r, (label, wdg) in enumerate((("Resolution", self.disp_mode), ("Scale", self.disp_scale),
                                          ("Rotation", self.disp_rot), ("Workspaces here", self.disp_ws))):
            g.addWidget(QLabel(label), r, 0)
            g.addWidget(wdg, r, 1)
        g.addWidget(self.disp_vrr, 4, 1)
        g.addWidget(self.disp_on, 5, 1)
        g.setColumnStretch(2, 1)
        lay.addLayout(g)
        for wdg, sig in ((self.disp_mode, "currentIndexChanged"), (self.disp_scale, "currentIndexChanged"),
                         (self.disp_rot, "currentIndexChanged"), (self.disp_vrr, "toggled"), (self.disp_on, "toggled"),
                         (self.disp_ws, "textEdited")):
            getattr(wdg, sig).connect(lambda *_: self._disp_store())
        row = QHBoxLayout()
        self.disp_apply = QPushButton("Apply")
        self.disp_apply.setObjectName("primary")
        self.disp_apply.clicked.connect(self.apply_displays)
        again = QPushButton("Detect screens")
        again.clicked.connect(self.load_displays)
        reset = QPushButton("Back to automatic")
        reset.clicked.connect(lambda: self.run(["monitors", "reset"], label="Displays back to automatic",
                                               done=lambda c: self.load_displays()))
        row.addWidget(self.disp_apply)
        row.addWidget(again)
        row.addWidget(reset)
        row.addStretch(1)
        lay.addLayout(row)
        self.disp = {}
        self._disp_loading = False
        lay.addStretch(1)
        QTimer.singleShot(0, self.load_displays)
        return w

    def load_displays(self):
        p = QProcess(self)
        p.finished.connect(lambda *_: self._disp_loaded(bytes(p.readAllStandardOutput()).decode(errors="replace")))
        p.start(TWEAK, ["monitors", "--json"])
        self._disp_proc = p

    def _disp_loaded(self, out):
        try:
            data = json.loads(out or "{}")
        except ValueError:
            data = {}
        saved = data.get("saved", {})
        self.disp = {}
        for m in data.get("detected", []):
            s = saved.get(m["name"], {})
            scale = float(s.get("scale")) if s.get("scale", "auto") != "auto" else float(m.get("scale") or 1)
            rot = s.get("rotate", m.get("rotate", "0"))
            w, h = m["width"] or 1920, m["height"] or 1080
            if rot in ("90", "270"):
                w, h = h, w
            pos = s.get("position", "auto")
            x, y = (int(v) for v in pos.split("x")) if pos != "auto" else (m["x"], m["y"])
            cur = f"{m['width']}x{m['height']}" + (f"@{m['refresh']}" if m["refresh"] else "")
            self.disp[m["name"]] = {
                "name": m["name"], "desc": m.get("desc", ""), "modes": m.get("modes") or [cur],
                "mode": s.get("mode", "highrr"), "current": cur, "scale": s.get("scale", "auto"), "rotate": rot,
                "vrr": s.get("vrr", "on" if m.get("vrr") else "off") == "on",
                "enabled": s.get("enabled", "on" if m.get("enabled", True) else "off") == "on",
                "workspaces": s.get("workspaces", ""), "x": x, "y": y, "w": int(w / scale), "h": int(h / scale),
                "label": cur}
        # screens the kernel reports all sit at 0,0: put them side by side
        placed = []
        for m in self.disp.values():
            if any(m["x"] < q["x"] + q["w"] and m["x"] + m["w"] > q["x"] and m["y"] < q["y"] + q["h"]
                   and m["y"] + m["h"] > q["y"] for q in placed):
                m["x"], m["y"] = max(q["x"] + q["w"] for q in placed), 0
            placed.append(m)
        desk = data.get("desktop", "")
        own = {"plasma": ("KDE Plasma", "kcmshell6 kcm_kscreen"), "gnome": ("GNOME", "gnome-control-center display"),
               "xfce": ("Xfce", "xfce4-display-settings"), "cinnamon": ("Cinnamon", "cinnamon-settings display"),
               "chrono": ("Chrono", "chrono-settings")}
        if desk in own:
            self.disp_note.setText(f"You're on {own[desk][0]}, which has its own display settings "
                                   f"(<code>{own[desk][1]}</code>). These here are used when you log in to Hyprland, "
                                   "Sway or i3.")
        elif data.get("source") == "kernel":
            self.disp_note.setText("Couldn't ask a running desktop, so refresh rates aren't known yet: log in to "
                                   "Hyprland, Sway or i3 and press Detect screens for the full list.")
        else:
            self.disp_note.setText("")
        sel = self.canvas.sel
        self.canvas.set_monitors(list(self.disp.values()), sel)
        self._disp_select(self.canvas.sel)
        self._disp_dirty(False)
        if not self.disp:
            self.disp_name.setText("No screens found")

    def _disp_select(self, name):
        m = self.disp.get(name)
        if not m:
            return
        self._disp_loading = True
        self.disp_name.setText(f"<b>{m['name']}</b>  <span style='color:#8b8ba0'>{html.escape(m['desc'])}"
                               f"  · now {m['current']}</span>")
        self.disp_mode.clear()
        self.disp_mode.addItem("Best (highest refresh rate)", "highrr")
        self.disp_mode.addItem("Monitor's preferred", "preferred")
        for md in m["modes"]:
            wd, rest = md.split("x", 1)
            hgt, _, hz = rest.partition("@")
            self.disp_mode.addItem(f"{wd} × {hgt}" + (f"  ·  {hz} Hz" if hz else ""), md)
        idx = self.disp_mode.findData(m["mode"])
        if idx < 0:
            self.disp_mode.addItem(m["mode"], m["mode"])
            idx = self.disp_mode.count() - 1
        self.disp_mode.setCurrentIndex(idx)
        self.disp_scale.setCurrentIndex(max(0, self.disp_scale.findData(m["scale"])))
        self.disp_rot.setCurrentIndex(max(0, self.disp_rot.findData(m["rotate"])))
        self.disp_vrr.setChecked(m["vrr"])
        self.disp_on.setChecked(m["enabled"])
        self.disp_ws.setText(m["workspaces"])
        self._disp_loading = False

    def _disp_store(self):
        if self._disp_loading or self.canvas.sel not in self.disp:
            return
        m = self.disp[self.canvas.sel]
        old_rot, old_scale = m["rotate"], m["scale"]
        m.update(mode=self.disp_mode.currentData(), scale=self.disp_scale.currentData(),
                 rotate=self.disp_rot.currentData(), vrr=self.disp_vrr.isChecked(), enabled=self.disp_on.isChecked(),
                 workspaces=self.disp_ws.text().strip())
        if m["rotate"] != old_rot and (int(m["rotate"]) - int(old_rot)) % 180:
            m["w"], m["h"] = m["h"], m["w"]
        if m["scale"] != old_scale:
            f = (float(old_scale) if old_scale != "auto" else 1) / (float(m["scale"]) if m["scale"] != "auto" else 1)
            m["w"], m["h"] = int(m["w"] * f), int(m["h"] * f)
        snap(m, [o for o in self.disp.values() if o is not m and o["enabled"]]) if len(self.disp) > 1 else None
        self.canvas.update()
        self._disp_dirty(True)

    def _disp_dirty(self, dirty):
        self.disp_apply.setEnabled(dirty)
        self.disp_apply.setText("Apply" if dirty else "Applied")

    def apply_displays(self):
        if self.disp and not any(m["enabled"] for m in self.disp.values()):
            QMessageBox.warning(self, "Displays", "At least one screen has to stay on.")
            return
        on = [m for m in self.disp.values() if m["enabled"]]
        x0 = min((m["x"] for m in on), default=0)
        y0 = min((m["y"] for m in on), default=0)
        queue = []
        for m in self.disp.values():
            queue.append(["monitors", "set", m["name"], f"mode={m['mode']}", f"scale={m['scale']}",
                          f"position={m['x'] - x0}x{m['y'] - y0}", f"rotate={m['rotate']}",
                          f"vrr={'on' if m['vrr'] else 'off'}", f"enabled={'on' if m['enabled'] else 'off'}",
                          f"workspaces={m['workspaces']}", "--no-apply"])
        queue[-1] = queue[-1][:-1]                 # the last one reloads the desktop

        def step(code=0):
            if code != 0:
                return
            if queue:
                self.run(queue.pop(0), label="Displays applied" if not queue else "Saving displays…", done=step)
            else:
                self._disp_dirty(False)
        step()

    def switch_desktop(self, k):
        name = DESKTOPS[k]["name"]
        extra = "\n\nChrono is built from source, which takes a few minutes." if k == "chrono" else ""
        if QMessageBox.question(self, "Switch desktop", f"Install {name} and make it your desktop?\n\n"
                                f"It needs an internet connection. You'll use it after logging out.{extra}") \
                != QMessageBox.StandardButton.Yes:
            return
        self.run(["desktop", k], root=True, label=f"Desktop → {name}", done=lambda c: self.refresh_desktops())

