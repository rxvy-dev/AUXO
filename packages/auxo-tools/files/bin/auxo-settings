    def gpu_status(self):
        try:
            r = subprocess.run([TWEAK, "nvidia", "status", "--json"], capture_output=True, text=True, timeout=8)
            return json.loads(r.stdout.strip().splitlines()[-1])
        except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
            return None

    def graphics_section(self, lay):
        self.section(lay, "Graphics card", keys="gpu nvidia amd intel driver graphics card nouveau prime")
        st = self.gpu_status()
        box = QVBoxLayout()
        self.gpu_label = QLabel()
        self.gpu_label.setWordWrap(True)
        self.gpu_label.setTextFormat(Qt.TextFormat.RichText)
        box.addWidget(self.gpu_label)
        row = QHBoxLayout()
        self.gpu_buttons = []
        if not st:
            self.gpu_label.setText("Couldn't read your graphics card (lspci). <i>auxo-tweak nvidia status</i> in a "
                                   "terminal shows it.")
        else:
            cards = "<br>".join(f"<b>{g}</b>" for g in st.get("gpus", [])) or "<b>No graphics card found</b>"
            if not st.get("nvidia"):
                note = "Its driver is open source and comes with Linux: nothing to install."
            elif st.get("fits") == "nouveau":
                note = "This NVIDIA card is too old for NVIDIA's driver; the open-source nouveau driver is used."
            elif st.get("installed"):
                note = (f"✓ NVIDIA's driver is set up (<b>{', '.join(st['installed'])}</b>), with Wayland support. "
                        "Games and Hyprland use it.")
            else:
                pkg = st.get("fits")
                note = (f"Using the open-source nouveau driver: slow, and no gaming. NVIDIA's driver for this card is "
                        f"<b>{pkg}</b>{' (open kernel modules)' if pkg == 'nvidia' else ''}. One click sets it up, "
                        "with Wayland, Steam's 32-bit libraries and every installed kernel. Restart afterwards.")
            self.gpu_label.setText(f"{cards}<br><span style='opacity:.75'>{note}</span>")
            if st.get("nvidia") and st.get("fits") not in (None, "nouveau"):
                if st.get("installed"):
                    b = QPushButton("Switch back to nouveau")
                    b.clicked.connect(lambda: self.run(["nvidia", "off"], root=True, label="Back to nouveau"))
                else:
                    b = QPushButton("Set up the NVIDIA driver")
                    b.setObjectName("primary")
                    b.clicked.connect(lambda: self.run(["nvidia", "on"], root=True, label="Setting up the NVIDIA driver"))
                row.addWidget(b)
                self.gpu_buttons.append(b)
            if st.get("hybrid") and not st.get("prime"):
                b = QPushButton("Laptop with two GPUs: add prime-run")
                b.setToolTip("Run a game on the NVIDIA GPU with: prime-run <program> (Steam: prime-run %command%)")
                b.clicked.connect(lambda: self.run(["nvidia", "prime"], root=True, label="Adding prime-run"))
                row.addWidget(b)
                self.gpu_buttons.append(b)
        row.addStretch(1)
        box.addLayout(row)
        lay.addLayout(box)

    def rollback(self):
        n, ok = QInputDialog.getInt(self, "Roll back", "Snapshot number to go back to\n(click “Show snapshots” to see them):",
                                    1, 1, 999999)
        if not ok:
            return
        if QMessageBox.question(self, "Roll back", f"Replace your system with snapshot {n}?\n\nYour files in /home are kept, "
                                "and the current system is saved so you can come back. Restart afterwards.") \
                != QMessageBox.StandardButton.Yes:
            return
        self.logbtn.setChecked(True)
        self.run_prog("auxo-rollback", ["--yes", str(n)], root=True, label=f"Rolled back to {n} — restart to use it")

    # ── Health ──
    def page_health(self):
        w, lay = self.page()
        self.heading(lay, "Health", "Auxo checks the things that most often break a Linux install, and fixes them "
                                    "for you. If you can't log in, can't get online or ran out of space, start here.")
        self.section(lay, "Checks", keys="doctor fix login password broken problem repair")
        self.health_box = QVBoxLayout()
        lay.addLayout(self.health_box)
        row = QHBoxLayout()
        again = QPushButton("Check again")
        again.clicked.connect(self.check_health)
        self.fix_btn = QPushButton("Fix everything")
        self.fix_btn.setObjectName("primary")
        self.fix_btn.clicked.connect(lambda: self.run(["doctor", "--fix"], root=True, label="Repaired",
                                                      done=lambda c: self.check_health()))
        row.addWidget(self.fix_btn)
        row.addWidget(again)
        row.addStretch(1)
        lay.addLayout(row)
        lay.addStretch(1)
        QTimer.singleShot(0, self.check_health)
        return w

    def check_health(self):
        p = QProcess(self)
        p.finished.connect(lambda *_: self._show_health(bytes(p.readAllStandardOutput()).decode(errors="replace")))
        p.start(TWEAK, ["doctor", "--json"])
        self._health_proc = p

    def _show_health(self, out):
        while self.health_box.count():
            it = self.health_box.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        try:
            checks = json.loads(out or "[]")
        except ValueError:
            checks = []
        bad = [c for c in checks if c.get("problem")]
        for c in checks:
            row = QLabel()
            row.setWordWrap(True)
            row.setTextFormat(Qt.TextFormat.RichText)
            if c.get("problem"):
                row.setText(f"<span style='color:#fb7185'>✗</span>&nbsp; <b>{html.escape(c['title'])}</b><br>"
                            f"<span style='color:#8b8ba0'>{html.escape(c['problem'])} — "
                            f"{'fix: ' if c.get('fixable') else ''}{html.escape(c.get('hint', ''))}</span>")
            else:
                row.setText(f"<span style='color:#34d399'>✓</span>&nbsp; {html.escape(c['title'])}")
            self.health_box.addWidget(row)
        self.fix_btn.setEnabled(any(c.get("fixable") for c in bad))
        if not checks:
            self.health_box.addWidget(QLabel("Couldn't run the checks (is auxo-tweak installed?)"))
        idx = [n for n, *_ in PAGES].index("Health")
        it = self.nav.item(idx) if self.nav.count() > idx else None
        if it:
            it.setText(f"  Health  ·  {len(bad)} to fix" if bad else "  Health")

    # ── Ask Auxo (local AI) ──
    def page_ai(self):
        w, lay = self.page()
        self.heading(lay, "Ask Auxo", "Auxo AI runs on your own PC: free, private, and it works offline once it's set up. "
                                      "It knows Auxo and your settings, and can run the fixes it suggests (you confirm first).")
        self.section(lay, "Auxo AI", keys="ai assistant help chat question local llm ollama")
        self.ai_setup = self.card()
        v = QVBoxLayout(self.ai_setup)
        v.setContentsMargins(18, 16, 18, 16)
        v.addWidget(QLabel("<b>Turn on Auxo AI</b> — one download (Ollama and a model), then it's yours."))
        self.ai_model = QComboBox()
        for key, (model, desc) in (("small", ("llama3.2:1b", "Small — about 1.3 GB, any PC with 8 GB of RAM")),
                                   ("standard", ("llama3.2:3b", "Standard — about 2 GB, 8 GB of RAM or more")),
                                   ("large", ("qwen3:8b", "Large — about 5 GB, 16 GB of RAM or a recent GPU"))):
            self.ai_model.addItem(desc, key)
        self.ai_model.setCurrentIndex(1)
        r = QHBoxLayout()
        r.addWidget(self.ai_model, 1)
        on = QPushButton("Turn on")
        on.setObjectName("primary")
        on.clicked.connect(lambda: (self.logbtn.setChecked(True),
                                    self.run(["ai", "on", "--model", self.ai_model.currentData()], root=True,
                                             label="Auxo AI is ready", done=lambda c: self._ai_state())))
        r.addWidget(on)
        v.addLayout(r)
        lay.addWidget(self.ai_setup)
        self.chat_view = QTextBrowser()
        self.chat_view.setObjectName("chat")
        self.chat_view.setOpenLinks(False)
        self.chat_view.anchorClicked.connect(lambda url: self.run_suggested(url.toString()))
        self.chat_view.setMinimumHeight(340)
        lay.addWidget(self.chat_view, 1)
        r = QHBoxLayout()
        self.ask = QLineEdit(placeholderText="Ask anything — “why is my wifi slow?”, “make my desktop look minimal”…")
        self.ask.setObjectName("ask")
        self.ask.returnPressed.connect(self.send_question)
        send = QPushButton("Ask")
        send.setObjectName("primary")
        send.clicked.connect(self.send_question)
        clear = QPushButton("New chat")
        clear.clicked.connect(lambda: (self.chat.clear(), self.render_chat()))
        r.addWidget(self.ask, 1)
        r.addWidget(send)
        r.addWidget(clear)
        lay.addLayout(r)
        self._ai_state()
        return w

    def _ai_state(self):
        on = conf().get("AI") == "on"
        self.ai_setup.setVisible(not on)
        self.ask.setEnabled(on)
        if not self.chat:
            self.render_chat()

    def render_chat(self, streaming=""):
        a = accent_hex()[0]
        parts = []
        if not self.chat and not streaming:
            tips = ["How do I install Steam?", "My laptop battery drains fast", "Make my desktop look minimal",
                    "What does auxo-tweak doctor do?"]
            parts.append("<p style='color:#8b8ba0'>Try: " + " · ".join(html.escape(t) for t in tips) + "</p>")
        msgs = self.chat + ([{"role": "assistant", "content": streaming}] if streaming else [])
        for m in msgs:
            text = html.escape(m["content"])
            if m["role"] == "user":
                parts.append(f"<p><b style='color:{a}'>You</b><br>{text}</p>")
            else:
                text = re.sub(r"```[a-z]*\n?(.*?)```", lambda x: f"<pre>{x.group(1)}</pre>", text, flags=re.S)
                text = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", text).replace("\n", "<br>")
                links = ""
                if m is not msgs[-1] or not streaming:
                    for cmd in self.suggested(m["content"]):
                        links += f"<br><a href='{html.escape(cmd, quote=True)}' style='color:{a}'>▶ Run: {html.escape(cmd)}</a>"
                parts.append(f"<p><b>Auxo AI</b><br>{text}{links}</p>")
        self.chat_view.setHtml("".join(parts))
        self.chat_view.verticalScrollBar().setValue(self.chat_view.verticalScrollBar().maximum())

    @staticmethod
    def suggested(text):
        found = []
        for m in re.finditer(r"(?m)^\s*(?:\$\s*)?(?:sudo\s+)?(auxo-tweak\s+[a-z][^\n`#]*)", text):
            cmd = m.group(1).strip()
            if cmd not in found:
                found.append(cmd)
        return found[:4]

    def run_suggested(self, cmd):
        try:
            argv = shlex.split(cmd)[1:]
        except ValueError:
            return
        if not argv:
            return
        root = argv[0] not in USER_CMDS
        if QMessageBox.question(self, "Run this?", f"Auxo AI suggested:\n\n  {cmd}\n\n"
                                f"{'This changes the system and asks for your password.' if root else 'This changes only your own settings.'}"
                                "\nRun it?") != QMessageBox.StandardButton.Yes:
            return
        self.logbtn.setChecked(True)
        self.run(argv, root=root, label=cmd, done=lambda c: self.reload_look() if argv[0] in USER_CMDS else None)

    def send_question(self):
        q = self.ask.text().strip()
        if not q or (self.ai_proc and self.ai_proc.state() != QProcess.ProcessState.NotRunning):
            return
        self.ask.clear()
        self.chat.append({"role": "user", "content": q})
        self._answer = ""
        self.render_chat("…")
        p = self.ai_proc = QProcess(self)
        p.readyReadStandardOutput.connect(self._ai_read)
        p.finished.connect(self._ai_done)
        p.start(AI, ["--plain", "--json"])
        p.write(json.dumps(self.chat).encode())
        p.closeWriteChannel()
        self.status.setText("⏳ Auxo AI is thinking…")

    def _ai_read(self):
        self._answer += bytes(self.ai_proc.readAllStandardOutput()).decode(errors="replace")
        self.render_chat(self._answer or "…")

    def _ai_done(self, code, _st):
        err = bytes(self.ai_proc.readAllStandardError()).decode(errors="replace").strip()
        self.chat.append({"role": "assistant", "content": self._answer.strip() or err or "(no answer)"})
        self.status.setText("✓ Auxo AI answered" if code == 0 else "Auxo AI couldn't answer — see the chat")
        self.render_chat()

    def toggle(self, box, cmd, title, value):
        def undo(code):
            if code != 0:           # cancelled or failed: put the switch back the way it was
                box.blockSignals(True)
                box.setChecked(not value)
                box.blockSignals(False)
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            undo(1)
            return
        self.run([*cmd, "on" if value else "off"], root=True, label=f"{title} {'on' if value else 'off'}", done=undo)

    def install_apps(self):
        picked = [b.property("bundle") for b in self.app_boxes if b.isChecked()]
        if not picked:
            self.status.setText("Tick the app bundles you want first")
            return
        self.run(["apps", *picked], root=True, label="Apps: " + ", ".join(picked),
                 done=lambda c: [b.setChecked(False) for b in self.app_boxes] if c == 0 else None)

    def run_update(self):
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            return
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.finished.connect(lambda code, _s: self._finished(code, "Update", None))
        self.status.setText("⏳ Updating everything (asks for your password)")
        self.logbtn.setChecked(True)
        self.proc.start(PKEXEC, ["auxo-update", "-y"])


PAGES = [("Look", "preferences-desktop-theme", "page_look"),
         ("Windows & bar", "preferences-system-windows", "page_windows"),
         ("Desktop", "preferences-desktop", "page_desktop"),
         ("Displays", "video-display", "page_displays"),
         ("System", "preferences-system", "page_system"),
         ("Health", "help-faq", "page_health"),
         ("Ask Auxo", "dialog-information", "page_ai")]


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Auxo Settings")
    app.setDesktopFileName("auxo-settings")
    win = Settings()
    page = {"look": 0, "windows": 1, "desktop": 2, "displays": 3, "system": 4, "health": 5, "ai": 6}.get(
        (sys.argv[1:2] or [""])[0].lstrip("-"), 0)
    win.nav.setCurrentRow(page)
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
