            QToolButton {{ background: transparent; color: {mut}; border: none; }}
            QScrollArea {{ border: none; }}
        """)

    # ── helpers ──
    def heading(self, lay, title, sub=None):
        t = QLabel(title)
        t.setObjectName("h1")
        lay.addWidget(t)
        if sub:
            s = QLabel(sub)
            s.setObjectName("sub")
            s.setWordWrap(True)
            lay.addWidget(s)

    def section(self, lay, title, reach=None, keys=""):
        t = QLabel(title)
        t.setObjectName("h2")
        lay.addWidget(t)
        self._sections.append((self._building, t, title, f"{title} {reach or ''} {keys}".lower()))
        if reach:
            r = QLabel(f"Applies to: {reach}")
            r.setObjectName("reach")
            lay.addWidget(r)

    def jump(self, text):
        """Search: go to the page and section that best matches, and flash it."""
        q = text.strip().lower()
        if not q:
            return
        hit = (next((x for x in self._sections if x[2].lower() == q), None)
               or next((x for x in self._sections if x[2].lower().startswith(q)), None)
               or next((x for x in self._sections if q in x[3]), None)
               or next((x for x in self._sections if all(w in x[3] for w in q.split())), None))
        if not hit:
            self.status.setText(f"Nothing called “{text}” — try words like gaps, wallpaper, kernel, bluetooth")
            return
        page, label = hit[0], hit[1]
        self.nav.setCurrentRow(page)
        self.pages.widget(page).ensureWidgetVisible(label, 0, 120)
        label.setObjectName("flash")
        label.setStyleSheet("font-size: 12.5pt; font-weight: 700; margin-top: 10px;")
        QTimer.singleShot(1600, lambda: (label.setObjectName("h2"), label.setStyleSheet("")))

    def card(self):
        f = QFrame()
        f.setObjectName("card")
        return f

    def page(self):
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(36, 28, 36, 28)
        lay.setSpacing(10)
        return w, lay

    # ── running auxo-tweak ──
    def busy(self):
        return self.proc and self.proc.state() != QProcess.ProcessState.NotRunning

    def run(self, args, root=False, label=None, done=None):
        self.run_prog(TWEAK, args, root, label, done, shown="auxo-tweak")

    def run_prog(self, prog, args, root=False, label=None, done=None, shown=None):
        if self.busy():
            QMessageBox.information(self, "Auxo Settings", "Something is still running. Wait for it to finish first.")
            return False
        exe, argv = (PKEXEC, [prog, *args]) if root else (prog, list(args))
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.finished.connect(lambda code, _st: self._finished(code, label, done))
        self.status.setText(("⏳ " + (label or " ".join(args))) + ("  (asks for your password)" if root else ""))
        self.log.appendPlainText(f"$ {'pkexec ' if root else ''}{shown or os.path.basename(prog)} {' '.join(args)}")
        self.proc.start(exe, argv)
        return True

    def _read(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        import re
        text = re.sub(r"\x1b\[[0-9;]*m", "", text)
        self.log.insertPlainText(text)
        self.log.ensureCursorVisible()
        last = [l for l in text.splitlines() if l.strip()]
        if last:
            self.status.setText("⏳ " + last[-1].lstrip(": ")[:140])

    def _finished(self, code, label, done):
        if code == 0:
            self.status.setText(f"✓ {label or 'Done'}")
        elif code in (126, 127):
            self.status.setText("Cancelled (no password given)")
        else:
            self.status.setText(f"✗ {label or 'That'} didn't work — click Show log for details")
            self.logbtn.setChecked(True)
        if done:
            done(code)

    # look settings are batched: dragging a slider sends one change when you stop
    def set_look(self, key, value, now=False):
        self.look[key] = str(value)
        self.pending[key] = str(value)
        self.preview.set_look(self.look)
        if key == "mode":
            self.restyle()
        if now:
            self._flush_look()
        else:
            self.apply_timer.start()

    def _flush_look(self):
        if not self.pending:
            return
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            self.apply_timer.start()
            return
        items = [f"{k}={v}" for k, v in self.pending.items()]
        self.pending = {}
        self.run(["look", "set", *items], label="Look: " + ", ".join(items))

