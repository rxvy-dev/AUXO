#!/usr/bin/env bash
# auxo-update — safe, one-command system update.
#   1. takes a btrfs snapshot (if snapshots are on)
#   2. updates xbps itself, then every package
#   3. updates Flatpak apps
#   4. reports new config files, orphans, and whether a reboot is needed
set -uo pipefail

ACC=$(sed -n 's/^ACCENT="\{0,1\}\([a-z]*\)"\{0,1\}/\1/p' /etc/auxo/auxo.conf 2>/dev/null)
case "${ACC:-violet}" in
  cyan) C='\e[38;2;34;211;238m' ;; emerald) C='\e[38;2;52;211;153m' ;; amber) C='\e[38;2;251;191;36m' ;;
  rose) C='\e[38;2;251;113;133m' ;; blue) C='\e[38;2;96;165;250m' ;; mono) C='\e[38;2;229;231;235m' ;;
  *) C='\e[38;2;167;139;250m' ;;
esac
R='\e[0m'; B='\e[1m'; Y='\e[33m'
step() { printf "\n${C}${B}▲ %s${R}\n" "$*"; }
note() { printf "  ${Y}!${R} %s\n" "$*"; }

YES=0
for a in "$@"; do
  case "$a" in
    -y|--yes) YES=1 ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; echo; echo "usage: auxo-update [-y]"; exit 0 ;;
  esac
done

SUDO=""; [[ $EUID -ne 0 ]] && SUDO="sudo"
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/auxo/last-update"

if [[ -f /etc/snapper/configs/root ]] && command -v snapper >/dev/null; then
  step "Snapshot before update"
  $SUDO snapper -c root create -t single -c number -d "auxo-update $(date +%F\ %R)" && echo "  snapshot created — roll back any time with auxo-rollback"
fi

yes=(); (( YES )) && yes=(-y)
step "Package manager"
# xbps refuses to update anything else while xbps itself is out of date
$SUDO xbps-install -Su "${yes[@]}" xbps || { note "updating xbps failed (offline?)"; exit 1; }

step "Packages"
$SUDO xbps-install -Su "${yes[@]}" || { note "xbps-install failed"; exit 1; }

# keep Auxo's name in os-release if base-files was updated
command -v auxo-branding >/dev/null && $SUDO auxo-branding >/dev/null 2>&1

if command -v flatpak >/dev/null; then step "Flatpak"; flatpak update -y --noninteractive; fi

step "Health check"
newconf=$(find /etc -name '*.new-*' 2>/dev/null | wc -l)
(( newconf )) && note "$newconf new config file(s) in /etc (*.new-<version>) — compare them with your versions"
orphans=$(xbps-query -O 2>/dev/null | wc -l)
(( orphans )) && note "$orphans orphaned package(s) — remove with: sudo xbps-remove -o  (or auxo-tweak cleanup)"
newest=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -V | tail -n1)
if [[ -n $newest && $newest != "$(uname -r)" ]]; then
  note "a newer kernel is installed ($newest) — reboot when convenient"
fi
(( newconf + orphans == 0 )) && echo "  all good"

mkdir -p "$(dirname "$STAMP")" && date +%s > "$STAMP"
printf "\n${C}${B}✓ Auxo is up to date${R}\n"
