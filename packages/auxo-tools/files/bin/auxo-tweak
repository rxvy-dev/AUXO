#!/usr/bin/env python3
"""auxo-tweak — change your Auxo system after install, no reinstall needed.

Run with no arguments for the interactive menu, or use a sub-command:

  auxo-tweak accent [NAME]            system + user accent colour (GRUB, login screen, MOTD, terminals, bars)
  auxo-tweak desktop NAME             hyprland | sway | gnome | xfce | cinnamon | i3 | chrono | none
  auxo-tweak rice NAME                re-apply the Auxo rice: hyprland[-mac|-win|-neon|-zen|-candy] | sway | i3 | gnome | xfce | cinnamon | chrono
  auxo-tweak style NAME               Hyprland style: windows | mac | auxo | neon | zen | candy
  auxo-tweak look [set K=V…|reset]    your look: light/dark, wallpaper, fonts, gaps, corners, borders, blur,
                                      transparency, animations, bar position (also in the Auxo Settings app)
  auxo-tweak mode dark|light          light or dark, on every desktop
  auxo-tweak wallpaper FILE|accent    your own wallpaper, or the Auxo one in your accent
  auxo-tweak apps list|NAME…          app bundles: browsers, media, creative, office, dev, chat, terminal, fun
  auxo-tweak kernel NAME              linux | linux-lts | linux-mainline (becomes the default boot entry)
  auxo-tweak shell NAME               zsh | fish | bash
  auxo-tweak drivers [--prune]        detect the GPU and install the right driver
  auxo-tweak nvidia status|on|off|prime   NVIDIA driver: pick the right branch, back to nouveau, laptop offload
  auxo-tweak scheduler list|status|off|SCHED [--mode M]   sched-ext CPU schedulers (lavd, bpfland, ...)
  auxo-tweak power balanced|performance|power-saver       power profile
  auxo-tweak firewall on|off|status   ufw: block incoming, allow outgoing
  auxo-tweak dns cloudflare|quad9|google|auto             DNS servers for every connection
  auxo-tweak vpn [mullvad [ACCOUNT]|proton|import FILE|on|off]   Mullvad, Proton VPN or any WireGuard/OpenVPN file
  auxo-tweak snapshots on|off|status  btrfs time-travel: snapper + bootable snapshots in GRUB
  auxo-tweak gaming on|off|status     Steam, GameMode, MangoHud, gamescope + low-latency tweaks
  auxo-tweak flatpak on|status        Flatpak + Flathub
  auxo-tweak cleanup                  clear the package cache, orphans and old kernels
  auxo-tweak mirrors [--url URL]      pick a faster Void mirror
  auxo-tweak zram on|off              compressed RAM swap
  auxo-tweak repo nonfree|multilib    enable Void's extra repositories
  auxo-tweak service NAME on|off      bluetooth | cups | sshd | power-profiles
  auxo-tweak info                     show current Auxo settings
  auxo-tweak monitors [set NAME k=v…]  resolution, refresh rate, scale, layout, workspaces (Hyprland, Sway, i3)
  auxo-tweak ai on|off|status         Auxo AI, a free assistant that runs on your PC (--model small|standard|large)
  auxo-tweak doctor [--fix]           find (and repair) common problems, like a login screen that rejects your password
"""
import argparse
import glob
import os
import re
import shutil
import subprocess
import time
import sys

sys.path.insert(0, os.environ.get("AUXO_LIB", "/usr/lib/auxo"))

from auxo_accents import ACCENTS, ansi  # noqa: E402
from auxo_core import (R, DRY, AuxoError, del_kv, get_kv, log, warn, run, have, installed, online,  # noqa: E402
                       require_root, read_conf, write_conf, set_kv, write_file, chown, home_of, normal_users,
                       invoking_user, xbps_install, xbps_remove, repo_enable, regen_initramfs,
                       sv_enable, sv_disable, sv_enabled, audio_setup, audio_missing, SHARE, RESET, BOLD, DIM)
from auxo_desktops import DESKTOPS, KERNELS, SHELLS, GUI_SERVICES, live_packages  # noqa: E402
import auxo_desktops  # noqa: E402
import auxo_theme  # noqa: E402
import auxo_gnome  # noqa: E402
import auxo_look  # noqa: E402


def target_users(args):
    if getattr(args, "user", None):
        return [args.user]
    u = invoking_user()
    return [u] if u else normal_users()


def _rm(path):
    if os.path.lexists(R(path)):
        os.remove(R(path))
        return True
    return False


# ── accent ────────────────────────────────────────────────────────────
def cmd_accent(args):
    if not args.name:
        cur = auxo_theme.current()
        for name, (a, _) in ACCENTS.items():
            mark = "●" if name == cur else "○"
            print(f"  {ansi(a)}{mark} {name:<8} {a}{RESET}")
        return
    require_root()
    auxo_theme.apply_system(args.name, mkconfig=not args.no_grub)
    users = target_users(args)
    for u in users:
        auxo_theme.apply_user(u, args.name)
    # change the wallpaper/colours right now in any desktop the user is logged into.
    # sudo drops the session variables, so they're rebuilt from the user's running session.
    if not args.user:
        for u in users:
            env = auxo_theme.session_env(u)
            if env:
                run(["auxo-tweak", "session-apply", "--accent", args.name], check=False, user=u, env=env)


# ── hardware detection ────────────────────────────────────────────────
def gpu_info():
    """Return list of (vendor, device_id, description)."""
    if DRY and os.environ.get("AUXO_TEST_GPU"):
        # "10de:2684 NVIDIA RTX 4090" — lets the test-suite pretend to have a GPU
        v, rest = os.environ["AUXO_TEST_GPU"].split(":", 1)
        d, desc = (rest.split(" ", 1) + [""])[:2]
        return [(v, d, desc)]
    out = run(["lspci", "-nn"], capture=True, check=False) if have("lspci") and not DRY else ""
    gpus = []
    for line in (out or "").splitlines():
        if any(k in line for k in ("VGA compatible", "3D controller", "Display controller")):
            m = re.search(r"\[([0-9a-f]{4}):([0-9a-f]{4})\]", line)
            if m:
                gpus.append((m.group(1), m.group(2), line.split(": ", 1)[-1]))
    return gpus


def nvidia_branch():
    """Which Void NVIDIA package fits this GPU: 'nvidia' (Turing and newer, open kernel
    modules), 'nvidia580' (Maxwell, Pascal, Volta), 'nvidia470' (Kepler), 'nouveau'
    (older), or None when there's no NVIDIA GPU."""
    for vendor, dev, _ in gpu_info():
        if vendor == "10de":
            d = int(dev, 16)
            if d >= 0x1e00:
                return "nvidia"
            if d >= 0x1340:
                return "nvidia580"
            if d >= 0x0fc0:
                return "nvidia470"
            return "nouveau"
    return None


def detect_virt():
    """'oracle', 'kvm', 'vmware', 'microsoft' or '' (Void has no systemd-detect-virt)."""
    if DRY:
        return os.environ.get("AUXO_TEST_VIRT", "")
    txt = ""
    for f in ("/sys/class/dmi/id/sys_vendor", "/sys/class/dmi/id/product_name"):
        try:
            txt += open(f).read().lower()
        except OSError:
            pass
    for key, name in (("virtualbox", "oracle"), ("innotek", "oracle"), ("qemu", "kvm"),
                      ("kvm", "kvm"), ("vmware", "vmware"), ("microsoft", "microsoft")):
        if key in txt:
            return name
    return ""


# ── kernel ────────────────────────────────────────────────────────────
TEST_SERIES = {"linux": "linux6.18", "linux-lts": "linux6.12", "linux-mainline": "linux6.19"}


def kernel_series(meta):
    """'linux-lts' → 'linux6.12': the versioned package a Void kernel meta package pulls in."""
    if DRY:
        return TEST_SERIES.get(meta)
    out = run(["xbps-query", "-x", meta], capture=True, check=False) or ""
    for word in out.split():
        m = re.match(r"(linux\d+\.\d+)", word)
        if m:
            return m.group(1)
    return None


def kernel_version(series):
    """'linux6.12' → '6.12.111_1' (the name its /boot/vmlinuz-* file uses)."""
    if DRY:
        return series.replace("linux", "") + ".0_1"
    pkgver = (run(["xbps-query", "-p", "pkgver", series], capture=True, check=False) or "").strip()
    return pkgver.split("-", 1)[1] if "-" in pkgver else ""


def installed_kernels():
    return [k for k in KERNELS if installed(k)]


def cmd_kernel(args):
    require_root()
    k = args.name
    log(f"installing {k}")
    xbps_install(k)
    try:  # headers are only needed for DKMS modules (NVIDIA); don't fail the switch over them
        xbps_install(f"{k}-headers")
    except AuxoError as e:
        warn(f"{k}-headers could not be installed ({e}); DKMS modules may not build for {k}")
    series = kernel_series(k)
    ver = kernel_version(series) if series else ""
    vmlinuz = f"/boot/vmlinuz-{ver}"
    if not ver or not (DRY or os.path.exists(R(vmlinuz))):
        del_kv("/etc/default/grub", "GRUB_TOP_LEVEL")
        raise AuxoError(f"couldn't find the kernel image for {k}; GRUB left on the current kernel")
    if not DRY and not args.no_initramfs and not os.path.exists(R(f"/boot/initramfs-{ver}.img")):
        run(["xbps-reconfigure", "-f", series], check=False)  # runs dracut + the GRUB hook
    # the 49-auxo-default-kernel hook keeps this pointing at the newest build after updates
    set_kv("/etc/default/grub", "GRUB_TOP_LEVEL", vmlinuz)
    write_conf({"KERNEL": k})
    if not args.no_grub:
        auxo_theme.grub_mkconfig()
    log(f"{k} ({ver}) is now the default boot entry; other kernels stay under 'Advanced options'.")


# ── shell ─────────────────────────────────────────────────────────────
ZSHRC_TEMPLATE = "/usr/share/auxo/shell/zshrc"
FISHRC = """# ~/.config/fish/config.fish — Auxo defaults
set -g fish_greeting
source /usr/share/auxo/shell/prompt.fish
alias ll 'ls -lah'
alias update auxo-update
"""


def cmd_shell(args):
    require_root()
    path, pkgs = SHELLS[args.name]
    xbps_install(pkgs[0])          # the shell itself is required…
    try:                           # …completions/plugins are nice to have
        xbps_install(*pkgs[1:])
    except AuxoError as e:
        warn(f"optional {args.name} extras not installed: {e}")
    if not os.path.exists(R(path)) and not DRY:
        raise AuxoError(f"{path} is missing; login shell not changed")
    for u in target_users(args):
        run(["chsh", "-s", path, u])
        home = home_of(u)
        if args.name == "zsh":
            rc = R(f"{home}/.zshrc")
            current = open(rc).read() if os.path.exists(rc) else ""
            if args.force or "auxo/shell/prompt.zsh" not in current:
                if current.strip() and not os.path.exists(rc + ".auxo-bak"):
                    shutil.copy2(rc, rc + ".auxo-bak")
                write_file(f"{home}/.zshrc", open(R(ZSHRC_TEMPLATE)).read(), owner=u)
        if args.name == "bash":
            rc = R(f"{home}/.bashrc")
            line = "[[ $- == *i* ]] && source /usr/share/auxo/shell/prompt.bash  # auxo prompt\n"
            if not os.path.exists(rc) or "auxo/shell/prompt.bash" not in open(rc).read():
                os.makedirs(os.path.dirname(rc), exist_ok=True)
                with open(rc, "a") as f:
                    f.write("\n" + line)
                chown(f"{home}/.bashrc", u)
        if args.name == "fish" and not os.path.exists(R(f"{home}/.config/fish/config.fish")):
            write_file(f"{home}/.config/fish/config.fish", FISHRC, owner=u)
        log(f"{u}: login shell → {path}")


# ── desktop / rice ────────────────────────────────────────────────────
# rices with no files to copy: GNOME, Xfce and Cinnamon get theirs through their own settings
# (gsettings / xfconf) at the next login or straight away; Chrono's comes from the look files
SESSION_RICES = {"gnome", "xfce", "cinnamon", "chrono"}


# Rice styles layered on a base rice: the base is applied first, then the style's files on top
# every Hyprland style is layered on the Auxo Hyprland rice
RICE_LAYERS = {r: "hyprland" for _s, r, _n, _d in auxo_desktops.HYPR_STYLES if r != "hyprland"}
RICE_PRESET = {"hyprland-mac": "mac", "hyprland-win": "win", "hyprland-neon": "neon", "hyprland-zen": "zen",
               "hyprland-candy": "candy"}       # the look preset that goes with a style
# each style starts light, on its own wallpaper (change both freely afterwards)
RICE_LOOK = {"hyprland-mac": {"mode": "light", "wallpaper": "/usr/share/wallpapers/auxo-lagoon.jpg"},
             "hyprland-win": {"mode": "light", "wallpaper": "/usr/share/wallpapers/auxo-bloom.jpg"},
             "hyprland-neon": {"mode": "dark", "wallpaper": "/usr/share/wallpapers/auxo-neon.jpg"},
             "hyprland-zen": {"mode": "light", "wallpaper": "/usr/share/wallpapers/auxo-zen.jpg"},
             "hyprland-candy": {"mode": "light", "wallpaper": "/usr/share/wallpapers/auxo-candy.jpg"}}


def apply_rice(name, user):
    if name in RICE_LAYERS:
        apply_rice(RICE_LAYERS[name], user)
    src = R(f"{SHARE}/rices/{name}")
    home = home_of(user)
    if name in SESSION_RICES:
        auxo_theme.apply_user(user, auxo_theme.current(), desktop=name)   # look files + first-login autostart
        env = auxo_theme.session_env(user)
        desk = (env or {}).get("XDG_CURRENT_DESKTOP", "").lower()
        if env and (name in desk or (name == "gnome" and "gnome" in desk)):
            run(["auxo-tweak", "session-apply", "--rice"], check=False, user=user, env=env)
            log(f"{user}: Auxo {name} rice applied")
        else:
            log(f"{user}: the Auxo {name} rice is applied at the next {name.title()} login")
        return
    if not os.path.isdir(src):
        raise AuxoError(f"no rice named {name}")
    dst = R(f"{home}/.config")
    if name == "hyprland":
        hypr_gpu_conf(user)             # hyprland.conf sources it: must exist
        # Void's Hyprland reads hyprland.conf; park a Lua config from the Arch-based Auxo
        old = R(f"{home}/.config/hypr/hyprland.lua")
        if os.path.exists(old):
            os.replace(old, old + ".auxo-bak")
    for base, _dirs, files in os.walk(src):
        rel = os.path.relpath(base, src)
        for f in files:
            target = os.path.normpath(os.path.join(dst, rel, f))
            os.makedirs(os.path.dirname(target), exist_ok=True)
            if os.path.exists(target) and not os.path.exists(target + ".auxo-bak"):
                shutil.copy2(target, target + ".auxo-bak")
            shutil.copy2(os.path.join(base, f), target)
    for base, _dirs, files in os.walk(dst):  # scripts inside the rice must stay executable
        for f in files:
            if f.endswith(".sh"):
                os.chmod(os.path.join(base, f), 0o755)
    if name in RICE_PRESET:
        look = auxo_look.preset(auxo_look.load(home), RICE_PRESET[name])
        for k, v in RICE_LOOK.get(name, {}).items():
            if k != "wallpaper" or os.path.exists(R(v)):
                look[k] = v
        auxo_look.save(home, look)
    auxo_theme.apply_user(user, auxo_theme.current())
    chown(f"{home}/.config", user, recursive=True)
    write_conf({f"RICE_{name.split('-')[0].upper()}": name})
    if refresh_session(name, user):
        log(f"{user}: Auxo {name} rice applied — your desktop was refreshed (old files kept as *.auxo-bak)")
    else:
        log(f"{user}: Auxo {name} rice applied (old files kept as *.auxo-bak)")


def refresh_session(name, user):
    """Show a new Hyprland/Sway rice right away: reload the compositor and restart the bar
    (Waybar doesn't notice a new config by itself, so a style switch looked like it did nothing)."""
    if DRY:
        return False
    env = auxo_theme.session_env(user) if os.geteuid() == 0 else _my_session_env(user)
    if not env:
        return False
    if name.startswith("hyprland") and env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run(["hyprctl", "reload"], check=False, user=user, env=env)
    elif name == "sway" and env.get("SWAYSOCK"):
        run(["swaymsg", "reload"], check=False, user=user, env=env)
    else:
        return False
    if name.startswith("hyprland"):          # the taskbar / dock pins (auxo-pins) for this style's icon size
        run(["auxo-pins", "refresh", "--no-reload"], check=False, user=user, env={**env, "HOME": home_of(user)})
    run(["pkill", "-x", "waybar"], check=False, user=user, env=env)
    run(["sh", "-c", "sleep 0.3; setsid waybar >/dev/null 2>&1 &"], check=False, user=user, env=env)
    return True


DISPLAY_MANAGERS = ("sddm", "gdm", "lightdm", "greetd", "lxdm")


def set_display_manager(dm):
    for other in DISPLAY_MANAGERS:
        if other != dm and sv_enabled(other):
            sv_disable(other)
    if dm:
        sv_enable(dm)


def set_default_session(user, session, dm="greetd"):
    """greetd/tuigreet: pre-fill the username (the desktop comes from greetd's config).
    GDM: remember the session in AccountsService so GDM starts it without asking."""
    if not user:
        return
    if dm == "gdm":
        write_file(f"/var/lib/AccountsService/users/{user}", f"[User]\nSession={session}\nSystemAccount=false\n", mode=0o600)
        return
    write_file("/var/cache/tuigreet/lastuser", user + "\n")
    run(["chown", "-R", "_greeter:_greeter", "/var/cache/tuigreet"], check=False)


FETCH_REPO = "/usr/libexec/auxo/auxo-fetch-repo"


def local_repo(name, path, url, refresh=False):
    """Use a package archive Auxo publishes as a local repository (no signing key needed).
    The ISO ships the Hyprland one; others are downloaded. refresh: get the newest when online."""
    have_it = os.path.exists(R(f"{path}/x86_64-repodata"))
    if (refresh or not have_it) and online():
        log(f"{name}: downloading Auxo's packages")
        if DRY:
            run([FETCH_REPO, url, path], check=False)
        elif run([FETCH_REPO, url, path], check=False) != 0 and not have_it:
            raise AuxoError(f"couldn't download {url} — check your connection and try again")
    elif not have_it:
        raise AuxoError(f"{name} needs internet the first time — connect (nmtui) and try again")
    write_file(f"/etc/xbps.d/20-{name}.conf", f"# added by auxo-tweak: Auxo's own {name} packages\nrepository={path}\n")


def cmd_desktop(args):
    require_root()
    d = DESKTOPS[args.name]
    if d["packages"]:
        if not online() and not all(installed(p) for p in d["packages"]):
            raise AuxoError("no internet connection — connect first (nmtui) and try again")
        if d.get("repo"):
            # Hyprland: Auxo's own build (the hyprland-void repo older Auxo used no longer installs)
            local_repo(args.name, d["repo"], auxo_desktops.HYPRLAND_PACKAGES_URL, refresh=True)
        log(f"installing {d['name']}")
        xbps_install(*d["packages"])
        if d.get("build") == "chrono":
            import auxo_chrono
            auxo_chrono.build(getattr(args, "chrono_ref", None) or auxo_chrono.REF)
        for sv in GUI_SERVICES:
            sv_enable(sv)
        if installed("power-profiles-daemon"):   # power profiles (Gaming mode, auxo-tweak power)
            sv_enable("power-profiles-daemon")
        audio_setup()                            # PipeWire starts at login, with WirePlumber + Pulse + ALSA
        for sv in ("dhcpcd", "wpa_supplicant"):  # NetworkManager manages the network now
            if sv_enabled(sv):
                sv_disable(sv)
    users = target_users(args)
    if d.get("rice"):
        # keep the style you picked last time (e.g. hyprland-mac)
        rice = read_conf().get(f"RICE_{d['rice'].upper()}", d["rice"])
        rice = rice if os.path.isdir(R(f"{SHARE}/rices/{rice}")) or rice in SESSION_RICES else d["rice"]
        for u in users:
            apply_rice(rice, u)
    if args.name == "gnome":
        auxo_gnome.cleanup()
        for u in users:  # the installer already asked these questions: skip GNOME's first-login wizard
            write_file(f"{home_of(u)}/.config/gnome-initial-setup-done", "yes", owner=u)
    if args.replace:
        keep = set(d["packages"]) | set(GUI_SERVICES)
        if args.name == "sway":
            keep |= set(DESKTOPS["sway"]["packages"])
        remove = [p for p in live_packages() if p not in keep and p not in auxo_desktops.GUI_BASE
                  and (installed(p) or DRY)]
        if remove:
            log("removing what only the live desktop needed")
            if xbps_remove(*remove) != 0:
                for p in remove:  # something still needs one of them: remove what we can
                    xbps_remove(p)
    write_conf({"DESKTOP": args.name})
    set_display_manager(d["dm"])
    if d["dm"] == "greetd":
        auxo_theme.apply_login(auxo_theme.current())
    if users and d["dm"] in ("greetd", "gdm"):
        set_default_session(users[0], d["session"], d["dm"])
    log(f"desktop → {d['name']}. Reboot or log out to use it.")


# short names people type for the Hyprland styles
STYLE_ALIASES = {"cyber": "neon", "cyberpunk": "neon", "synthwave": "neon", "minimal": "zen", "clean": "zen",
                 "pastel": "candy", "cute": "candy", "macos": "mac", "osx": "mac", "apple": "mac", "glass": "mac", "liquid-glass": "mac",
                 "win": "windows", "win11": "windows", "windows11": "windows", "default": "auxo", "normal": "auxo"}
RICE_ALIASES = {"mac": "hyprland-mac", "hyprland-macos": "hyprland-mac", "hypr-mac": "hyprland-mac",
                "windows": "hyprland-win", "hyprland-windows": "hyprland-win", "hypr-win": "hyprland-win"}


def rice_name(value):
    v = value.lower()
    v = STYLE_ALIASES.get(v, v)
    return RICE_ALIASES.get(v, v)


def forgiving_argv(argv):
    """`rice hyprland -mac`, `rice hyprland neon`, `desktop hyprland-mac` → what was meant."""
    a = list(argv)
    for i in range(len(a) - 1):
        if a[i].lower() in ("hyprland", "hypr"):
            st = STYLE_ALIASES.get(a[i + 1].lower().lstrip("-"), a[i + 1].lower().lstrip("-"))
            if st in auxo_desktops.STYLE_RICE and st != "auxo":
                a[i:i + 2] = [auxo_desktops.STYLE_RICE[st]]
                break
    if len(a) >= 2 and a[0] == "desktop":
        st = STYLE_ALIASES.get(a[1].lower(), a[1].lower()).removeprefix("hyprland-")
        st = {"win": "windows"}.get(st, st)
        if st in auxo_desktops.STYLE_RICE and st != "auxo" and a[1].lower() not in DESKTOPS:
            log(f"Installing Hyprland; then run: sudo auxo-tweak style {st}")
            a[1] = "hyprland"
    return a


def cmd_style(args):
    """auxo-tweak style auxo|mac|windows|neon|zen|candy: the Hyprland rice for that style."""
    args.name = auxo_desktops.STYLE_RICE[args.name]
    cmd_rice(args)


def cmd_rice(args):
    require_root()
    if args.name.startswith("hyprland") and not (have("Hyprland") or have("hyprland")):
        log("Hyprland isn't installed yet, so this style is saved for when it is. Install it with: "
            "sudo auxo-tweak desktop hyprland")
    for u in target_users(args):
        apply_rice(args.name, u)


# ── look (per user: no root needed) ───────────────────────────────────
def _look_user(args):
    if getattr(args, "user", None):
        require_root()
        return args.user
    if os.geteuid() == 0:
        u = invoking_user()
        if u:
            return u
    import pwd
    return pwd.getpwuid(os.getuid()).pw_name


def _apply_look(user, live=True):
    """Write the look files for `user` and (live) push them to the desktop they're using now."""
    accent = auxo_theme.current()
    auxo_theme.apply_user(user, accent, autostart=False)
    if not live:
        return
    import pwd
    me = pwd.getpwuid(os.getuid()).pw_name
    if me == user and os.environ.get("XDG_CURRENT_DESKTOP"):
        auxo_theme.session_apply(accent)                        # we're inside the session already
    else:
        env = auxo_theme.session_env(user)
        if env:
            run(["auxo-tweak", "session-apply"], check=False, user=user, env=env)


def cmd_look(args):
    user = _look_user(args)
    home = home_of(user)
    look = auxo_look.load(home)
    if args.action in (None, "show"):
        if args.json:
            import json
            print(json.dumps({"user": user, "look": look, "defaults": auxo_look.DEFAULTS,
                              "reach": auxo_look.REACH, "labels": auxo_look.LABELS,
                              "desktop": read_conf().get("DESKTOP", ""), "accent": auxo_theme.current()}))
            return
        print(f"{BOLD}Look settings for {user}{RESET}  {DIM}({auxo_look.path(home)}){RESET}")
        for k, v in look.items():
            mark = "" if v == auxo_look.DEFAULTS[k] else f"  {DIM}(default {auxo_look.DEFAULTS[k]}){RESET}"
            print(f"  {k:<13} {v:<18}{mark}  {DIM}{auxo_look.REACH[k]}{RESET}")
        print(f"\n{DIM}change one: auxo-tweak look set gaps=4 rounding=0 bar=bottom   ·   reset: auxo-tweak look reset{RESET}")
        return
    if args.action == "get":
        for k in args.items:
            if k not in look:
                raise AuxoError(f"unknown setting '{k}'. settings: {', '.join(auxo_look.DEFAULTS)}")
            print(look[k])
        return
    if args.action == "set":
        if not args.items:
            raise AuxoError("give settings to change, like: auxo-tweak look set mode=light gaps=4")
        for item in args.items:
            if "=" not in item:
                raise AuxoError(f"'{item}': use KEY=VALUE, like gaps=4")
            k, v = item.split("=", 1)
            try:
                look[k.strip()] = auxo_look.validate(k.strip(), v)
            except auxo_look.LookError as e:
                raise AuxoError(str(e)) from None
    elif args.action == "presets":
        for k, (name, desc, _v) in auxo_look.PRESETS.items():
            print(f"  {BOLD}{k:<9}{RESET} {desc}")
        print(f"\n{DIM}use one: auxo-tweak look preset glass{RESET}")
        return
    elif args.action == "preset":
        if len(args.items) != 1:
            raise AuxoError(f"name one preset: {', '.join(auxo_look.PRESETS)}")
        try:
            look = auxo_look.preset(look, args.items[0])
        except auxo_look.LookError as e:
            raise AuxoError(str(e)) from None
        args.items = list(auxo_look.PRESETS[args.items[0]][2])
    elif args.action == "export":
        out = args.items[0] if args.items else os.path.join(home, f"my-rice{auxo_look.RICE_EXT}")
        text = auxo_look.rice_export(look, auxo_theme.current(), read_conf().get("DESKTOP", ""),
                                     args.name or f"{user}'s Auxo rice")
        if out == "-":
            print(text, end="")
            return
        out = os.path.abspath(os.path.expanduser(out))
        write_file(out, text, owner=user if os.geteuid() == 0 else None)
        log(f"rice saved to {out} — share it, and others import it with: auxo-tweak look import {os.path.basename(out)}")
        return
    elif args.action == "import":
        if len(args.items) != 1:
            raise AuxoError("give the rice file: auxo-tweak look import my-rice.auxorice")
        try:
            changes, acc, desk, name = auxo_look.rice_import(open(R(os.path.abspath(os.path.expanduser(args.items[0])))).read())
        except OSError as e:
            raise AuxoError(f"can't read {args.items[0]}: {e.strerror}") from None
        except auxo_look.LookError as e:
            raise AuxoError(str(e)) from None
        look.update(changes)
        args.items = list(changes)
        log(f"importing “{name}”")
        if acc and acc != auxo_theme.current():
            if os.geteuid() == 0:
                cmd_accent(argparse.Namespace(name=acc, user=user, no_grub=False, no_initramfs=True))
            else:
                print(f"{DIM}this rice uses the {acc} accent: sudo auxo-tweak accent {acc}{RESET}")
        if desk and desk in DESKTOPS and desk != read_conf().get("DESKTOP"):
            print(f"{DIM}made on {DESKTOPS[desk]['name']}: sudo auxo-tweak desktop {desk}{RESET}")
    elif args.action == "reset":
        keys = args.items or list(auxo_look.DEFAULTS)
        for k in keys:
            if k not in auxo_look.DEFAULTS:
                raise AuxoError(f"unknown setting '{k}'")
            look[k] = auxo_look.DEFAULTS[k]
    auxo_look.save(home, look)
    _apply_look(user, live=not args.no_apply)
    changed = ", ".join(f"{k}={look[k]}" for k in (args.items and [i.split("=", 1)[0].strip() for i in args.items] or look))
    log(f"{user}: look → {changed}")


def cmd_mode(args):
    args.action, args.items, args.json = "set", [f"mode={args.mode}"], False
    cmd_look(args)


def cmd_wallpaper(args):
    v = args.file
    if v.lower() not in ("accent", "default", "auxo"):
        v = os.path.abspath(os.path.expanduser(v))
        if not os.path.isfile(R(v)):
            raise AuxoError(f"no such image: {v}")
    args.action, args.items, args.json = "set", [f"wallpaper={v}"], False
    cmd_look(args)


# ── app bundles (every name checked against Void's package list) ──────
from auxo_apps import APP_BUNDLES, FLATPAK_APPS, NONFREE_APPS  # noqa: E402


def _flatpak_has(app_id):
    if DRY or not have("flatpak"):
        return False
    import subprocess
    return subprocess.run(["flatpak", "info", "--system", app_id], capture_output=True).returncode == 0


def _flatpak_setup():
    xbps_install("flatpak")
    run(["flatpak", "remote-add", "--system", "--if-not-exists", "flathub",
         "https://dl.flathub.org/repo/flathub.flatpakrepo"], check=False)


def cmd_apps(args):
    if not args.names or args.names == ["list"]:
        for k, (desc, pkgs) in APP_BUNDLES.items():
            have_all = all(_flatpak_has(FLATPAK_APPS[p]) if p in FLATPAK_APPS else installed(p) for p in pkgs)
            print(f"  {BOLD}{k:<11}{RESET} {desc}{'  ' + DIM + '(installed)' + RESET if have_all else ''}")
        print(f"\n{DIM}install: auxo-tweak apps creative dev   ·   remove: auxo-tweak apps --remove fun{RESET}")
        return
    bad = [n for n in args.names if n not in APP_BUNDLES]
    if bad:
        raise AuxoError(f"no app bundle named {', '.join(bad)}. bundles: {', '.join(APP_BUNDLES)}")
    require_root()
    every = [p for n in args.names for p in APP_BUNDLES[n][1]]
    flat = [FLATPAK_APPS[p] for p in every if p in FLATPAK_APPS]
    pkgs = [p for p in every if p not in FLATPAK_APPS]
    if args.remove:
        present = [p for p in pkgs if installed(p) or DRY]
        if present:
            xbps_remove(*present)
        for app in flat:
            if DRY or _flatpak_has(app):
                run(["flatpak", "uninstall", "--system", "-y", "--noninteractive", app], check=False)
        log(f"removed: {', '.join(args.names)}")
        return
    if not online():
        raise AuxoError("no internet connection — connect first (nmtui) and try again")
    if NONFREE_APPS & set(pkgs):
        repo_enable("nonfree")
    if pkgs:
        xbps_install(*pkgs)
    if flat:
        _flatpak_setup()
        log(f"installing from Flathub: {', '.join(flat)}")
        run(["flatpak", "install", "--system", "-y", "--noninteractive", "flathub", *flat])
    log(f"installed: {', '.join(args.names)}")


# ── snapshots ─────────────────────────────────────────────────────────
SNAPPER_CFG = """# snapper config for / — written by auxo-tweak
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS="wheel"
SYNC_ACL="yes"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="12"
NUMBER_LIMIT_IMPORTANT="6"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="4"
TIMELINE_LIMIT_DAILY="5"
TIMELINE_LIMIT_WEEKLY="2"
TIMELINE_LIMIT_MONTHLY="1"
TIMELINE_LIMIT_YEARLY="0"
"""


def root_fstype():
    if DRY:
        return os.environ.get("AUXO_TEST_FSTYPE", "btrfs")
    return run(["findmnt", "-no", "FSTYPE", "/"], capture=True, check=False).strip()


def cmd_snapshots(args):
    if args.state == "status":
        cfg = os.path.exists(R("/etc/snapper/configs/root"))
        print(f"root filesystem : {root_fstype()}")
        print(f"snapper         : {'configured' if cfg else 'off'}")
        print(f"bootable menu   : {'on' if sv_enabled('grub-btrfs') else 'off'}")
        if cfg and have("snapper") and not DRY:
            run(["snapper", "-c", "root", "list", "--columns", "number,date,description"], check=False)
        return
    require_root()
    if args.state == "now":
        if not os.path.exists(R("/etc/snapper/configs/root")):
            raise AuxoError("snapshots are off — turn them on first: auxo-tweak snapshots on")
        run(["snapper", "--no-dbus", "-c", "root", "create", "-d", args.description or "made by hand (Auxo)"])
        log("snapshot taken — boot it from the GRUB menu, or make it your system with auxo-rollback")
        return
    if args.state == "off":
        for sv in ("grub-btrfs", "snapperd"):
            sv_disable(sv, now=True)
        set_kv("/etc/conf.d/snapper", "SNAPPER_CONFIGS", "")
        write_conf({"SNAPSHOTS": "off"})
        log("automatic snapshots disabled (existing ones are kept)")
        return
    if root_fstype() != "btrfs":
        raise AuxoError("snapshots need a btrfs root filesystem (choose btrfs in the installer)")
    xbps_install("snapper", "grub-btrfs", "inotify-tools", "cronie")
    write_file("/etc/snapper/configs/root", SNAPPER_CFG, mode=0o640)
    set_kv("/etc/conf.d/snapper", "SNAPPER_CONFIGS", "root")
    os.makedirs(R("/.snapshots"), exist_ok=True)
    if not DRY:
        os.chmod(R("/.snapshots"), 0o750)
        # the installer mounts @snapshots at /.snapshots; if not, make it a subvolume
        if subprocess.run(["mountpoint", "-q", "/.snapshots"]).returncode != 0 and not os.listdir("/.snapshots"):
            os.rmdir("/.snapshots")
            run(["btrfs", "subvolume", "create", "/.snapshots"], check=False)
    # snapper's hourly timeline + cleanup run from cron; grub-btrfs watches for new snapshots
    for sv in ("cronie", "grub-btrfs"):
        sv_enable(sv, now=not args.no_now)
    run(["snapper", "--no-dbus", "-c", "root", "create", "-d", args.description or "auxo-tweak: snapshots enabled"], check=False)
    write_conf({"SNAPSHOTS": "on"})
    if not args.no_grub:
        auxo_theme.grub_mkconfig()
    log("snapshots on: auxo-update snapshots before every update, hourly snapshots are kept for a day, "
        "and all of them are bootable from GRUB → 'Auxo snapshots'")


# ── repos / drivers ───────────────────────────────────────────────────
def cmd_repo(args):
    require_root()
    names = {"nonfree": ["nonfree"], "multilib": ["multilib", "multilib-nonfree"]}[args.name]
    repo_enable(*names)
    log(f"Void {args.name} repository enabled")


HYPR_GPU_NVIDIA = """# written by auxo-tweak nvidia on: what Hyprland needs on the NVIDIA driver
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = NVD_BACKEND,direct
env = GBM_BACKEND,nvidia-drm
cursor {
    no_hardware_cursors = true
}
"""
HYPR_GPU_NONE = "# written by auxo-tweak: no GPU-specific settings needed (NVIDIA ones appear here after nvidia on)\n"


def hypr_gpu_conf(user, nvidia=None):
    """~/.config/auxo/hyprland-gpu.conf: NVIDIA's Hyprland settings only when its driver is set up."""
    if nvidia is None:
        nvidia = read_conf().get("NVIDIA", "nouveau") not in ("nouveau", "")
    home = home_of(user)
    write_file(f"{home}/.config/auxo/hyprland-gpu.conf", HYPR_GPU_NVIDIA if nvidia else HYPR_GPU_NONE)
    chown(f"{home}/.config/auxo", user, recursive=True)


def nvidia_on(branch=None):
    """Install the right proprietary NVIDIA driver (from Void's nonfree repo)."""
    branch = branch or nvidia_branch()
    if branch in (None, "nouveau"):
        raise AuxoError("no NVIDIA GPU the proprietary driver supports; nouveau is used")
    repo_enable("nonfree")
    kernels = installed_kernels() or ["linux"]
    # DKMS builds the module for every kernel that has its headers installed
    xbps_install(branch, *[f"{k}-headers" for k in kernels])
    for other in ("nvidia", "nvidia580", "nvidia470"):
        if other != branch and installed(other):
            xbps_remove(other)
    write_file("/etc/modprobe.d/auxo-nvidia.conf",
               "# written by auxo-tweak\noptions nvidia_drm modeset=1 fbdev=1\n")
    if installed("void-repo-multilib"):
        repo_enable("multilib-nonfree")
        try:
            xbps_install(f"{branch}-libs-32bit")
        except AuxoError:
            warn("32-bit NVIDIA libraries not installed (needed by Steam/Wine)")
    write_conf({"NVIDIA": branch})
    for u in normal_users():
        hypr_gpu_conf(u, nvidia=True)


def cmd_drivers(args):
    require_root()
    gpus = gpu_info()
    if not gpus:
        warn("no GPU found via lspci")
    for _v, _d, desc in gpus:
        print(f"  {DIM}found{RESET} {desc}")
    vendors = {v for v, _, _ in gpus}
    intel_cpu = DRY or "GenuineIntel" in open("/proc/cpuinfo").read()
    xbps_install("mesa-dri", "vulkan-loader")
    if intel_cpu:
        try:  # Intel CPU microcode lives in nonfree (AMD's ships with linux-firmware); needs internet
            repo_enable("nonfree")
            xbps_install("intel-ucode")
        except AuxoError as e:
            warn(f"Intel microcode not installed ({e}); run 'auxo-tweak drivers' again when online")
    if "1002" in vendors:
        xbps_install("mesa-vulkan-radeon", "mesa-vaapi", "libva-utils")
    if "8086" in vendors:
        xbps_install("mesa-vulkan-intel", "intel-video-accel")
    branch = nvidia_branch()
    if branch and branch != "nouveau":
        log(f"NVIDIA GPU → {branch}")
        nvidia_on(branch)
    elif branch == "nouveau":
        warn("this NVIDIA GPU is too old for the proprietary drivers; using nouveau (open source)")
    if args.prune:
        nv = [p for p in ("nvidia", "nvidia580", "nvidia470") if installed(p)]
        if branch in (None, "nouveau") and nv:
            log("no supported NVIDIA GPU → removing NVIDIA packages")
            xbps_remove(*nv)
        if "1002" not in vendors:
            xbps_remove(*[p for p in ("mesa-vulkan-radeon",) if installed(p)])
        if "8086" not in vendors:
            xbps_remove(*[p for p in ("mesa-vulkan-intel", "intel-video-accel") if installed(p)])
        # VM guest tools: keep only the ones for the hypervisor we're running on
        virt = detect_virt()
        tools = {"oracle": [("virtualbox-ose-guest", "vboxservice")],
                 "kvm": [("qemu-ga", "qemu-ga"), ("spice-vdagent", "spice-vdagentd")],
                 "vmware": [("open-vm-tools", "vmtoolsd")]}
        for v, pairs in tools.items():
            for pkg, sv in pairs:
                if v == virt:
                    if installed(pkg) or DRY:
                        sv_enable(sv)
                elif installed(pkg):
                    sv_disable(sv)
                    xbps_remove(pkg)
    if branch not in (None, "nouveau") and not args.no_initramfs:
        regen_initramfs()
    write_conf({"GPU": ",".join(sorted(vendors)) or "none"})
    log("drivers done")


PRIME_RUN = """#!/bin/sh
# prime-run — run a program on the NVIDIA GPU of a hybrid laptop (written by auxo-tweak)
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
"""


def cmd_nvidia(args):
    branch = nvidia_branch()
    if args.state == "status" and getattr(args, "json", False):
        import json
        all_gpus = gpu_info()
        nv = [g for g in all_gpus if g[0] == "10de"]
        have_pkg = [p for p in ("nvidia", "nvidia580", "nvidia470") if installed(p)]
        print(json.dumps({"gpus": [g[2] for g in all_gpus], "nvidia": nv[0][2] if nv else None, "fits": branch,
                          "installed": have_pkg, "modeset": os.path.exists(R("/etc/modprobe.d/auxo-nvidia.conf")),
                          "hybrid": bool(nv) and any(g[0] in ("8086", "1002") for g in all_gpus),
                          "prime": os.path.exists(R("/usr/local/bin/prime-run"))}))
        return
    if args.state == "status":
        gpus = [g for g in gpu_info() if g[0] == "10de"]
        print(f"  GPU         {gpus[0][2] if gpus else 'no NVIDIA GPU'}")
        print(f"  fits        {branch or '-'}")
        have_pkg = [p for p in ('nvidia', 'nvidia580', 'nvidia470') if installed(p)]
        print(f"  installed   {', '.join(have_pkg) or 'none (nouveau)'}")
        print(f"  modeset     {'on' if os.path.exists(R('/etc/modprobe.d/auxo-nvidia.conf')) else 'off'}")
        print(f"  prime-run   {'yes' if os.path.exists(R('/usr/local/bin/prime-run')) else 'no'}")
        return
    require_root()
    if args.state == "on":
        nvidia_on(branch)
        regen_initramfs()
        log(f"NVIDIA {branch} installed — reboot to use it")
    elif args.state == "off":
        xbps_remove(*[p for p in ("nvidia", "nvidia580", "nvidia470") if installed(p)])
        _rm("/etc/modprobe.d/auxo-nvidia.conf")
        write_conf({"NVIDIA": "nouveau"})
        for u in normal_users():
            hypr_gpu_conf(u, nvidia=False)
        regen_initramfs()
        log("back to nouveau (open source) — reboot to use it")
    elif args.state == "prime":
        write_file("/usr/local/bin/prime-run", PRIME_RUN, mode=0o755)
        log("prime-run installed: run 'prime-run <program>' to use the NVIDIA GPU "
            "(Steam: prime-run %command%)")


# ── performance ───────────────────────────────────────────────────────
SCHEDULERS = {
    "lavd": "latency-aware, made for gaming",
    "bpfland": "keeps the desktop responsive under load",
    "flash": "low latency, fair",
    "cosmos": "lightweight general-purpose",
    "rusty": "multi-domain, good for many-core CPUs",
}
SCX_MODES = {"auto": "Auto", "gaming": "Gaming", "lowlatency": "LowLatency", "powersave": "PowerSave", "server": "Server"}
SCX_CONF = "/etc/scx_loader.toml"


def cmd_scheduler(args):
    name = args.name
    if name == "list":
        for s, d in SCHEDULERS.items():
            print(f"  {s:<9} {d}")
        print(f"  {DIM}modes: {', '.join(SCX_MODES)}{RESET}")
        return
    if name == "status":
        cur = get_kv(SCX_CONF, "default_sched", "-") if os.path.exists(R(SCX_CONF)) else "-"
        print(f"  scheduler   {cur if sv_enabled('scx-loader') else 'kernel default (EEVDF)'}")
        print(f"  kernel      {'sched_ext supported' if os.path.isdir('/sys/kernel/sched_ext') or DRY else 'no sched_ext support'}")
        return
    require_root()
    if name == "off":
        sv_disable("scx-loader", now=True)
        write_conf({"SCHEDULER": "default"})
        log("back to the kernel's default scheduler")
        return
    if name not in SCHEDULERS:
        raise AuxoError(f"unknown scheduler {name}; choose {', '.join(SCHEDULERS)}")
    if not (DRY or os.path.isdir("/sys/kernel/sched_ext")):
        warn("this kernel has no sched_ext support; the scheduler starts once you boot a kernel that does")
    xbps_install("scx", "scx-loader")
    mode = SCX_MODES[args.mode]
    write_file(SCX_CONF, f'# written by auxo-tweak scheduler\ndefault_sched = "scx_{name}"\ndefault_mode = "{mode}"\n')
    sv_enable("dbus")
    sv_enable("scx-loader", now=True)
    if not DRY and have("scxctl"):
        run(["scxctl", "switch", "-s", name, "-m", args.mode], check=False)
    write_conf({"SCHEDULER": f"{name}/{args.mode}"})
    log(f"CPU scheduler → scx_{name} ({mode}), also after reboot")


def cmd_power(args):
    require_root()
    xbps_install("power-profiles-daemon")
    sv_enable("dbus")
    sv_enable("power-profiles-daemon", now=True)
    if not DRY:
        run(["powerprofilesctl", "set", args.profile], check=False)
    write_conf({"POWER": args.profile})
    log(f"power profile → {args.profile}")


# ── network ───────────────────────────────────────────────────────────
def cmd_firewall(args):
    if args.state == "status":
        print(f"  firewall    {'on' if sv_enabled('ufw') else 'off'}")
        if have("ufw") and not DRY and os.geteuid() == 0:
            run(["ufw", "status", "verbose"], check=False)
        return
    require_root()
    if args.state == "on":
        xbps_install("ufw")
        run(["ufw", "default", "deny", "incoming"], check=False)
        run(["ufw", "default", "allow", "outgoing"], check=False)
        sv_enable("ufw", now=True)
        run(["ufw", "--force", "enable"], check=False)
        log("firewall on: incoming connections blocked, outgoing allowed (open a port: sudo ufw allow 22/tcp)")
    else:
        run(["ufw", "--force", "disable"], check=False)
        sv_disable("ufw", now=True)
        log("firewall off")
    write_conf({"FIREWALL": args.state})


DNS = {
    "cloudflare": ["1.1.1.1", "1.0.0.1", "2606:4700:4700::1111"],
    "quad9": ["9.9.9.9", "149.112.112.112", "2620:fe::fe"],
    "google": ["8.8.8.8", "8.8.4.4", "2001:4860:4860::8888"],
}
NM_DNS = "/etc/NetworkManager/conf.d/50-auxo-dns.conf"


def cmd_dns(args):
    require_root()
    if args.provider == "auto":
        _rm(NM_DNS)
        log("DNS → automatic (from your network)")
    else:
        servers = DNS[args.provider]
        write_file(NM_DNS, "# written by auxo-tweak dns\n[global-dns-domain-*]\nservers=" + ",".join(servers) + "\n")
        log(f"DNS → {args.provider} ({', '.join(servers)}) for every connection")
    if not DRY and have("nmcli"):
        run(["nmcli", "general", "reload"], check=False)
    write_conf({"DNS": args.provider})


# ── VPN (Mullvad, Proton, any WireGuard / OpenVPN file) ────────────────
def cmd_vpn(args):
    """auxo-tweak vpn [status|mullvad|proton|import FILE|on NAME|off|remove NAME|auto NAME on|off|check]"""
    import auxo_vpn
    if DRY:
        log(f"[dry-run] vpn {args.action} {' '.join(args.rest)}")
        return
    if not have("nmcli"):
        raise AuxoError("VPNs need NetworkManager: sudo auxo-tweak desktop … sets it up, or sudo xbps-install NetworkManager")
    v = auxo_vpn.VPN()
    a, rest = args.action, args.rest
    try:
        if a in ("status", "list"):
            conns = v.connections()
            if not conns:
                print("No VPNs yet. Add one:\n  auxo-tweak vpn mullvad        (or: vpn mullvad ACCOUNT-NUMBER)\n"
                      "  auxo-tweak vpn proton\n  auxo-tweak vpn import FILE.conf")
            for c in conns:
                print(f"  {'● connected ' if c['active'] else '○           '} {c['name']:<16} {c['type']}")
        elif a in ("mullvad", "proton"):
            prov = auxo_vpn.PROVIDERS[a]
            if a == "mullvad" and rest:
                if not have("wg"):
                    require_root()
                    xbps_install("wireguard-tools")
                made = v.mullvad_account(" ".join(rest[:1] if len(rest[0]) >= 16 else rest[:4]).replace(" ", ""),
                                         country=args.country, count=args.servers)
                log(f"Mullvad: added {', '.join(made)}. Connect: auxo-tweak vpn on {made[0]}")
                return
            downloads = os.path.join(home_of(invoking_user() or os.environ.get("USER", "root")), "Downloads")
            since = time.time()
            log(f"{prov['name']}: opening your account page. {prov['how']}")
            log(f"Auxo imports the file as soon as it's in {downloads} (Ctrl+C to stop waiting).")
            run(["xdg-open", prov["page"]], check=False)
            path = auxo_vpn.wait_for_download(downloads, since, timeout=args.wait)
            if not path:
                raise AuxoError(f"no config file showed up. Import it yourself: auxo-tweak vpn import FILE")
            name = v.import_file(path, provider=a)
            log(f"{prov['name']}: added {name}. Connect: auxo-tweak vpn on {name}  (or the network menu)")
        elif a == "import" and rest:
            for f in rest:
                name = v.import_file(os.path.expanduser(f), name=args.name)
                log(f"added {name}. Connect: auxo-tweak vpn on {name}")
        elif a in ("on", "up", "connect"):
            conns = v.connections()
            name = rest[0] if rest else (conns[0]["name"] if conns else None)
            if not name:
                raise AuxoError("no VPN to connect to yet (auxo-tweak vpn mullvad / proton / import FILE)")
            v.up(name)
            log(f"VPN on: {name}")
            prov = auxo_vpn.provider_of("", name)
            if prov:
                print("  " + v.check(prov))
        elif a in ("off", "down", "disconnect"):
            gone = v.down(rest[0] if rest else None)
            log("VPN off" + (f": {', '.join(gone)}" if gone else " (nothing was connected)"))
        elif a in ("remove", "delete") and rest:
            v.remove(rest[0])
            log(f"removed {rest[0]}")
        elif a == "auto" and rest:
            on = (rest[1:2] or ["on"])[0] in ("on", "yes", "1")
            v.autoconnect(rest[0], on)
            log(f"{rest[0]}: {'connects at startup' if on else 'connects only when you say so'}")
        elif a == "check":
            for prov in auxo_vpn.PROVIDERS:
                print(f"{auxo_vpn.PROVIDERS[prov]['name']}: {v.check(prov)}")
        else:
            raise AuxoError("usage: auxo-tweak vpn [status|mullvad [ACCOUNT]|proton|import FILE|on [NAME]|off|"
                            "remove NAME|auto NAME on|off|check]")
    except auxo_vpn.VPNError as e:
        raise AuxoError(str(e))


# ── housekeeping ──────────────────────────────────────────────────────
def _du(path):
    if DRY or not os.path.isdir(path):
        return 0
    out = run(["du", "-sb", path], capture=True, check=False) or "0"
    return int(out.split()[0] or 0)


def cmd_cleanup(args):
    require_root()
    before = _du("/var/cache/xbps")
    log("removing cached packages and orphaned dependencies")
    run(["xbps-remove", "-Ooy"], check=False)
    log("removing old kernels (the running one is always kept)")
    run(["vkpurge", "rm", "all"], check=False)
    if args.user_cache:
        for u in target_users(args):
            thumbs = R(f"{home_of(u)}/.cache/thumbnails")
            if os.path.isdir(thumbs):
                shutil.rmtree(thumbs, ignore_errors=True)
                log(f"{u}: thumbnail cache cleared")
    if have("flatpak") and not DRY:
        run(["flatpak", "uninstall", "--unused", "-y"], check=False)
    freed = max(0, before - _du("/var/cache/xbps"))
    log(f"cleanup done{f' — freed {freed / 1e6:.0f} MB of package cache' if freed else ''}")


def cmd_flatpak(args):
    if args.state == "status":
        print(f"  flatpak     {'installed' if installed('flatpak') else 'not installed'}")
        if have("flatpak") and not DRY:
            run(["flatpak", "remotes"], check=False)
        return
    require_root()
    xbps_install("flatpak")
    run(["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], check=False)
    write_conf({"FLATPAK": "on"})
    log("Flatpak + Flathub ready (log out and back in so apps show up in your menu)")


def cmd_mirrors(args):
    require_root()
    xbps_install("xmirror")
    if args.url:
        run(["xmirror", "-s", args.url])
    elif args.default:
        run(["xmirror", "-d"])
    else:
        run(["xmirror"])  # interactive list of Void mirrors
    log("mirror updated")


def cmd_zram(args):
    require_root()
    if args.state == "on":
        xbps_install("zramen")
        write_file("/etc/sv/zramen/conf",
                   "# written by auxo-tweak zram\nexport ZRAM_COMP_ALGORITHM=zstd\nexport ZRAM_SIZE=50\n"
                   "export ZRAM_MAX_SIZE=8192\nexport ZRAM_PRIORITY=100\n")
        write_file("/etc/sysctl.d/99-auxo-zram.conf",
                   "vm.swappiness = 180\nvm.watermark_boost_factor = 0\nvm.watermark_scale_factor = 125\nvm.page-cluster = 0\n")
        sv_enable("zramen", now=True)
    else:
        sv_disable("zramen", now=True)
        _rm("/etc/sysctl.d/99-auxo-zram.conf")
    write_conf({"ZRAM": args.state})
    log(f"zram {args.state}")


SERVICES = {
    "bluetooth": (["bluez"], ["bluetoothd"]),
    "cups": (["cups", "cups-filters", "system-config-printer"], ["cupsd"]),
    "sshd": (["openssh"], ["sshd"]),
    "power-profiles": (["power-profiles-daemon"], ["power-profiles-daemon"]),
}


def cmd_service(args):
    require_root()
    pkgs, svs = SERVICES[args.name]
    if args.state == "on":
        xbps_install(*pkgs)
        for sv in svs:
            sv_enable(sv, now=True)
    else:
        for sv in svs:
            sv_disable(sv, now=True)
    log(f"{args.name} {args.state}")


def cmd_info(args):
    c = read_conf()
    acc = auxo_theme.current()
    print(f"{BOLD}Auxo settings{RESET}")
    for k in ("ACCENT", "DESKTOP", "KERNEL", "NVIDIA", "SCHEDULER", "POWER", "FIREWALL", "DNS",
              "SNAPSHOTS", "ZRAM", "GPU"):
        v = c.get(k, "-")
        if k == "ACCENT":
            v = f"{ansi(ACCENTS[acc][0])}{acc}{RESET}"
        print(f"  {k.lower():<10} {v}")
    u = invoking_user()
    if u:
        lk = auxo_look.load(home_of(u))
        print(f"{BOLD}Look ({u}){RESET}  " + "  ".join(f"{k}={lk[k]}" for k in ("mode", "bar", "gaps", "rounding", "ui_font")))


# ── monitors: resolution, refresh rate, scale, layout, workspaces (Hyprland, Sway, i3) ──
def _my_session_env(user):
    """The environment of `user`'s running desktop: ours if we're inside it, else looked up."""
    import pwd
    if os.geteuid() != 0 and pwd.getpwuid(os.getuid()).pw_name == user and (
            os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        return dict(os.environ)
    return auxo_theme.session_env(user)


def _monitors_live(user, env):
    """Reload the running window manager so the new layout shows now."""
    if not env:
        return False
    if env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run(["hyprctl", "reload"], check=False, user=user, env=env)
    elif env.get("SWAYSOCK"):
        run(["swaymsg", "reload"], check=False, user=user, env=env)
    elif env.get("DISPLAY") and have("i3-msg") and read_conf().get("DESKTOP") == "i3":
        run([os.path.join(home_of(user), ".config/auxo/monitors-xrandr.sh")], check=False, user=user, env=env)
        run(["i3-msg", "reload"], check=False, user=user, env=env)
    else:
        return False
    return True


def cmd_monitors(args):
    import auxo_monitors as M
    user = _look_user(args)
    home = home_of(user)
    env = _my_session_env(user)
    mons = M.load(home)
    if args.action in (None, "list"):
        src, found = M.detect(env, user if os.geteuid() == 0 else None)
        if args.json:
            import json
            print(json.dumps({"source": src, "desktop": read_conf().get("DESKTOP", ""), "detected": found,
                              "saved": mons}))
            return
        if not found:
            print("no monitors found")
        for m in found:
            state = f"{m['width']}x{m['height']}" + (f"@{m['refresh']}" if m["refresh"] else "") + \
                    f"  at {m['x']},{m['y']}  scale {m['scale']:g}" + (f"  rotated {m['rotate']}°" if m["rotate"] != "0" else "")
            print(f"  {BOLD}{m['name']:<10}{RESET} {m['desc'][:28]:<28} {state if m['enabled'] else 'off'}")
            if m["modes"]:
                print(f"  {DIM}{'':<10} modes: {', '.join(m['modes'][:6])}{' …' if len(m['modes']) > 6 else ''}{RESET}")
        if mons:
            print(f"\n{BOLD}your settings{RESET} ({M.FILE}):")
            for n, m in sorted(mons.items()):
                diff = ", ".join(f"{k}={v}" for k, v in m.items() if v != M.DEFAULTS[k]) or "defaults"
                print(f"  {n:<10} {diff}")
        if read_conf().get("DESKTOP") in ("plasma", "gnome", "xfce", "cinnamon", "chrono"):
            print(f"\n{DIM}your desktop has its own display settings; these apply to Hyprland, Sway and i3{RESET}")
        else:
            print(f"\n{DIM}change one: auxo-tweak monitors set DP-1 mode=2560x1440@144 scale=1.25 position=0x0 "
                  f"workspaces=1-5{RESET}")
        return
    if args.action == "set":
        if not args.items or "=" in args.items[0]:
            raise AuxoError("name the monitor first: auxo-tweak monitors set DP-1 mode=2560x1440@144 (see: auxo-tweak monitors)")
        name, changes = args.items[0], {}
        for it in args.items[1:]:
            if "=" not in it:
                raise AuxoError(f"“{it}” should be setting=value. settings: {', '.join(M.KEYS)}")
            k, v = it.split("=", 1)
            changes[k.strip()] = v
        M.detect(env, user if os.geteuid() == 0 else None)
        try:
            mons = M.update(mons, name, changes)
        except M.MonitorError as e:
            raise AuxoError(str(e)) from None
    elif args.action == "reset":
        mons = {} if not args.items else {k: v for k, v in mons.items() if k not in args.items}
    M.save(home, mons, owner=user if os.geteuid() == 0 else None)
    M.write(home, owner=user if os.geteuid() == 0 else None)
    from auxo_look import ensure_line
    for rel, line in M.HOOKS:
        ensure_line(f"{home}/{rel}", line)
    if args.no_apply:
        log("monitors saved")
    elif _monitors_live(user, env):
        log("monitors saved and applied")
    else:
        log("monitors saved — used the next time you log in to Hyprland, Sway or i3")


# ── Auxo AI: a local assistant (Ollama), free and offline once the model is downloaded ──
AI_MODELS = {
    "small": ("llama3.2:1b", "about 1.3 GB — any PC with 8 GB of RAM"),
    "standard": ("llama3.2:3b", "about 2 GB — the default, 8 GB of RAM or more"),
    "large": ("qwen3:8b", "about 5 GB — 16 GB of RAM or a recent graphics card"),
}
OLLAMA_SV = """#!/bin/sh
# Auxo AI (Ollama) — written by auxo-tweak ai
exec 2>&1
export HOME=/var/lib/ollama OLLAMA_MODELS=/var/lib/ollama/models OLLAMA_HOST=127.0.0.1:11434
exec chpst -u ollama:ollama /usr/local/bin/ollama serve
"""


def _ai_wait(seconds=30):
    if DRY:
        return True
    import time
    import urllib.request
    for _ in range(seconds):
        try:
            urllib.request.urlopen("http://127.0.0.1:11434/api/version", timeout=2).read()
            return True
        except OSError:
            time.sleep(1)
    return False


def cmd_ai(args):
    c = read_conf()
    if args.state == "status":
        on = sv_enabled("ollama")
        print(f"Auxo AI : {'on' if on else 'off'}")
        print(f"model   : {c.get('AI_MODEL', '-')}")
        if not on:
            print(f"{DIM}turn it on: sudo auxo-tweak ai on   (models: {', '.join(AI_MODELS)}){RESET}")
        return
    if args.state == "models":
        for k, (m, d) in AI_MODELS.items():
            print(f"  {BOLD}{k:<9}{RESET} {m:<14} {DIM}{d}{RESET}")
        return
    require_root()
    if args.state == "off":
        sv_disable("ollama", now=True)
        if args.purge:
            for pth in ("/usr/local/bin/ollama", "/usr/local/lib/ollama", "/var/lib/ollama", "/etc/sv/ollama"):
                _rm(pth)
        write_conf({"AI": "off"})
        log("Auxo AI off" + (" and removed" if args.purge else " (models kept; --purge removes them)"))
        return
    model = AI_MODELS.get(args.model, (args.model,))[0] if args.model else c.get("AI_MODEL") or AI_MODELS["standard"][0]
    if not online():
        raise AuxoError("no internet connection — the first setup downloads Ollama and the model")
    xbps_install("curl", "zstd")
    if not os.path.exists(R("/usr/local/bin/ollama")) or args.state == "update":
        arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(os.uname().machine)
        if not arch:
            raise AuxoError(f"Ollama has no build for {os.uname().machine}")
        log("downloading Ollama (the engine that runs the model)")
        run(["sh", "-c", f"curl -fL --progress-bar https://ollama.com/download/ollama-linux-{arch}.tar.zst"
                         f" | tar --zstd -x -C {R('/usr/local')}"])
    def _names(path):
        try:
            return {l.split(":")[0] for l in open(R(path))}
        except OSError:
            return set()
    if "ollama" not in _names("/etc/passwd"):
        groups = ",".join(g for g in ("video", "render") if g in _names("/etc/group"))
        run(["useradd", "-r", "-d", "/var/lib/ollama", "-s", "/usr/bin/nologin"] + (["-G", groups] if groups else [])
            + ["ollama"], check=False)
    os.makedirs(R("/var/lib/ollama/models"), exist_ok=True)
    run(["chown", "-R", "ollama:ollama", "/var/lib/ollama"], check=False)
    write_file("/etc/sv/ollama/run", OLLAMA_SV, mode=0o755)
    sv_enable("ollama", now=True)
    if not _ai_wait():
        raise AuxoError("Ollama didn't start — see: sudo sv status ollama; sudo tail /var/log/socklog/everything/current")
    log(f"downloading the model {model} (one time; it then works offline)")
    run(["/usr/local/bin/ollama", "pull", model], env={"OLLAMA_HOST": "127.0.0.1:11434"})
    write_conf({"AI": "on", "AI_MODEL": model})
    log("Auxo AI is ready: ask it anything with auxo-ai, or in Auxo Settings → Ask Auxo")


# ── doctor: find (and with --fix, repair) the things that break Auxo installs ──
def _doctor_checks():
    """Each check: (id, title, problem or None, fix function or None, hint)."""
    c = read_conf()
    desk = c.get("DESKTOP", "")
    d = DESKTOPS.get(desk, {})
    out = []
    cfg = R("/etc/greetd/config.toml")
    greetd_on = sv_enabled("greetd")
    if greetd_on and os.path.exists(cfg):
        import re
        m = re.search(r"(?m)^\s*vt\s*=\s*(\d+)", open(cfg).read())
        vt = m.group(1) if m else "1"
        clash = sv_enabled(f"agetty-tty{vt}")
        out.append(("login-vt", "Login screen has its own console",
                    f"the login screen and a text login both use tty{vt}, so typed passwords get mixed up" if clash else None,
                    lambda: auxo_theme.apply_login(auxo_theme.current()),
                    "moves the login screen to tty7"))
    want = d.get("dm")
    if desk and desk != "none" and want:
        others = [x for x in DISPLAY_MANAGERS if x != want and sv_enabled(x)]
        prob = (f"{want} (the login screen for {d['name']}) is off" if not sv_enabled(want) else
                f"more than one login screen is on: {', '.join([want] + others)}" if others else None)
        out.append(("login-manager", "One login screen, the right one", prob, lambda: set_display_manager(want),
                    f"turns {want} on and the others off"))
        miss = [x for x in GUI_SERVICES if not sv_enabled(x)]
        out.append(("services", "Desktop services (D-Bus, elogind, NetworkManager)",
                    f"not running at boot: {', '.join(miss)}" if miss else None,
                    lambda: [sv_enable(x) for x in GUI_SERVICES], "turns them on"))
    if desk and desk != "none":
        miss = audio_missing()
        out.append(("sound", "Sound (PipeWire) starts at login",
                    f"not set up: {', '.join(os.path.basename(m) for m in miss)}" if miss else None,
                    lambda: (xbps_install("alsa-pipewire") if online() else None, audio_setup()),
                    "links PipeWire, WirePlumber and the PulseAudio/ALSA layers; log out and back in"))
        greet = R("/etc/greetd/config.toml")
        if want == "greetd" and d.get("cmd") and os.path.exists(greet) and d["cmd"] not in open(greet).read():
            out.append(("session", f"{d['name']} starts the right way", "the login screen uses an older start "
                        "command (no D-Bus session: no sound)", lambda: auxo_theme.apply_login(auxo_theme.current()),
                        "rewrites the login screen's start command"))
    if sv_enabled("NetworkManager"):
        both = [x for x in ("dhcpcd", "wpa_supplicant") if sv_enabled(x)]
        out.append(("network", "Only NetworkManager manages the network",
                    f"{', '.join(both)} also running, which fights NetworkManager for the connection" if both else None,
                    lambda: [sv_disable(x) for x in both], "turns them off"))
    if greetd_on:
        try:
            has = any(l.startswith("_greeter:") for l in open(R("/etc/passwd")))
        except OSError:
            has = True
        out.append(("greeter-user", "Login screen account (_greeter)", None if has else "the _greeter account is missing",
                    None, "reinstall greetd: sudo xbps-install -f greetd"))
    try:
        shadow = {l.split(":")[0]: l.split(":")[1] for l in open(R("/etc/shadow")) if l.count(":") > 2}
        locked = [u for u in normal_users() if shadow.get(u, "x")[:1] in ("!", "*", "")]
        out.append(("passwords", "Every user can log in", f"no usable password: {', '.join(locked)}" if locked else None,
                    None, "set one with: sudo passwd " + (locked[0] if locked else "USER")))
    except (OSError, IndexError):
        pass
    try:
        groups = {l.split(":")[0]: l.strip().split(":")[3].split(",") for l in open(R("/etc/group")) if l.count(":") == 3}
        nosudo = [u for u in normal_users() if u not in groups.get("wheel", [])]
        out.append(("sudo", "Your user can use sudo", f"not in the wheel group: {', '.join(nosudo)}" if nosudo else None,
                    (lambda: [run(["usermod", "-aG", "wheel", u], check=False) for u in nosudo]) if nosudo else None,
                    "adds them to wheel"))
    except (OSError, IndexError):
        pass
    st = os.statvfs(R("/"))
    free = st.f_bavail * st.f_frsize / 2**30
    out.append(("disk", "Free space on /", f"only {free:.1f} GB free" if free < 2 else None,
                lambda: cmd_cleanup(argparse.Namespace(user=None, user_cache=False)), "runs auxo-tweak cleanup"))
    news = []
    for base, _dirs, files in os.walk(R("/etc")):
        news += ["/" + os.path.relpath(os.path.join(base, f), R("/")) for f in files if ".new-" in f]
    out.append(("configs", "No config updates waiting", f"{len(news)} new config file(s) from updates: {', '.join(news[:3])}"
                if news else None, None, "compare each with the file without .new-…, then keep one"))
    return out


def cmd_doctor(args):
    checks = _doctor_checks()
    if args.json:
        import json
        print(json.dumps([{"id": i, "title": t, "problem": p, "fixable": bool(f), "hint": h} for i, t, p, f, h in checks]))
        return
    bad = [x for x in checks if x[2]]
    for i, t, p, f, h in checks:
        if p:
            print(f"  {ansi('#fb7185')}✗{RESET} {t}: {p}\n      {DIM}{'fix: ' + h if f else h}{RESET}")
        else:
            print(f"  {ansi('#34d399')}✓{RESET} {t}")
    if not bad:
        log("everything looks good")
        return
    if not args.fix:
        fixable = [x for x in bad if x[3]]
        if fixable:
            print(f"\n{DIM}repair with: sudo auxo-tweak doctor --fix{RESET}")
        return
    require_root()
    for i, t, p, f, h in bad:
        if f:
            f()
            log(f"fixed: {t}")
    print(f"{DIM}reboot to be sure everything picks up the changes{RESET}")


def cmd_session_apply(args):
    auxo_theme.session_apply(args.accent, once=args.once, rice=args.rice)


# ── gaming ────────────────────────────────────────────────────────────
GAMING_SYSCTL = "/etc/sysctl.d/80-auxo-gaming.conf"
GAMING_MODULES = "/etc/modules-load.d/auxo-gaming.conf"
GAMING_PKGS = ["gamemode", "MangoHud", "gamescope"]
# Steam's 32-bit dependencies, from Void's Steam documentation
STEAM_PKGS = ["steam", "libgcc-32bit", "libstdc++-32bit", "libdrm-32bit", "libglvnd-32bit", "mesa-dri-32bit"]


def cmd_gaming(args):
    conf = read_conf()
    if args.state == "status":
        print(f"  gaming      {conf.get('GAMING', 'off')}")
        for p in GAMING_PKGS + ["steam"]:
            print(f"  {p:<14}{'installed' if installed(p) else '-'}")
        print(f"  tweaks      {'on' if os.path.exists(R(GAMING_SYSCTL)) else 'off'}")
        return
    require_root()
    if args.state == "on":
        repo_enable("nonfree", "multilib", "multilib-nonfree")
        pkgs = list(GAMING_PKGS) + ([] if args.no_steam else STEAM_PKGS)
        vendors = {v for v, _, _ in gpu_info()}
        if "1002" in vendors:
            pkgs += ["mesa-vulkan-radeon", "mesa-vulkan-radeon-32bit"]
        if "8086" in vendors:
            pkgs += ["mesa-vulkan-intel", "mesa-vulkan-intel-32bit"]
        branch = nvidia_branch()
        if branch in ("nvidia", "nvidia580", "nvidia470") and installed(branch):
            pkgs += [f"{branch}-libs-32bit"]
        xbps_install(*pkgs)
        write_file(GAMING_SYSCTL,
                   "# written by auxo-tweak gaming — remove with: auxo-tweak gaming off\n"
                   "# more memory maps for games that need them (same value as SteamOS)\n"
                   "vm.max_map_count = 2147483642\n"
                   "# don't slow down games that trigger split-lock detection\n"
                   "kernel.split_lock_mitigate = 0\n")
        # ntsync: kernel-side Windows sync primitives, used by Wine / Proton for smoother frame pacing
        write_file(GAMING_MODULES, "# written by auxo-tweak gaming\nntsync\n")
        run(["sysctl", "--system"], check=False)
        run(["modprobe", "ntsync"], check=False)
        write_conf({"GAMING": "on"})
        log("gaming on")
        print(f"   {DIM}Steam launch options:{RESET}  gamemoderun mangohud %command%")
        print(f"   {DIM}Gaming CPU scheduler:{RESET}  auxo-tweak scheduler lavd --mode gaming")
        print(f"   {DIM}Proton-GE:{RESET}             auxo-tweak flatpak on && flatpak install flathub net.davidotek.pupgui2")
    else:
        for p in (GAMING_SYSCTL, GAMING_MODULES):
            _rm(p)
        run(["sysctl", "--system"], check=False)
        if args.purge:
            xbps_remove(*[p for p in GAMING_PKGS if installed(p)])
        write_conf({"GAMING": "off"})
        log("gaming off" + ("" if args.purge else " (tweaks removed; games and tools kept — use --purge to remove GameMode/MangoHud/gamescope)"))


# ── interactive menu (whiptail, from the newt package) ─────────────────
def wt(*a):
    r = subprocess.run(["whiptail", "--title", "auxo-tweak", *a], stderr=subprocess.PIPE, text=True)
    return r.stderr.strip() if r.returncode == 0 else None


def menu():
    if not have("whiptail"):
        print(__doc__)
        return
    me = [sys.executable, os.path.abspath(__file__)]
    while True:
        choice = wt("--menu", "Climb your own setup — pick something to change", "26", "72", "20",
                    "settings", "Open Auxo Settings (the graphical app)",
                    "accent", "Accent colour", "mode", "Light or dark", "desktop", "Desktop / window manager", "kernel", "Kernel",
                    "shell", "Login shell", "drivers", "GPU drivers", "nvidia", "NVIDIA driver",
                    "scheduler", "CPU scheduler (sched-ext)", "power", "Power profile",
                    "firewall", "Firewall", "dns", "DNS servers", "snapshots", "Btrfs snapshots",
                    "gaming", "Gaming mode", "flatpak", "Flatpak + Flathub", "cleanup", "Free up disk space",
                    "mirrors", "Faster mirror", "apps", "Install app bundles", "update", "Update everything (auxo-update)", "quit", "Exit")
        if choice in (None, "quit"):
            return
        cmd = None
        pick = {
            "accent": ("Accent colour", [[n, a] for n, (a, _) in ACCENTS.items()]),
            "desktop": ("Desktop", [[k, d["name"]] for k, d in DESKTOPS.items()]),
            "kernel": ("Kernel", [[k, d] for k, d in KERNELS.items()]),
            "shell": ("Shell", [["zsh", ""], ["fish", ""], ["bash", ""]]),
            "nvidia": ("NVIDIA", [["status", "show"], ["on", "install the right driver"],
                                  ["off", "back to nouveau"], ["prime", "laptop GPU offload"]]),
            "scheduler": ("CPU scheduler", [[k, v] for k, v in SCHEDULERS.items()] + [["off", "kernel default"], ["status", ""]]),
            "power": ("Power profile", [["balanced", ""], ["performance", ""], ["power-saver", ""]]),
            "firewall": ("Firewall", [["on", ""], ["off", ""], ["status", ""]]),
            "dns": ("DNS", [[k, ", ".join(v[:2])] for k, v in DNS.items()] + [["auto", "from your network"]]),
            "snapshots": ("Snapshots", [["on", "enable"], ["off", "disable"], ["status", "show"]]),
            "gaming": ("Gaming mode", [["on", ""], ["off", ""], ["status", ""]]),
            "flatpak": ("Flatpak", [["on", ""], ["status", ""]]),
            "apps": ("App bundles", [[k, v[0][:50]] for k, v in APP_BUNDLES.items()]),
        }
        if choice == "settings":
            subprocess.Popen(["auxo-settings"], start_new_session=True) if have("auxo-settings") else None
            continue
        if choice == "mode":
            v = wt("--menu", "Light or dark", "12", "40", "2", "dark", "", "light", "")
            if v:
                subprocess.run([*me, "mode", v])          # per user: no sudo
            continue
        if choice in pick:
            title, items = pick[choice]
            v = wt("--menu", title, "20", "64", str(min(len(items), 10)), *sum(items, []))
            cmd = [choice, v] if v else None
        elif choice == "update":
            subprocess.run(["auxo-update"])
            continue
        else:
            cmd = [choice]
        if cmd:
            subprocess.run(["sudo", *me, *cmd] if os.geteuid() != 0 else [*me, *cmd])
            input(f"\n{DIM}press Enter to go back{RESET}")


def main():
    if sys.argv[1:2] == ["summit"]:          # the hidden route (not in --help or the menu)
        import auxo_summit
        return auxo_summit.main()
    p = argparse.ArgumentParser(prog="auxo-tweak", description="Change your Auxo system without reinstalling.")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("accent"); s.add_argument("name", nargs="?", choices=list(ACCENTS))
    s.add_argument("--user"); s.add_argument("--no-grub", action="store_true")
    s.add_argument("--no-initramfs", action="store_true"); s.set_defaults(fn=cmd_accent)
    s = sub.add_parser("kernel"); s.add_argument("name", choices=list(KERNELS))
    s.add_argument("--no-grub", action="store_true"); s.add_argument("--no-initramfs", action="store_true")
    s.set_defaults(fn=cmd_kernel)
    s = sub.add_parser("shell"); s.add_argument("name", choices=list(SHELLS)); s.add_argument("--user")
    s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_shell)
    s = sub.add_parser("desktop"); s.add_argument("name", choices=list(DESKTOPS)); s.add_argument("--user")
    s.add_argument("--replace", action="store_true", help="remove what only the live desktop needed")
    s.add_argument("--chrono-ref", help="build this Chrono commit instead of the tested one"); s.set_defaults(fn=cmd_desktop)
    s = sub.add_parser("rice"); s.add_argument("name", type=rice_name,
                                               choices=["gnome", "xfce", "cinnamon", *auxo_desktops.STYLE_RICE.values(),
                                                        "sway", "i3", "chrono"])
    s.add_argument("--user"); s.set_defaults(fn=cmd_rice)
    s = sub.add_parser("style", help="Hyprland's look: " + ", ".join(auxo_desktops.STYLE_RICE))
    s.add_argument("name", type=lambda v: STYLE_ALIASES.get(v.lower(), v.lower()), choices=list(auxo_desktops.STYLE_RICE))
    s.add_argument("--user"); s.set_defaults(fn=cmd_style)
    s = sub.add_parser("look"); s.add_argument("action", nargs="?", choices=["show", "get", "set", "reset", "presets", "preset",
                                                                       "export", "import"])
    s.add_argument("--name", help="export: the name shown when someone imports it")
    s.add_argument("items", nargs="*"); s.add_argument("--user"); s.add_argument("--json", action="store_true")
    s.add_argument("--no-apply", action="store_true", help="write the files but leave the running desktop alone"); s.set_defaults(fn=cmd_look)
    s = sub.add_parser("mode"); s.add_argument("mode", choices=["dark", "light"]); s.add_argument("--user")
    s.add_argument("--no-apply", action="store_true"); s.set_defaults(fn=cmd_mode)
    s = sub.add_parser("wallpaper"); s.add_argument("file", help="an image, or 'accent' for the Auxo wallpaper")
    s.add_argument("--user"); s.add_argument("--no-apply", action="store_true"); s.set_defaults(fn=cmd_wallpaper)
    s = sub.add_parser("apps"); s.add_argument("names", nargs="*"); s.add_argument("--remove", action="store_true")
    s.set_defaults(fn=cmd_apps)
    s = sub.add_parser("snapshots"); s.add_argument("state", choices=["on", "off", "status", "now"])
    s.add_argument("--no-grub", action="store_true"); s.add_argument("--no-now", action="store_true")
    s.add_argument("--description"); s.set_defaults(fn=cmd_snapshots)
    s = sub.add_parser("drivers"); s.add_argument("--no-initramfs", action="store_true")
    s.add_argument("--prune", action="store_true", help="remove drivers for hardware that isn't present")
    s.set_defaults(fn=cmd_drivers)
    s = sub.add_parser("nvidia"); s.add_argument("state", choices=["status", "on", "off", "prime"])
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_nvidia)
    s = sub.add_parser("scheduler"); s.add_argument("name", choices=list(SCHEDULERS) + ["list", "status", "off"])
    s.add_argument("--mode", choices=list(SCX_MODES), default="auto"); s.set_defaults(fn=cmd_scheduler)
    s = sub.add_parser("power"); s.add_argument("profile", choices=["balanced", "performance", "power-saver"])
    s.set_defaults(fn=cmd_power)
    s = sub.add_parser("firewall"); s.add_argument("state", choices=["on", "off", "status"]); s.set_defaults(fn=cmd_firewall)
    s = sub.add_parser("vpn", help="Mullvad, Proton VPN or any WireGuard/OpenVPN file, on and off")
    s.add_argument("action", nargs="?", default="status"); s.add_argument("rest", nargs="*")
    s.add_argument("--country", help="Mullvad: servers in this country (code or name)")
    s.add_argument("--servers", type=int, default=3, help="Mullvad: how many servers to add")
    s.add_argument("--name", help="import: the connection's name"); s.add_argument("--wait", type=int, default=600)
    s.set_defaults(fn=cmd_vpn)
    s = sub.add_parser("dns"); s.add_argument("provider", choices=list(DNS) + ["auto"]); s.set_defaults(fn=cmd_dns)
    s = sub.add_parser("cleanup"); s.add_argument("--user"); s.add_argument("--user-cache", action="store_true",
                                                                         help="also clear your thumbnail cache")
    s.set_defaults(fn=cmd_cleanup)
    s = sub.add_parser("flatpak"); s.add_argument("state", choices=["on", "status"]); s.set_defaults(fn=cmd_flatpak)
    s = sub.add_parser("mirrors"); s.add_argument("--url"); s.add_argument("--default", action="store_true")
    s.set_defaults(fn=cmd_mirrors)
    s = sub.add_parser("zram"); s.add_argument("state", choices=["on", "off"]); s.set_defaults(fn=cmd_zram)
    s = sub.add_parser("repo"); s.add_argument("name", choices=["nonfree", "multilib"]); s.set_defaults(fn=cmd_repo)
    s = sub.add_parser("gaming"); s.add_argument("state", choices=["on", "off", "status"]); s.add_argument("--user")
    s.add_argument("--no-steam", action="store_true"); s.add_argument("--purge", action="store_true")
    s.set_defaults(fn=cmd_gaming)
    s = sub.add_parser("service"); s.add_argument("name", choices=list(SERVICES)); s.add_argument("state", choices=["on", "off"])
    s.set_defaults(fn=cmd_service)
    s = sub.add_parser("info"); s.set_defaults(fn=cmd_info)
    s = sub.add_parser("monitors"); s.add_argument("action", nargs="?", choices=["list", "set", "reset"])
    s.add_argument("items", nargs="*"); s.add_argument("--user"); s.add_argument("--json", action="store_true")
    s.add_argument("--no-apply", action="store_true", help="save without reloading the running desktop")
    s.set_defaults(fn=cmd_monitors)
    s = sub.add_parser("ai"); s.add_argument("state", choices=["on", "off", "status", "models", "update"])
    s.add_argument("--model", help="small, standard, large or any Ollama model name"); s.add_argument("--purge", action="store_true")
    s.set_defaults(fn=cmd_ai)
    s = sub.add_parser("doctor"); s.add_argument("--fix", action="store_true"); s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_doctor)
    s = sub.add_parser("session-apply"); s.add_argument("--accent", choices=list(ACCENTS)); s.add_argument("--once", action="store_true")
    s.add_argument("--rice", action="store_true", help="also apply the GNOME/Cinnamon/Xfce rice")
    s.set_defaults(fn=cmd_session_apply)

    args = p.parse_args(forgiving_argv(sys.argv[1:]))
    if not args.cmd:
        menu()
        return
    try:
        args.fn(args)
    except AuxoError as e:
        warn(str(e))
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
