#!/usr/bin/env python3
"""auxo-tweak — change your Auxo system after install, no reinstall needed.

Run with no arguments for the interactive menu, or use a sub-command:

  auxo-tweak accent [NAME]            system + user accent colour (GRUB, login screen, MOTD, terminals, bars)
  auxo-tweak desktop NAME             plasma | gnome | xfce | cinnamon | hyprland | sway | i3 | none
  auxo-tweak rice NAME                re-apply the Auxo setup for hyprland | sway | i3 | kde
  auxo-tweak kernel NAME              linux | linux-lts | linux-mainline (becomes the default boot entry)
  auxo-tweak shell NAME               zsh | fish | bash
  auxo-tweak drivers [--prune]        detect the GPU and install the right driver
  auxo-tweak nvidia status|on|off|prime   NVIDIA driver: pick the right branch, back to nouveau, laptop offload
  auxo-tweak scheduler list|status|off|SCHED [--mode M]   sched-ext CPU schedulers (lavd, bpfland, ...)
  auxo-tweak power balanced|performance|power-saver       power profile
  auxo-tweak firewall on|off|status   ufw: block incoming, allow outgoing
  auxo-tweak dns cloudflare|quad9|google|auto             DNS servers for every connection
  auxo-tweak snapshots on|off|status  btrfs time-travel: snapper + bootable snapshots in GRUB
  auxo-tweak gaming on|off|status     Steam, GameMode, MangoHud, gamescope + low-latency tweaks
  auxo-tweak flatpak on|status        Flatpak + Flathub
  auxo-tweak cleanup                  clear the package cache, orphans and old kernels
  auxo-tweak mirrors [--url URL]      pick a faster Void mirror
  auxo-tweak zram on|off              compressed RAM swap
  auxo-tweak repo nonfree|multilib    enable Void's extra repositories
  auxo-tweak splash on|off|status     animated Auxo boot splash (Plymouth) in your accent colour
  auxo-tweak service NAME on|off      bluetooth | cups | sshd | power-profiles
  auxo-tweak info                     show current Auxo settings
"""
import argparse
import glob
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.environ.get("AUXO_LIB", "/usr/lib/auxo"))

from auxo_accents import ACCENTS, ansi  # noqa: E402
from auxo_core import (R, DRY, AuxoError, del_kv, get_kv, log, warn, run, have, installed, online,  # noqa: E402
                       require_root, read_conf, write_conf, set_kv, write_file, chown, home_of, normal_users,
                       invoking_user, xbps_install, xbps_remove, repo_enable, regen_initramfs,
                       sv_enable, sv_disable, sv_enabled, SHARE, RESET, BOLD, DIM)
from auxo_desktops import DESKTOPS, LIVE_PLASMA, KERNELS, SHELLS, GUI_SERVICES  # noqa: E402
import auxo_theme  # noqa: E402
import auxo_gnome  # noqa: E402


def target_users(args):
    if getattr(args, "user", None):
        return [args.user]
    u = invoking_user()
    return [u] if u else normal_users()


def _rm(path):
    if os.path.lexists(R(path)):
        os.remove(R(path))
        return True
    return False


# ── accent ────────────────────────────────────────────────────────────
def cmd_accent(args):
    if not args.name:
        cur = auxo_theme.current()
        for name, (a, _) in ACCENTS.items():
            mark = "●" if name == cur else "○"
            print(f"  {ansi(a)}{mark} {name:<8} {a}{RESET}")
        return
    require_root()
    splash_changed = auxo_theme.apply_system(args.name, mkconfig=not args.no_grub)
    if splash_changed and read_conf().get("SPLASH") == "on" and not args.no_initramfs:
        log("boot splash colour changed → rebuilding initramfs")
        regen_initramfs()
    users = target_users(args)
    for u in users:
        auxo_theme.apply_user(u, args.name)
    # change the wallpaper/colours right now in any desktop the user is logged into.
    # sudo drops the session variables, so they're rebuilt from the user's running session.
    if not args.user:
        for u in users:
            env = auxo_theme.session_env(u)
            if env:
                run(["auxo-tweak", "session-apply", "--accent", args.name], check=False, user=u, env=env)


# ── hardware detection ────────────────────────────────────────────────
def gpu_info():
    """Return list of (vendor, device_id, description)."""
    if DRY and os.environ.get("AUXO_TEST_GPU"):
        # "10de:2684 NVIDIA RTX 4090" — lets the test-suite pretend to have a GPU
        v, rest = os.environ["AUXO_TEST_GPU"].split(":", 1)
        d, desc = (rest.split(" ", 1) + [""])[:2]
        return [(v, d, desc)]
    out = run(["lspci", "-nn"], capture=True, check=False) if have("lspci") and not DRY else ""
    gpus = []
    for line in (out or "").splitlines():
        if any(k in line for k in ("VGA compatible", "3D controller", "Display controller")):
            m = re.search(r"\[([0-9a-f]{4}):([0-9a-f]{4})\]", line)
            if m:
                gpus.append((m.group(1), m.group(2), line.split(": ", 1)[-1]))
    return gpus


def nvidia_branch():
    """Which Void NVIDIA package fits this GPU: 'nvidia' (Turing and newer, open kernel
    modules), 'nvidia580' (Maxwell, Pascal, Volta), 'nvidia470' (Kepler), 'nouveau'
    (older), or None when there's no NVIDIA GPU."""
    for vendor, dev, _ in gpu_info():
        if vendor == "10de":
            d = int(dev, 16)
            if d >= 0x1e00:
                return "nvidia"
            if d >= 0x1340:
                return "nvidia580"
            if d >= 0x0fc0:
                return "nvidia470"
            return "nouveau"
    return None


def detect_virt():
    """'oracle', 'kvm', 'vmware', 'microsoft' or '' (Void has no systemd-detect-virt)."""
    if DRY:
        return os.environ.get("AUXO_TEST_VIRT", "")
    txt = ""
    for f in ("/sys/class/dmi/id/sys_vendor", "/sys/class/dmi/id/product_name"):
        try:
            txt += open(f).read().lower()
        except OSError:
            pass
    for key, name in (("virtualbox", "oracle"), ("innotek", "oracle"), ("qemu", "kvm"),
                      ("kvm", "kvm"), ("vmware", "vmware"), ("microsoft", "microsoft")):
        if key in txt:
            return name
    return ""


# ── kernel ────────────────────────────────────────────────────────────
TEST_SERIES = {"linux": "linux6.18", "linux-lts": "linux6.12", "linux-mainline": "linux6.19"}


def kernel_series(meta):
    """'linux-lts' → 'linux6.12': the versioned package a Void kernel meta package pulls in."""
    if DRY:
        return TEST_SERIES.get(meta)
    out = run(["xbps-query", "-x", meta], capture=True, check=False) or ""
    for word in out.split():
        m = re.match(r"(linux\d+\.\d+)", word)
        if m:
            return m.group(1)
    return None


def kernel_version(series):
    """'linux6.12' → '6.12.111_1' (the name its /boot/vmlinuz-* file uses)."""
    if DRY:
        return series.replace("linux", "") + ".0_1"
    pkgver = (run(["xbps-query", "-p", "pkgver", series], capture=True, check=False) or "").strip()
    return pkgver.split("-", 1)[1] if "-" in pkgver else ""


def installed_kernels():
    return [k for k in KERNELS if installed(k)]


def cmd_kernel(args):
    require_root()
    k = args.name
    log(f"installing {k}")
    xbps_install(k)
    try:  # headers are only needed for DKMS modules (NVIDIA); don't fail the switch over them
        xbps_install(f"{k}-headers")
    except AuxoError as e:
        warn(f"{k}-headers could not be installed ({e}); DKMS modules may not build for {k}")
    series = kernel_series(k)
    ver = kernel_version(series) if series else ""
    vmlinuz = f"/boot/vmlinuz-{ver}"
    if not ver or not (DRY or os.path.exists(R(vmlinuz))):
        del_kv("/etc/default/grub", "GRUB_TOP_LEVEL")
        raise AuxoError(f"couldn't find the kernel image for {k}; GRUB left on the current kernel")
    if not DRY and not args.no_initramfs and not os.path.exists(R(f"/boot/initramfs-{ver}.img")):
        run(["xbps-reconfigure", "-f", series], check=False)  # runs dracut + the GRUB hook
    # the 49-auxo-default-kernel hook keeps this pointing at the newest build after updates
    set_kv("/etc/default/grub", "GRUB_TOP_LEVEL", vmlinuz)
    write_conf({"KERNEL": k})
    if not args.no_grub:
        auxo_theme.grub_mkconfig()
    log(f"{k} ({ver}) is now the default boot entry; other kernels stay under 'Advanced options'.")


# ── shell ─────────────────────────────────────────────────────────────
ZSHRC_TEMPLATE = "/usr/share/auxo/shell/zshrc"
FISHRC = """# ~/.config/fish/config.fish — Auxo defaults
set -g fish_greeting
source /usr/share/auxo/shell/prompt.fish
alias ll 'ls -lah'
alias update auxo-update
"""


def cmd_shell(args):
    require_root()
    path, pkgs = SHELLS[args.name]
    xbps_install(pkgs[0])          # the shell itself is required…
    try:                           # …completions/plugins are nice to have
        xbps_install(*pkgs[1:])
    except AuxoError as e:
        warn(f"optional {args.name} extras not installed: {e}")
    if not os.path.exists(R(path)) and not DRY:
        raise AuxoError(f"{path} is missing; login shell not changed")
    for u in target_users(args):
        run(["chsh", "-s", path, u])
        home = home_of(u)
        if args.name == "zsh":
            rc = R(f"{home}/.zshrc")
            current = open(rc).read() if os.path.exists(rc) else ""
            if args.force or "auxo/shell/prompt.zsh" not in current:
                if current.strip() and not os.path.exists(rc + ".auxo-bak"):
                    shutil.copy2(rc, rc + ".auxo-bak")
                write_file(f"{home}/.zshrc", open(R(ZSHRC_TEMPLATE)).read(), owner=u)
        if args.name == "bash":
            rc = R(f"{home}/.bashrc")
            line = "[[ $- == *i* ]] && source /usr/share/auxo/shell/prompt.bash  # auxo prompt\n"
            if not os.path.exists(rc) or "auxo/shell/prompt.bash" not in open(rc).read():
                os.makedirs(os.path.dirname(rc), exist_ok=True)
                with open(rc, "a") as f:
                    f.write("\n" + line)
                chown(f"{home}/.bashrc", u)
        if args.name == "fish" and not os.path.exists(R(f"{home}/.config/fish/config.fish")):
            write_file(f"{home}/.config/fish/config.fish", FISHRC, owner=u)
        log(f"{u}: login shell → {path}")


# ── desktop / rice ────────────────────────────────────────────────────
def apply_rice(name, user):
    src = R(f"{SHARE}/rices/{name}")
    if not os.path.isdir(src):
        raise AuxoError(f"no rice named {name}")
    home = home_of(user)
    dst = R(f"{home}/.config")
    if name == "hyprland":
        # Void's Hyprland reads hyprland.conf; park a Lua config from the Arch-based Auxo
        old = R(f"{home}/.config/hypr/hyprland.lua")
        if os.path.exists(old):
            os.replace(old, old + ".auxo-bak")
    for base, _dirs, files in os.walk(src):
        rel = os.path.relpath(base, src)
        for f in files:
            target = os.path.normpath(os.path.join(dst, rel, f))
            os.makedirs(os.path.dirname(target), exist_ok=True)
            if os.path.exists(target) and not os.path.exists(target + ".auxo-bak"):
                shutil.copy2(target, target + ".auxo-bak")
            shutil.copy2(os.path.join(base, f), target)
    for base, _dirs, files in os.walk(dst):  # scripts inside the rice must stay executable
        for f in files:
            if f.endswith(".sh"):
                os.chmod(os.path.join(base, f), 0o755)
    auxo_theme.apply_user(user, auxo_theme.current())
    chown(f"{home}/.config", user, recursive=True)
    log(f"{user}: Auxo {name} rice applied (old files kept as *.auxo-bak)")


DISPLAY_MANAGERS = ("sddm", "gdm", "lightdm", "greetd", "lxdm")


def set_display_manager(dm):
    for other in DISPLAY_MANAGERS:
        if other != dm and sv_enabled(other):
            sv_disable(other)
    if dm:
        sv_enable(dm)


def set_default_session(user, session, dm="greetd"):
    """greetd/tuigreet: pre-fill the username (the desktop comes from greetd's config).
    GDM: remember the session in AccountsService so GDM starts it without asking."""
    if not user:
        return
    if dm == "gdm":
        write_file(f"/var/lib/AccountsService/users/{user}", f"[User]\nSession={session}\nSystemAccount=false\n", mode=0o600)
        return
    write_file("/var/cache/tuigreet/lastuser", user + "\n")
    run(["chown", "-R", "_greeter:_greeter", "/var/cache/tuigreet"], check=False)


def add_repo(name, url):
    """Add a third-party xbps repository (its signing key is accepted on first sync)."""
    path = f"/etc/xbps.d/20-{name}.conf"
    if not os.path.exists(R(path)):
        write_file(path, f"# added by auxo-tweak\nrepository={url}\n")
        run(["xbps-install", "-Sy"], check=False)


def cmd_desktop(args):
    require_root()
    d = DESKTOPS[args.name]
    if d["packages"]:
        if not online() and not all(installed(p) for p in d["packages"]):
            raise AuxoError("no internet connection — connect first (nmtui) and try again")
        if d.get("repo"):
            log(f"{d['name']}: adding its community repository")
            add_repo(args.name, d["repo"])
        log(f"installing {d['name']}")
        xbps_install(*d["packages"])
        for sv in GUI_SERVICES:
            sv_enable(sv)
        for sv in ("dhcpcd", "wpa_supplicant"):  # NetworkManager manages the network now
            if sv_enabled(sv):
                sv_disable(sv)
    users = target_users(args)
    if d.get("rice"):
        for u in users:
            apply_rice(d["rice"], u)
    if args.name == "plasma":
        import auxo_kde
        auxo_kde.apply_system(auxo_theme.current())
    if args.name == "gnome":
        auxo_gnome.cleanup()
        for u in users:  # the installer already asked these questions: skip GNOME's first-login wizard
            write_file(f"{home_of(u)}/.config/gnome-initial-setup-done", "yes", owner=u)
    if args.replace and args.name != "plasma":
        keep = set(d["packages"])
        remove = [p for p in LIVE_PLASMA if p not in keep and (installed(p) or DRY)]
        if remove:
            log("removing the live Plasma desktop")
            if xbps_remove(*remove) != 0:
                for p in remove:  # something still needs one of them: remove what we can
                    xbps_remove(p)
    write_conf({"DESKTOP": args.name})
    set_display_manager(d["dm"])
    if d["dm"] == "greetd":
        auxo_theme.apply_login(auxo_theme.current())
    if users and d["dm"] in ("greetd", "gdm"):
        set_default_session(users[0], d["session"], d["dm"])
    log(f"desktop → {d['name']}. Reboot or log out to use it.")


def cmd_rice(args):
    require_root()
    if args.name == "kde":
        import auxo_kde
        accent = auxo_theme.current()
        auxo_kde.apply_system(accent)
        for u in target_users(args):
            env = None if args.user else auxo_theme.session_env(u)
            if env and "KDE" in env.get("XDG_CURRENT_DESKTOP", ""):
                auxo_kde.apply_user(u, accent)
                run(["plasma-apply-lookandfeel", "--apply", auxo_kde.LAF, "--resetLayout"], check=False, user=u, env=env)
            else:
                auxo_kde.apply_user(u, accent, reset_layout=True)
                log(f"{u}: the Auxo panel layout appears at the next Plasma login")
        return
    for u in target_users(args):
        apply_rice(args.name, u)


# ── snapshots ─────────────────────────────────────────────────────────
SNAPPER_CFG = """# snapper config for / — written by auxo-tweak
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS="wheel"
SYNC_ACL="yes"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="12"
NUMBER_LIMIT_IMPORTANT="6"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="4"
TIMELINE_LIMIT_DAILY="5"
TIMELINE_LIMIT_WEEKLY="2"
TIMELINE_LIMIT_MONTHLY="1"
TIMELINE_LIMIT_YEARLY="0"
"""


def root_fstype():
    if DRY:
        return os.environ.get("AUXO_TEST_FSTYPE", "btrfs")
    return run(["findmnt", "-no", "FSTYPE", "/"], capture=True, check=False).strip()


def cmd_snapshots(args):
    if args.state == "status":
        cfg = os.path.exists(R("/etc/snapper/configs/root"))
        print(f"root filesystem : {root_fstype()}")
        print(f"snapper         : {'configured' if cfg else 'off'}")
        print(f"bootable menu   : {'on' if sv_enabled('grub-btrfs') else 'off'}")
        if cfg and have("snapper") and not DRY:
            run(["snapper", "-c", "root", "list", "--columns", "number,date,description"], check=False)
        return
    require_root()
    if args.state == "off":
        for sv in ("grub-btrfs", "snapperd"):
            sv_disable(sv, now=True)
        set_kv("/etc/conf.d/snapper", "SNAPPER_CONFIGS", "")
        write_conf({"SNAPSHOTS": "off"})
        log("automatic snapshots disabled (existing ones are kept)")
        return
    if root_fstype() != "btrfs":
        raise AuxoError("snapshots need a btrfs root filesystem (choose btrfs in the installer)")
    xbps_install("snapper", "grub-btrfs", "inotify-tools", "cronie")
    write_file("/etc/snapper/configs/root", SNAPPER_CFG, mode=0o640)
    set_kv("/etc/conf.d/snapper", "SNAPPER_CONFIGS", "root")
    os.makedirs(R("/.snapshots"), exist_ok=True)
    if not DRY:
        os.chmod(R("/.snapshots"), 0o750)
        # the installer mounts @snapshots at /.snapshots; if not, make it a subvolume
        if subprocess.run(["mountpoint", "-q", "/.snapshots"]).returncode != 0 and not os.listdir("/.snapshots"):
            os.rmdir("/.snapshots")
            run(["btrfs", "subvolume", "create", "/.snapshots"], check=False)
    # snapper's hourly timeline + cleanup run from cron; grub-btrfs watches for new snapshots
    for sv in ("cronie", "grub-btrfs"):
        sv_enable(sv, now=not args.no_now)
    run(["snapper", "--no-dbus", "-c", "root", "create", "-d", args.description or "auxo-tweak: snapshots enabled"], check=False)
    write_conf({"SNAPSHOTS": "on"})
    if not args.no_grub:
        auxo_theme.grub_mkconfig()
    log("snapshots on: auxo-update snapshots before every update, hourly snapshots are kept for a day, "
        "and all of them are bootable from GRUB → 'Auxo snapshots'")


# ── repos / drivers ───────────────────────────────────────────────────
def cmd_repo(args):
    require_root()
    names = {"nonfree": ["nonfree"], "multilib": ["multilib", "multilib-nonfree"]}[args.name]
    repo_enable(*names)
    log(f"Void {args.name} repository enabled")


def nvidia_on(branch=None):
    """Install the right proprietary NVIDIA driver (from Void's nonfree repo)."""
    branch = branch or nvidia_branch()
    if branch in (None, "nouveau"):
        raise AuxoError("no NVIDIA GPU the proprietary driver supports; nouveau is used")
    repo_enable("nonfree")
    kernels = installed_kernels() or ["linux"]
    # DKMS builds the module for every kernel that has its headers installed
    xbps_install(branch, *[f"{k}-headers" for k in kernels])
    for other in ("nvidia", "nvidia580", "nvidia470"):
        if other != branch and installed(other):
            xbps_remove(other)
    write_file("/etc/modprobe.d/auxo-nvidia.conf",
               "# written by auxo-tweak\noptions nvidia_drm modeset=1 fbdev=1\n")
    if installed("void-repo-multilib"):
        repo_enable("multilib-nonfree")
        try:
            xbps_install(f"{branch}-libs-32bit")
        except AuxoError:
            warn("32-bit NVIDIA libraries not installed (needed by Steam/Wine)")
    write_conf({"NVIDIA": branch})


def cmd_drivers(args):
    require_root()
    gpus = gpu_info()
    if not gpus:
        warn("no GPU found via lspci")
    for _v, _d, desc in gpus:
        print(f"  {DIM}found{RESET} {desc}")
    vendors = {v for v, _, _ in gpus}
    intel_cpu = DRY or "GenuineIntel" in open("/proc/cpuinfo").read()
    xbps_install("mesa-dri", "vulkan-loader")
    if intel_cpu:
        repo_enable("nonfree")  # Intel CPU microcode lives in nonfree (AMD's ships with linux-firmware)
        xbps_install("intel-ucode")
    if "1002" in vendors:
        xbps_install("mesa-vulkan-radeon", "mesa-vaapi", "libva-utils")
    if "8086" in vendors:
        xbps_install("mesa-vulkan-intel", "intel-video-accel")
    branch = nvidia_branch()
    if branch and branch != "nouveau":
        log(f"NVIDIA GPU → {branch}")
        nvidia_on(branch)
    elif branch == "nouveau":
        warn("this NVIDIA GPU is too old for the proprietary drivers; using nouveau (open source)")
    if args.prune:
        nv = [p for p in ("nvidia", "nvidia580", "nvidia470") if installed(p)]
        if branch in (None, "nouveau") and nv:
            log("no supported NVIDIA GPU → removing NVIDIA packages")
            xbps_remove(*nv)
        if "1002" not in vendors:
            xbps_remove(*[p for p in ("mesa-vulkan-radeon",) if installed(p)])
        if "8086" not in vendors:
            xbps_remove(*[p for p in ("mesa-vulkan-intel", "intel-video-accel") if installed(p)])
        # VM guest tools: keep only the ones for the hypervisor we're running on
        virt = detect_virt()
        tools = {"oracle": [("virtualbox-ose-guest", "vboxservice")],
                 "kvm": [("qemu-ga", "qemu-ga"), ("spice-vdagent", "spice-vdagentd")],
                 "vmware": [("open-vm-tools", "vmtoolsd")]}
        for v, pairs in tools.items():
            for pkg, sv in pairs:
                if v == virt:
                    if installed(pkg) or DRY:
                        sv_enable(sv)
                elif installed(pkg):
                    sv_disable(sv)
                    xbps_remove(pkg)
    if branch not in (None, "nouveau") and not args.no_initramfs:
        regen_initramfs()
    write_conf({"GPU": ",".join(sorted(vendors)) or "none"})
    log("drivers done")


PRIME_RUN = """#!/bin/sh
# prime-run — run a program on the NVIDIA GPU of a hybrid laptop (written by auxo-tweak)
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
"""


def cmd_nvidia(args):
    branch = nvidia_branch()
    if args.state == "status":
        gpus = [g for g in gpu_info() if g[0] == "10de"]
        print(f"  GPU         {gpus[0][2] if gpus else 'no NVIDIA GPU'}")
        print(f"  fits        {branch or '-'}")
        have_pkg = [p for p in ('nvidia', 'nvidia580', 'nvidia470') if installed(p)]
        print(f"  installed   {', '.join(have_pkg) or 'none (nouveau)'}")
        print(f"  modeset     {'on' if os.path.exists(R('/etc/modprobe.d/auxo-nvidia.conf')) else 'off'}")
        print(f"  prime-run   {'yes' if os.path.exists(R('/usr/local/bin/prime-run')) else 'no'}")
        return
    require_root()
    if args.state == "on":
        nvidia_on(branch)
        regen_initramfs()
        log(f"NVIDIA {branch} installed — reboot to use it")
    elif args.state == "off":
        xbps_remove(*[p for p in ("nvidia", "nvidia580", "nvidia470") if installed(p)])
        _rm("/etc/modprobe.d/auxo-nvidia.conf")
        write_conf({"NVIDIA": "nouveau"})
        regen_initramfs()
        log("back to nouveau (open source) — reboot to use it")
    elif args.state == "prime":
        write_file("/usr/local/bin/prime-run", PRIME_RUN, mode=0o755)
        log("prime-run installed: run 'prime-run <program>' to use the NVIDIA GPU "
            "(Steam: prime-run %command%)")


# ── performance ───────────────────────────────────────────────────────
SCHEDULERS = {
    "lavd": "latency-aware, made for gaming",
    "bpfland": "keeps the desktop responsive under load",
    "flash": "low latency, fair",
    "cosmos": "lightweight general-purpose",
    "rusty": "multi-domain, good for many-core CPUs",
}
SCX_MODES = {"auto": "Auto", "gaming": "Gaming", "lowlatency": "LowLatency", "powersave": "PowerSave", "server": "Server"}
SCX_CONF = "/etc/scx_loader.toml"


def cmd_scheduler(args):
    name = args.name
    if name == "list":
        for s, d in SCHEDULERS.items():
            print(f"  {s:<9} {d}")
        print(f"  {DIM}modes: {', '.join(SCX_MODES)}{RESET}")
        return
    if name == "status":
        cur = get_kv(SCX_CONF, "default_sched", "-") if os.path.exists(R(SCX_CONF)) else "-"
        print(f"  scheduler   {cur if sv_enabled('scx-loader') else 'kernel default (EEVDF)'}")
        print(f"  kernel      {'sched_ext supported' if os.path.isdir('/sys/kernel/sched_ext') or DRY else 'no sched_ext support'}")
        return
    require_root()
    if name == "off":
        sv_disable("scx-loader", now=True)
        write_conf({"SCHEDULER": "default"})
        log("back to the kernel's default scheduler")
        return
    if name not in SCHEDULERS:
        raise AuxoError(f"unknown scheduler {name}; choose {', '.join(SCHEDULERS)}")
    if not (DRY or os.path.isdir("/sys/kernel/sched_ext")):
        warn("this kernel has no sched_ext support; the scheduler starts once you boot a kernel that does")
    xbps_install("scx", "scx-loader")
    mode = SCX_MODES[args.mode]
    write_file(SCX_CONF, f'# written by auxo-tweak scheduler\ndefault_sched = "scx_{name}"\ndefault_mode = "{mode}"\n')
    sv_enable("dbus")
    sv_enable("scx-loader", now=True)
    if not DRY and have("scxctl"):
        run(["scxctl", "switch", "-s", name, "-m", args.mode], check=False)
    write_conf({"SCHEDULER": f"{name}/{args.mode}"})
    log(f"CPU scheduler → scx_{name} ({mode}), also after reboot")


def cmd_power(args):
    require_root()
    xbps_install("power-profiles-daemon")
    sv_enable("dbus")
    sv_enable("power-profiles-daemon", now=True)
    if not DRY:
        run(["powerprofilesctl", "set", args.profile], check=False)
    write_conf({"POWER": args.profile})
    log(f"power profile → {args.profile}")


# ── network ───────────────────────────────────────────────────────────
def cmd_firewall(args):
    if args.state == "status":
        print(f"  firewall    {'on' if sv_enabled('ufw') else 'off'}")
        if have("ufw") and not DRY and os.geteuid() == 0:
            run(["ufw", "status", "verbose"], check=False)
        return
    require_root()
    if args.state == "on":
        xbps_install("ufw")
        run(["ufw", "default", "deny", "incoming"], check=False)
        run(["ufw", "default", "allow", "outgoing"], check=False)
        sv_enable("ufw", now=True)
        run(["ufw", "--force", "enable"], check=False)
        log("firewall on: incoming connections blocked, outgoing allowed (open a port: sudo ufw allow 22/tcp)")
    else:
        run(["ufw", "--force", "disable"], check=False)
        sv_disable("ufw", now=True)
        log("firewall off")
    write_conf({"FIREWALL": args.state})


DNS = {
    "cloudflare": ["1.1.1.1", "1.0.0.1", "2606:4700:4700::1111"],
    "quad9": ["9.9.9.9", "149.112.112.112", "2620:fe::fe"],
    "google": ["8.8.8.8", "8.8.4.4", "2001:4860:4860::8888"],
}
NM_DNS = "/etc/NetworkManager/conf.d/50-auxo-dns.conf"


def cmd_dns(args):
    require_root()
    if args.provider == "auto":
        _rm(NM_DNS)
        log("DNS → automatic (from your network)")
    else:
        servers = DNS[args.provider]
        write_file(NM_DNS, "# written by auxo-tweak dns\n[global-dns-domain-*]\nservers=" + ",".join(servers) + "\n")
        log(f"DNS → {args.provider} ({', '.join(servers)}) for every connection")
    if not DRY and have("nmcli"):
        run(["nmcli", "general", "reload"], check=False)
    write_conf({"DNS": args.provider})


# ── housekeeping ──────────────────────────────────────────────────────
def _du(path):
    if DRY or not os.path.isdir(path):
        return 0
    out = run(["du", "-sb", path], capture=True, check=False) or "0"
    return int(out.split()[0] or 0)


def cmd_cleanup(args):
    require_root()
    before = _du("/var/cache/xbps")
    log("removing cached packages and orphaned dependencies")
    run(["xbps-remove", "-Ooy"], check=False)
    log("removing old kernels (the running one is always kept)")
    run(["vkpurge", "rm", "all"], check=False)
    if args.user_cache:
        for u in target_users(args):
            thumbs = R(f"{home_of(u)}/.cache/thumbnails")
            if os.path.isdir(thumbs):
                shutil.rmtree(thumbs, ignore_errors=True)
                log(f"{u}: thumbnail cache cleared")
    if have("flatpak") and not DRY:
        run(["flatpak", "uninstall", "--unused", "-y"], check=False)
    freed = max(0, before - _du("/var/cache/xbps"))
    log(f"cleanup done{f' — freed {freed / 1e6:.0f} MB of package cache' if freed else ''}")


def cmd_flatpak(args):
    if args.state == "status":
        print(f"  flatpak     {'installed' if installed('flatpak') else 'not installed'}")
        if have("flatpak") and not DRY:
            run(["flatpak", "remotes"], check=False)
        return
    require_root()
    xbps_install("flatpak")
    run(["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], check=False)
    write_conf({"FLATPAK": "on"})
    log("Flatpak + Flathub ready (log out and back in so apps show up in your menu)")


def cmd_mirrors(args):
    require_root()
    xbps_install("xmirror")
    if args.url:
        run(["xmirror", "-s", args.url])
    elif args.default:
        run(["xmirror", "-d"])
    else:
        run(["xmirror"])  # interactive list of Void mirrors
    log("mirror updated")


def cmd_zram(args):
    require_root()
    if args.state == "on":
        xbps_install("zramen")
        write_file("/etc/sv/zramen/conf",
                   "# written by auxo-tweak zram\nexport ZRAM_COMP_ALGORITHM=zstd\nexport ZRAM_SIZE=50\n"
                   "export ZRAM_MAX_SIZE=8192\nexport ZRAM_PRIORITY=100\n")
        write_file("/etc/sysctl.d/99-auxo-zram.conf",
                   "vm.swappiness = 180\nvm.watermark_boost_factor = 0\nvm.watermark_scale_factor = 125\nvm.page-cluster = 0\n")
        sv_enable("zramen", now=True)
    else:
        sv_disable("zramen", now=True)
        _rm("/etc/sysctl.d/99-auxo-zram.conf")
    write_conf({"ZRAM": args.state})
    log(f"zram {args.state}")


SERVICES = {
    "bluetooth": (["bluez"], ["bluetoothd"]),
    "cups": (["cups", "cups-filters", "system-config-printer"], ["cupsd"]),
    "sshd": (["openssh"], ["sshd"]),
    "power-profiles": (["power-profiles-daemon"], ["power-profiles-daemon"]),
}


def cmd_service(args):
    require_root()
    pkgs, svs = SERVICES[args.name]
    if args.state == "on":
        xbps_install(*pkgs)
        for sv in svs:
            sv_enable(sv, now=True)
    else:
        for sv in svs:
            sv_disable(sv, now=True)
    log(f"{args.name} {args.state}")


def cmd_info(args):
    c = read_conf()
    acc = auxo_theme.current()
    print(f"{BOLD}Auxo settings{RESET}")
    for k in ("ACCENT", "DESKTOP", "KERNEL", "NVIDIA", "SCHEDULER", "POWER", "FIREWALL", "DNS",
              "SNAPSHOTS", "ZRAM", "GPU"):
        v = c.get(k, "-")
        if k == "ACCENT":
            v = f"{ansi(ACCENTS[acc][0])}{acc}{RESET}"
        print(f"  {k.lower():<10} {v}")


def cmd_session_apply(args):
    auxo_theme.session_apply(args.accent, once=args.once)


# ── boot splash (Plymouth, built into the initramfs by dracut) ─────────
DRACUT_SPLASH = "/etc/dracut.conf.d/auxo-splash.conf"


def _cmdline(add=(), remove=()):
    """Edit GRUB_CMDLINE_LINUX_DEFAULT; returns True if it changed."""
    if not os.path.exists(R("/etc/default/grub")):
        return False
    old = get_kv("/etc/default/grub", "GRUB_CMDLINE_LINUX_DEFAULT", "")
    words = [w for w in old.split() if w not in remove]
    words += [w for w in add if w not in words]
    new = " ".join(words)
    if new != old:
        set_kv("/etc/default/grub", "GRUB_CMDLINE_LINUX_DEFAULT", new)
        return True
    return False


def cmd_splash(args):
    conf = read_conf()
    if args.state == "status":
        print(f"  splash      {conf.get('SPLASH', 'off')}")
        print(f"  plymouth    {'installed' if installed('plymouth') else 'not installed'}")
        print(f"  initramfs   {'plymouth included' if os.path.exists(R(DRACUT_SPLASH)) else 'no plymouth'}")
        return
    require_root()
    rebuild = regrub = False
    if args.state == "on":
        xbps_install("plymouth")
        rebuild |= auxo_theme.apply_splash(auxo_theme.current())
        write_file("/etc/plymouth/plymouthd.conf",
                   "# written by auxo-tweak splash\n[Daemon]\nTheme=auxo\nShowDelay=0\nDeviceTimeout=8\n")
        if not os.path.exists(R(DRACUT_SPLASH)):
            write_file(DRACUT_SPLASH, '# written by auxo-tweak splash\nadd_dracutmodules+=" plymouth "\n')
            rebuild = True
        regrub |= _cmdline(add=("quiet", "splash"))
    else:
        rebuild |= _rm(DRACUT_SPLASH)
        regrub |= _cmdline(remove=("splash",))
    write_conf({"SPLASH": args.state})
    if rebuild and not args.no_initramfs:
        regen_initramfs()
    if regrub and not args.no_grub and have("grub-mkconfig") and os.path.exists(R("/boot/grub")):
        auxo_theme.grub_mkconfig()
    log(f"boot splash {args.state}" + (" (takes effect on next boot)" if args.state == "on" else ""))


# ── gaming ────────────────────────────────────────────────────────────
GAMING_SYSCTL = "/etc/sysctl.d/80-auxo-gaming.conf"
GAMING_MODULES = "/etc/modules-load.d/auxo-gaming.conf"
GAMING_PKGS = ["gamemode", "MangoHud", "gamescope"]
# Steam's 32-bit dependencies, from Void's Steam documentation
STEAM_PKGS = ["steam", "libgcc-32bit", "libstdc++-32bit", "libdrm-32bit", "libglvnd-32bit", "mesa-dri-32bit"]


def cmd_gaming(args):
    conf = read_conf()
    if args.state == "status":
        print(f"  gaming      {conf.get('GAMING', 'off')}")
        for p in GAMING_PKGS + ["steam"]:
            print(f"  {p:<14}{'installed' if installed(p) else '-'}")
        print(f"  tweaks      {'on' if os.path.exists(R(GAMING_SYSCTL)) else 'off'}")
        return
    require_root()
    if args.state == "on":
        repo_enable("nonfree", "multilib", "multilib-nonfree")
        pkgs = list(GAMING_PKGS) + ([] if args.no_steam else STEAM_PKGS)
        vendors = {v for v, _, _ in gpu_info()}
        if "1002" in vendors:
            pkgs += ["mesa-vulkan-radeon", "mesa-vulkan-radeon-32bit"]
        if "8086" in vendors:
            pkgs += ["mesa-vulkan-intel", "mesa-vulkan-intel-32bit"]
        branch = nvidia_branch()
        if branch in ("nvidia", "nvidia580", "nvidia470") and installed(branch):
            pkgs += [f"{branch}-libs-32bit"]
        xbps_install(*pkgs)
        write_file(GAMING_SYSCTL,
                   "# written by auxo-tweak gaming — remove with: auxo-tweak gaming off\n"
                   "# more memory maps for games that need them (same value as SteamOS)\n"
                   "vm.max_map_count = 2147483642\n"
                   "# don't slow down games that trigger split-lock detection\n"
                   "kernel.split_lock_mitigate = 0\n")
        # ntsync: kernel-side Windows sync primitives, used by Wine / Proton for smoother frame pacing
        write_file(GAMING_MODULES, "# written by auxo-tweak gaming\nntsync\n")
        run(["sysctl", "--system"], check=False)
        run(["modprobe", "ntsync"], check=False)
        write_conf({"GAMING": "on"})
        log("gaming on")
        print(f"   {DIM}Steam launch options:{RESET}  gamemoderun mangohud %command%")
        print(f"   {DIM}Gaming CPU scheduler:{RESET}  auxo-tweak scheduler lavd --mode gaming")
        print(f"   {DIM}Proton-GE:{RESET}             auxo-tweak flatpak on && flatpak install flathub net.davidotek.pupgui2")
    else:
        for p in (GAMING_SYSCTL, GAMING_MODULES):
            _rm(p)
        run(["sysctl", "--system"], check=False)
        if args.purge:
            xbps_remove(*[p for p in GAMING_PKGS if installed(p)])
        write_conf({"GAMING": "off"})
        log("gaming off" + ("" if args.purge else " (tweaks removed; games and tools kept — use --purge to remove GameMode/MangoHud/gamescope)"))


# ── interactive menu (whiptail, from the newt package) ─────────────────
def wt(*a):
    r = subprocess.run(["whiptail", "--title", "auxo-tweak", *a], stderr=subprocess.PIPE, text=True)
    return r.stderr.strip() if r.returncode == 0 else None


def menu():
    if not have("whiptail"):
        print(__doc__)
        return
    me = [sys.executable, os.path.abspath(__file__)]
    while True:
        choice = wt("--menu", "Climb your own setup — pick something to change", "24", "72", "17",
                    "accent", "Accent colour", "desktop", "Desktop / window manager", "kernel", "Kernel",
                    "shell", "Login shell", "drivers", "GPU drivers", "nvidia", "NVIDIA driver",
                    "scheduler", "CPU scheduler (sched-ext)", "power", "Power profile",
                    "firewall", "Firewall", "dns", "DNS servers", "snapshots", "Btrfs snapshots",
                    "gaming", "Gaming mode", "flatpak", "Flatpak + Flathub", "cleanup", "Free up disk space",
                    "mirrors", "Faster mirror", "update", "Update everything (auxo-update)", "quit", "Exit")
        if choice in (None, "quit"):
            return
        cmd = None
        pick = {
            "accent": ("Accent colour", [[n, a] for n, (a, _) in ACCENTS.items()]),
            "desktop": ("Desktop", [[k, d["name"]] for k, d in DESKTOPS.items()]),
            "kernel": ("Kernel", [[k, d] for k, d in KERNELS.items()]),
            "shell": ("Shell", [["zsh", ""], ["fish", ""], ["bash", ""]]),
            "nvidia": ("NVIDIA", [["status", "show"], ["on", "install the right driver"],
                                  ["off", "back to nouveau"], ["prime", "laptop GPU offload"]]),
            "scheduler": ("CPU scheduler", [[k, v] for k, v in SCHEDULERS.items()] + [["off", "kernel default"], ["status", ""]]),
            "power": ("Power profile", [["balanced", ""], ["performance", ""], ["power-saver", ""]]),
            "firewall": ("Firewall", [["on", ""], ["off", ""], ["status", ""]]),
            "dns": ("DNS", [[k, ", ".join(v[:2])] for k, v in DNS.items()] + [["auto", "from your network"]]),
            "snapshots": ("Snapshots", [["on", "enable"], ["off", "disable"], ["status", "show"]]),
            "gaming": ("Gaming mode", [["on", ""], ["off", ""], ["status", ""]]),
            "flatpak": ("Flatpak", [["on", ""], ["status", ""]]),
        }
        if choice in pick:
            title, items = pick[choice]
            v = wt("--menu", title, "20", "64", str(min(len(items), 10)), *sum(items, []))
            cmd = [choice, v] if v else None
        elif choice == "update":
            subprocess.run(["auxo-update"])
            continue
        else:
            cmd = [choice]
        if cmd:
            subprocess.run(["sudo", *me, *cmd] if os.geteuid() != 0 else [*me, *cmd])
            input(f"\n{DIM}press Enter to go back{RESET}")


def main():
    p = argparse.ArgumentParser(prog="auxo-tweak", description="Change your Auxo system without reinstalling.")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("accent"); s.add_argument("name", nargs="?", choices=list(ACCENTS))
    s.add_argument("--user"); s.add_argument("--no-grub", action="store_true")
    s.add_argument("--no-initramfs", action="store_true"); s.set_defaults(fn=cmd_accent)
    s = sub.add_parser("kernel"); s.add_argument("name", choices=list(KERNELS))
    s.add_argument("--no-grub", action="store_true"); s.add_argument("--no-initramfs", action="store_true")
    s.set_defaults(fn=cmd_kernel)
    s = sub.add_parser("shell"); s.add_argument("name", choices=list(SHELLS)); s.add_argument("--user")
    s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_shell)
    s = sub.add_parser("desktop"); s.add_argument("name", choices=list(DESKTOPS)); s.add_argument("--user")
    s.add_argument("--replace", action="store_true", help="remove the live Plasma desktop"); s.set_defaults(fn=cmd_desktop)
    s = sub.add_parser("rice"); s.add_argument("name", choices=["hyprland", "sway", "i3", "kde"]); s.add_argument("--user")
    s.set_defaults(fn=cmd_rice)
    s = sub.add_parser("snapshots"); s.add_argument("state", choices=["on", "off", "status"])
    s.add_argument("--no-grub", action="store_true"); s.add_argument("--no-now", action="store_true")
    s.add_argument("--description"); s.set_defaults(fn=cmd_snapshots)
    s = sub.add_parser("drivers"); s.add_argument("--no-initramfs", action="store_true")
    s.add_argument("--prune", action="store_true", help="remove drivers for hardware that isn't present")
    s.set_defaults(fn=cmd_drivers)
    s = sub.add_parser("nvidia"); s.add_argument("state", choices=["status", "on", "off", "prime"]); s.set_defaults(fn=cmd_nvidia)
    s = sub.add_parser("scheduler"); s.add_argument("name", choices=list(SCHEDULERS) + ["list", "status", "off"])
    s.add_argument("--mode", choices=list(SCX_MODES), default="auto"); s.set_defaults(fn=cmd_scheduler)
    s = sub.add_parser("power"); s.add_argument("profile", choices=["balanced", "performance", "power-saver"])
    s.set_defaults(fn=cmd_power)
    s = sub.add_parser("firewall"); s.add_argument("state", choices=["on", "off", "status"]); s.set_defaults(fn=cmd_firewall)
    s = sub.add_parser("dns"); s.add_argument("provider", choices=list(DNS) + ["auto"]); s.set_defaults(fn=cmd_dns)
    s = sub.add_parser("cleanup"); s.add_argument("--user"); s.add_argument("--user-cache", action="store_true",
                                                                         help="also clear your thumbnail cache")
    s.set_defaults(fn=cmd_cleanup)
    s = sub.add_parser("flatpak"); s.add_argument("state", choices=["on", "status"]); s.set_defaults(fn=cmd_flatpak)
    s = sub.add_parser("mirrors"); s.add_argument("--url"); s.add_argument("--default", action="store_true")
    s.set_defaults(fn=cmd_mirrors)
    s = sub.add_parser("zram"); s.add_argument("state", choices=["on", "off"]); s.set_defaults(fn=cmd_zram)
    s = sub.add_parser("repo"); s.add_argument("name", choices=["nonfree", "multilib"]); s.set_defaults(fn=cmd_repo)
    s = sub.add_parser("splash"); s.add_argument("state", choices=["on", "off", "status"])
    s.add_argument("--no-initramfs", action="store_true"); s.add_argument("--no-grub", action="store_true")
    s.set_defaults(fn=cmd_splash)
    s = sub.add_parser("gaming"); s.add_argument("state", choices=["on", "off", "status"]); s.add_argument("--user")
    s.add_argument("--no-steam", action="store_true"); s.add_argument("--purge", action="store_true")
    s.set_defaults(fn=cmd_gaming)
    s = sub.add_parser("service"); s.add_argument("name", choices=list(SERVICES)); s.add_argument("state", choices=["on", "off"])
    s.set_defaults(fn=cmd_service)
    s = sub.add_parser("info"); s.set_defaults(fn=cmd_info)
    s = sub.add_parser("session-apply"); s.add_argument("--accent", choices=list(ACCENTS)); s.add_argument("--once", action="store_true")
    s.set_defaults(fn=cmd_session_apply)

    args = p.parse_args()
    if not args.cmd:
        menu()
        return
    try:
        args.fn(args)
    except AuxoError as e:
        warn(str(e))
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
