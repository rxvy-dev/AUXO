#!/usr/bin/env python3
"""auxo-fetch — a fast system summary in your Auxo accent colour.

  auxo-fetch                 the full summary, with the Auxo peak
  auxo-fetch --small         a short one (fits a new terminal's first line or two)
  auxo-fetch --no-logo       just the information
  auxo-fetch --json          everything as JSON (for scripts and bars)
  auxo-fetch --accent cyan   try another accent

Slow lookups (packages, GPU, displays) run side by side, so it stays quick. Plain text when
the output isn't a terminal, or with NO_COLOR set.
"""
import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.environ.get("AUXO_LIB", "/usr/lib/auxo"))
from auxo_accents import ACCENTS, DEFAULT, hex_to_rgb  # noqa: E402

# the Auxo peak, as on the boot screen (console-safe block characters)
LOGO = [
    "        ▄██▄        ",
    "       ▄████▄       ",
    "      ▄██▀▀██▄      ",
    "     ▄██▀  ▀██▄     ",
    "    ▄██▀ ▄▄ ▀██▄    ",
    "   ▄██▀ ▄██▄ ▀██▄   ",
    "  ▄██▀ ▄█▀▀█▄ ▀██▄  ",
    " ▄██▀ ▄█▀  ▀█▄ ▀██▄ ",
    " ▀▀▀▀ ▀▀▀    ▀▀▀ ▀▀▀▀",
]
SMALL = [" ▄█▄ ", "▄█▀█▄", "▀▀ ▀▀"]
STYLE_NAMES = {"hyprland": "Auxo", "hyprland-mac": "Mac", "hyprland-win": "Windows", "hyprland-neon": "Neon",
               "hyprland-zen": "Zen", "hyprland-candy": "Candy"}
ROOT = os.environ.get("AUXO_ROOT", "/")


def R(p):
    return os.path.join(ROOT, p.lstrip("/"))


def read_kv(path):
    d = {}
    try:
        for line in open(R(path)):
            k, sep, v = line.strip().partition("=")
            if sep and not k.startswith("#"):
                d[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return d


def sh(cmd, timeout=3):
    try:
        return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=timeout).stdout.strip()
    except Exception:
        return ""


# ── what we show ──────────────────────────────────────────────────────
def os_name():
    d = read_kv("/etc/os-release")
    name = d.get("PRETTY_NAME", "Linux")
    if d.get("ID") == "auxo" and d.get("VERSION"):
        name = f"{d.get('NAME', 'Auxo Linux')} {d['VERSION']}"
    return name


def uptime():
    try:
        s = int(float(open(R("/proc/uptime")).read().split()[0]))
    except OSError:
        return "?"
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    return " ".join(p for p in (f"{d}d" if d else "", f"{h}h" if h else "", f"{s // 60}m") if p)


def packages():
    parts = []
    if shutil.which("xbps-query"):
        n = sum(1 for line in sh(["xbps-query", "-l"]).splitlines() if line.strip())
        if n:
            parts.append(f"{n} xbps")
    if shutil.which("flatpak"):
        n = sum(1 for line in sh(["flatpak", "list", "--app", "--columns=application"]).splitlines() if line.strip())
        if n:
            parts.append(f"{n} flatpak")
    return " · ".join(parts) or "?"


def cpu():
    try:
        for line in open(R("/proc/cpuinfo")):
            if line.startswith("model name"):
                name = re.sub(r"\s+", " ", line.split(":", 1)[1]).strip()
                name = re.sub(r"\((R|TM)\)|CPU|@.*|\d+-Core Processor|Processor|with Radeon.*", "", name).strip()
                return f"{re.sub(r'  +', ' ', name)} ×{os.cpu_count()}"
    except OSError:
        pass
    return platform.processor() or "?"


def cpu_temp():
    """Package temperature in °C from hwmon (k10temp / coretemp / zenpower), or None."""
    base = R("/sys/class/hwmon")
    try:
        for h in sorted(os.listdir(base)):
            name = open(f"{base}/{h}/name").read().strip()
            if name in ("k10temp", "coretemp", "zenpower", "cpu_thermal"):
                return int(open(f"{base}/{h}/temp1_input").read()) // 1000
    except (OSError, ValueError):
        pass
    return None


def gpus():
    out = sh(["lspci", "-k"])
    res, cur = [], None
    for line in out.splitlines():
        if not line.startswith(("\t", " ")):
            cur = None
            if any(k in line for k in ("VGA", "3D controller", "Display controller")):
                g = line.split(": ", 1)[-1]
                m = re.search(r"\[(GeForce[^\]]*|Radeon[^\]]*|RTX[^\]]*|GTX[^\]]*|Arc[^\]]*)\]", g)
                g = (("NVIDIA " if "NVIDIA" in g else "AMD " if "AMD" in g or "ATI" in g else "") + m.group(1)) if m \
                    else re.sub(r"Corporation|Integrated Graphics Controller|\(rev.*\)", "", g).strip()
                res.append([re.sub(r"  +", " ", g), ""])
                cur = res[-1]
        elif cur is not None and "Kernel driver in use:" in line:
            cur[1] = line.split(":", 1)[1].strip()
    return [f"{g} ({d})" if d else g for g, d in res] or ["?"]


def displays():
    """['2560×1440 @ 165 Hz'] from Hyprland or Sway, else the kernel's DRM modes."""
    out = []
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        try:
            for m in json.loads(sh(["hyprctl", "monitors", "-j"]) or "[]"):
                out.append(f"{m['width']}×{m['height']} @ {round(m.get('refreshRate', 0))} Hz")
        except ValueError:
            pass
    elif os.environ.get("SWAYSOCK") and shutil.which("swaymsg"):
        try:
            for m in json.loads(sh(["swaymsg", "-t", "get_outputs", "-r"]) or "[]"):
                cm = m.get("current_mode") or {}
                if cm:
                    out.append(f"{cm['width']}×{cm['height']} @ {round(cm.get('refresh', 0) / 1000)} Hz")
        except ValueError:
            pass
    if not out:
        base = R("/sys/class/drm")
        try:
            for c in sorted(os.listdir(base)):
                p = f"{base}/{c}"
                if os.path.exists(f"{p}/status") and open(f"{p}/status").read().strip() == "connected":
                    modes = open(f"{p}/modes").read().split()
                    if modes:
                        out.append(modes[0].replace("x", "×"))
        except OSError:
            pass
    return out


def memory():
    try:
        m = {line.split(":")[0]: int(line.split()[1]) for line in open(R("/proc/meminfo"))}
        return (m["MemTotal"] - m["MemAvailable"]) / 1048576, m["MemTotal"] / 1048576, \
            (m.get("SwapTotal", 0) - m.get("SwapFree", 0)) / 1048576, m.get("SwapTotal", 0) / 1048576
    except Exception:
        return 0, 0, 0, 0


def disk():
    try:
        st = os.statvfs(R("/"))
        total = st.f_blocks * st.f_frsize / 1e9
        return total - st.f_bavail * st.f_frsize / 1e9, total, sh(["findmnt", "-no", "FSTYPE", "/"]) or "?"
    except OSError:
        return 0, 0, "?"


def battery():
    base = R("/sys/class/power_supply")
    try:
        for b in sorted(os.listdir(base)):
            if b.startswith("BAT"):
                cap = open(f"{base}/{b}/capacity").read().strip()
                status = open(f"{base}/{b}/status").read().strip().lower()
                return f"{cap}% ({status})"
    except OSError:
        pass
    return None


def desktop(conf):
    de = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or ""
    sess = os.environ.get("XDG_SESSION_TYPE", "")
    if not de:
        return "tty"
    text = f"{de} ({sess})" if sess else de
    if "hyprland" in de.lower():
        style = STYLE_NAMES.get(conf.get("RICE_HYPRLAND", "hyprland"))
        if style:
            text += f" · {style} style"
    return text


def terminal():
    for env in ("TERM_PROGRAM", "TERMINAL"):
        if os.environ.get(env):
            return os.environ[env]
    if os.environ.get("KITTY_WINDOW_ID"):
        return "kitty"
    try:                                           # the parent of our shell
        ppid = int(open(f"/proc/{os.getppid()}/stat").read().split(")")[1].split()[1])
        name = open(f"/proc/{ppid}/comm").read().strip()
        if name and name not in ("sh", "bash", "zsh", "fish", "login", "sudo", "su"):
            return name
    except (OSError, ValueError, IndexError):
        pass
    return ""


def vpn():
    if not shutil.which("nmcli"):
        return None
    for line in sh(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"], timeout=2).splitlines():
        name, _, typ = line.rpartition(":")
        if typ in ("wireguard", "vpn"):
            return name.replace("\\:", ":")
    return None


def collect():
    conf = read_kv("/etc/auxo/auxo.conf")
    with ThreadPoolExecutor(max_workers=5) as pool:       # the slow ones, side by side
        f_pk, f_gpu, f_disp, f_vpn, f_disk = (pool.submit(packages), pool.submit(gpus), pool.submit(displays),
                                              pool.submit(vpn), pool.submit(disk))
        mu, mt, su, st = memory()
        info = {
            "user": f"{os.environ.get('USER') or os.environ.get('LOGNAME') or 'user'}@{platform.node()}",
            "os": os_name(), "kernel": platform.release(), "init": "runit" if os.path.isdir(R("/etc/runit")) else "?",
            "uptime": uptime(), "shell": os.path.basename(os.environ.get("SHELL", "?")), "terminal": terminal(),
            "desktop": desktop(conf), "cpu": cpu(), "cpu_temp": cpu_temp(),
            "memory": [round(mu, 1), round(mt, 1)], "swap": [round(su, 1), round(st, 1)], "battery": battery(),
            "accent": conf.get("ACCENT") if conf.get("ACCENT") in ACCENTS else DEFAULT,
        }
        info["packages"] = f_pk.result()
        info["gpu"] = f_gpu.result()
        info["displays"] = f_disp.result()
        info["vpn"] = f_vpn.result()
        du, dt, fs = f_disk.result()
        info["disk"] = [round(du, 1), round(dt, 1), fs]
    return info


# ── drawing ───────────────────────────────────────────────────────────
class Paint:
    def __init__(self, on):
        self.on = on

    def rgb(self, h, bold=False):
        if not self.on:
            return ""
        r, g, b = hex_to_rgb(h)
        return f"\033[{'1;' if bold else ''}38;2;{r};{g};{b}m"

    def code(self, c):
        return c if self.on else ""


def lerp(a, b, t):
    ra, rb = hex_to_rgb(a), hex_to_rgb(b)
    return "#" + "".join(f"{int(x + (y - x) * t):02x}" for x, y in zip(ra, rb))


def bar(p, frac, width, a, b):
    n = max(0, min(width, int(round(frac * width))))
    if not p.on:
        return "[" + "#" * n + "-" * (width - n) + "]"
    out = "".join(p.rgb(lerp(a, b, i / max(width - 1, 1))) + "━" for i in range(n))
    return out + "\033[38;5;238m" + "━" * (width - n) + "\033[0m"


def visible_len(s):
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def render(info, small=False, logo=True, color=True, columns=100):
    p = Paint(color)
    c1, c2 = ACCENTS[info["accent"]]
    RS, D = p.code("\033[0m"), p.code("\033[38;5;245m")

    def row(key, value):
        return f"{p.rgb(c1)}{key:<9}{RS}{value}"

    def head(text):
        return f"{D}── {text} {'─' * max(0, 26 - len(text))}{RS}"

    mu, mt = info["memory"]
    su, st = info["swap"]
    du, dt, fs = info["disk"]
    lines = [f"{p.rgb(c1, True)}{info['user']}{RS}  {D}{info['os']}{RS}"]
    if small:
        lines += [row("desktop", info["desktop"]), row("uptime", info["uptime"]),
                  row("memory", f"{mu:.1f} / {mt:.1f} GiB")]
    else:
        lines += [head("system"),
                  row("kernel", info["kernel"] + (f" {D}· {info['init']}{RS}" if info["init"] != "?" else "")),
                  row("uptime", info["uptime"]),
                  row("packages", info["packages"]),
                  row("shell", info["shell"] + (f" {D}in {info['terminal']}{RS}" if info["terminal"] else "")),
                  row("desktop", info["desktop"]),
                  head("hardware"),
                  row("cpu", info["cpu"] + (f" {D}· {info['cpu_temp']}°C{RS}" if info.get("cpu_temp") else ""))]
        lines += [row("gpu", g) for g in info["gpu"]]
        lines += [row("display", d) for d in info["displays"][:3]]
        lines += [row("memory", f"{bar(p, mu / mt if mt else 0, 14, c1, c2)} {mu:.1f} / {mt:.1f} GiB"),
                  row("disk /", f"{bar(p, du / dt if dt else 0, 14, c1, c2)} {du:.0f} / {dt:.0f} GB {D}{fs}{RS}")]
        if st:
            lines.append(row("swap", f"{su:.1f} / {st:.1f} GiB"))
        if info.get("battery"):
            lines.append(row("battery", info["battery"]))
        lines.append(head("auxo"))
        lines.append(row("accent", f"{p.rgb(c1)}●{RS} {info['accent']}"))
        lines.append(row("vpn", (f"{p.rgb('#4ade80')}●{RS} " + info["vpn"]) if info.get("vpn") else f"{D}off{RS}"))
        lines.append("")
        if color:
            lines.append("".join(p.rgb(lerp(c1, c2, i / 7)) + "███" for i in range(8)) + RS)
            lines.append("".join(f"\033[{30 + i}m███" for i in range(8)) + RS)
    art = [] if not logo else (SMALL if small else LOGO)
    w = max((len(line) for line in art), default=0)
    text_w = max((visible_len(line) for line in lines), default=0)
    out = [""]
    if art and columns < w + text_w + 6:           # narrow terminal: the peak goes on top
        for i, line in enumerate(art):
            out.append("  " + p.rgb(lerp(c1, c2, i / max(len(art) - 1, 1)), True) + line + RS)
        out.append("")
        art, w = [], 0
    top = max(0, (len(lines) - len(art)) // 2) if art else 0
    for i in range(max(len(art) + top, len(lines))):
        j = i - top
        a = art[j] if 0 <= j < len(art) else ""
        col = p.rgb(lerp(c1, c2, j / max(len(art) - 1, 1)), True) if a else ""
        left = f"  {col}{a.ljust(w)}{RS}   " if art else "  "
        out.append(left + (lines[i] if i < len(lines) else ""))
    out.append("")
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(prog="auxo-fetch", description="A fast system summary in your Auxo accent colour.")
    p.add_argument("--json", action="store_true", help="everything as JSON")
    p.add_argument("--small", action="store_true", help="a short summary")
    p.add_argument("--no-logo", action="store_true", help="no Auxo peak")
    p.add_argument("--accent", choices=list(ACCENTS), help="draw in another accent")
    a = p.parse_args()
    info = collect()
    if a.accent:
        info["accent"] = a.accent
    if a.json:
        print(json.dumps(info, indent=2, ensure_ascii=False))
        return 0
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    print(render(info, small=a.small, logo=not a.no_logo, color=color,
                 columns=shutil.get_terminal_size((100, 24)).columns))
    return 0


if __name__ == "__main__":
    sys.exit(main())
