# Auxo Linux — Plymouth boot splash (script plugin)
# The images in this directory are copied from /usr/share/auxo/plymouth/accents/<accent>/
# by `auxo-tweak splash on` and every `auxo-tweak accent <name>`.

Window.SetBackgroundTopColor(0.043, 0.043, 0.059);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.059);

W = Window.GetWidth();
H = Window.GetHeight();
X0 = Window.GetX();
Y0 = Window.GetY();

S = 1;
if (H < 700) S = 0.7;

fun scaled (img) {
    return img.Scale(Math.Int(img.GetWidth() * S), Math.Int(img.GetHeight() * S));
}

# ── logo ─────────────────────────────────────────────
logo.image = scaled(Image("logo.png"));
LW = logo.image.GetWidth();
LH = logo.image.GetHeight();
LX = X0 + W / 2 - LW / 2;
LY = Y0 + H / 2 - LH / 2 - 50 * S;
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(LX, LY, 10);
logo.sprite.SetOpacity(0);

glow.image = scaled(Image("glow.png"));
glow.sprite = Sprite(glow.image);
glow.sprite.SetPosition(LX + LW / 2 - glow.image.GetWidth() / 2, LY + LH / 2 - glow.image.GetHeight() / 2, 1);
glow.sprite.SetOpacity(0);

summit.image = scaled(Image("summit.png"));
summit.sprite = Sprite(summit.image);
summit.sprite.SetPosition(LX + 112 * S - summit.image.GetWidth() / 2, LY + 26.5 * S - summit.image.GetHeight() / 2, 12);
summit.sprite.SetOpacity(0);

climber.image = scaled(Image("climber.png"));
climber.sprite = Sprite(climber.image);
climber.sprite.SetZ(15);
climber.sprite.SetOpacity(0);

word.image = scaled(Image("wordmark.png"));
word.sprite = Sprite(word.image);
word.sprite.SetPosition(X0 + W / 2 - word.image.GetWidth() / 2, LY + LH + 4 * S, 10);
word.sprite.SetOpacity(0);

# ── progress bar ─────────────────────────────────────
track.image = scaled(Image("track.png"));
TW = track.image.GetWidth();
TH = track.image.GetHeight();
BX = X0 + W / 2 - TW / 2;
BY = LY + LH + 72 * S;
track.sprite = Sprite(track.image);
track.sprite.SetPosition(BX, BY, 10);
track.sprite.SetOpacity(0);
bar.base = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(BX, BY, 11);

# trail of the Auxo mark, in logo.png pixels (16 px padding, 1.5× the 128-unit mark)
px[0] = 76;  py[0] = 160;
px[1] = 100; py[1] = 133;
px[2] = 118; py[2] = 151;
px[3] = 145; py[3] = 118;

frame = 0;
progress = 0;

# ── animation (called ~50× per second) ───────────────
fun refresh_callback () {
    global.frame = global.frame + 1;
    f = global.frame;
    intro = Math.Min(f / 40, 1);

    logo.sprite.SetOpacity(intro);
    word.sprite.SetOpacity(intro);
    track.sprite.SetOpacity(intro);
    glow.sprite.SetOpacity(intro * (0.75 + 0.25 * Math.Sin(f / 22)));
    summit.sprite.SetOpacity(intro * (0.7 + 0.3 * Math.Sin(f / 12)));

    if (f > 40) {
        t = f - 40;
        t = t - Math.Int(t / 130) * 130;
        if (t < 96) {
            seg = Math.Int(t / 32);
            u = (t - seg * 32) / 32;
            x = px[seg] + (px[seg + 1] - px[seg]) * u;
            y = py[seg] + (py[seg + 1] - py[seg]) * u;
            climber.sprite.SetPosition(LX + x * S - climber.image.GetWidth() / 2, LY + y * S - climber.image.GetHeight() / 2, 15);
            climber.sprite.SetOpacity(Math.Min(t / 8, 1));
        } else {
            climber.sprite.SetOpacity(Math.Max(0, 1 - (t - 96) / 14));
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, prog) {
    if (prog > global.progress) global.progress = prog;
    w = Math.Int(TW * global.progress);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.base.Scale(w, TH));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── messages and password prompt (disk encryption) ───
msg.sprite = Sprite();
msg.sprite.SetPosition(X0, Y0 + H - 60, 20);

fun message_callback (text) {
    img = Image.Text(text, 0.55, 0.55, 0.65);
    if (img) {
        msg.sprite.SetImage(img);
        msg.sprite.SetPosition(X0 + W / 2 - img.GetWidth() / 2, Y0 + H - 60, 20);
    }
}
Plymouth.SetMessageFunction(message_callback);

prompt.sprite = Sprite();
dots.sprite = Sprite();

fun display_password_callback (text, bullets) {
    track.sprite.SetOpacity(0);
    bar.sprite.SetOpacity(0);
    p = Image.Text(text, 0.93, 0.93, 0.96);
    if (p) {
        prompt.sprite.SetImage(p);
        prompt.sprite.SetPosition(X0 + W / 2 - p.GetWidth() / 2, BY - 6, 20);
        prompt.sprite.SetOpacity(1);
    }
    s = "";
    for (i = 0; i < bullets; i++) s = s + "● ";
    if (bullets == 0) s = " ";
    d = Image.Text(s, 0.93, 0.93, 0.96);
    if (d) {
        dots.sprite.SetImage(d);
        dots.sprite.SetPosition(X0 + W / 2 - d.GetWidth() / 2, BY + 24, 20);
        dots.sprite.SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    prompt.sprite.SetOpacity(0);
    dots.sprite.SetOpacity(0);
    track.sprite.SetOpacity(1);
    bar.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
