{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin": "8 14 0 14",
  "modules-left": [
    "custom/auxo",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery",
    "custom/update"
  ],
  "custom/auxo": {
    "format": "\u25b2",
    "tooltip": false,
    "on-click": "kitty -e auxo-tweak"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "hyprland/window": {
    "max-length": 50
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf6a9 muted",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "on-click": "auxo-sound"
  },
  "network": {
    "format-wifi": "\uf1eb  {essid}",
    "format-ethernet": "\uf6ff wired",
    "format-disconnected": "\uf071 offline",
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "\uf293",
    "format-connected": "\uf293 {num_connections}",
    "on-click": "blueman-manager"
  },
  "cpu": {
    "format": "\uf2db {usage}%",
    "interval": 3
  },
  "memory": {
    "format": "\uf538 {percentage}%",
    "interval": 5
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "states": {
      "warning": 25,
      "critical": 12
    }
  },
  "custom/update": {
    "exec": "xbps-install -Mun 2>/dev/null | wc -l",
    "interval": 1800,
    "format": "\uf021 {}",
    "on-click": "kitty -e auxo-update"
  },
  "tray": {
    "spacing": 8
  }
}
