{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin": "8 14 0 14",
  "modules-left": ["custom/auxo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "network", "bluetooth", "cpu", "memory", "battery", "custom/update"],
  "custom/auxo": { "format": "▲", "tooltip": false, "on-click": "kitty -e auxo-tweak" },
  "hyprland/workspaces": { "format": "{id}", "on-scroll-up": "hyprctl dispatch workspace e-1", "on-scroll-down": "hyprctl dispatch workspace e+1" },
  "hyprland/window": { "max-length": 50 },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "<tt>{calendar}</tt>" },
  "pulseaudio": { "format": "{icon} {volume}%", "format-muted": " muted", "format-icons": { "default": ["", "", ""] }, "on-click": "pavucontrol" },
  "network": { "format-wifi": "  {essid}", "format-ethernet": "󰈀 wired", "format-disconnected": "󰖪 offline", "on-click": "kitty -e nmtui" },
  "bluetooth": { "format": "", "format-connected": " {num_connections}", "on-click": "blueman-manager" },
  "cpu": { "format": " {usage}%", "interval": 3 },
  "memory": { "format": " {percentage}%", "interval": 5 },
  "battery": { "format": "{icon} {capacity}%", "format-icons": ["", "", "", "", ""], "states": { "warning": 25, "critical": 12 } },
  "custom/update": { "exec": "checkupdates 2>/dev/null | wc -l", "interval": 1800, "format": " {}", "on-click": "kitty -e auxo-update" },
  "tray": { "spacing": 8 }
}
