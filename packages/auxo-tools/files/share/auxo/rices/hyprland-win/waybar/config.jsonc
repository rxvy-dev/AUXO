// Auxo Hyprland · Windows style: one taskbar along the bottom, Start in the middle.
// auxo: bars stay where they are (Auxo Settings' bar position doesn't move the taskbar)
{
  "name": "taskbar",
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "exclusive": true,
  "include": [
    "~/.config/waybar/pins-30.jsonc"
  ],
  "modules-left": [],
  "modules-center": [
    "custom/start",
    "custom/search",
    "group/pins",
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "custom/update",
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "custom/start": {
    "format": "\u25b2",
    "tooltip": false,
    "on-click": "auxo-launcher --style windows"
  },
  "custom/search": {
    "format": "\uf002  Search",
    "tooltip": false,
    "on-click": "auxo-launcher --style windows"
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\uf6ff",
    "format-disconnected": "\uf071",
    "tooltip-format": "{essid} {ipaddr}",
    "on-click": "auxo-control --style windows"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\uf6a9",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "tooltip-format": "{volume}%",
    "on-click": "auxo-sound --style windows",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "battery": {
    "format": "{icon}",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "tooltip-format": "{capacity}%",
    "on-click": "auxo-control --style windows"
  },
  "custom/update": {
    "exec": "n=$(xbps-install -Mun 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"$n\" || echo ''",
    "interval": 1800,
    "format": "\uf021 {}",
    "tooltip": false,
    "on-click": "kitty -e auxo-update"
  },
  "clock": {
    "format": "{:%H:%M\n%d/%m/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "justify": "right"
  },
  "tray": {
    "spacing": 10,
    "icon-size": 16
  }
}
