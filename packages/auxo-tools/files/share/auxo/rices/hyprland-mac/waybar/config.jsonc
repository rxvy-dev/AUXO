// Auxo Hyprland · Mac style: a menu bar on top and a dock at the bottom.
// auxo: bars stay where they are (Auxo Settings' bar position doesn't move these two)
[
  {
    "name": "menubar",
    "layer": "top",
    "position": "top",
    "height": 30,
    "exclusive": true,
    "modules-left": ["custom/auxo", "hyprland/window", "hyprland/workspaces"],
    "modules-right": ["tray", "custom/update", "bluetooth", "network", "pulseaudio", "battery", "clock"],
    "custom/auxo": {
      "format": "▲",
      "tooltip": false,
      "on-click": "~/.config/waybar/auxo-menu.sh"
    },
    "hyprland/window": {
      "format": "{class}",
      "max-length": 30,
      "separate-outputs": true,
      "rewrite": {
        "^$": "Desktop",
        "firefox": "Firefox",
        "kitty": "Terminal",
        "thunar": "Files",
        "Thunar": "Files",
        "steam": "Steam",
        "com.discordapp.Discord": "Discord",
        "discord": "Discord",
        "auxo-settings": "Auxo Settings",
        "org.kde.dolphin": "Files",
        "code-oss": "Code"
      }
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "",
      "format-icons": {"default": ["", "", ""]},
      "tooltip-format": "{volume}%",
      "on-click": "pavucontrol",
      "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
      "format-wifi": "",
      "format-ethernet": "",
      "format-disconnected": "",
      "tooltip-format": "{essid} {ipaddr}",
      "on-click": "kitty -e nmtui"
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "",
      "format-connected": " {num_connections}",
      "on-click": "blueman-manager"
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""],
      "states": {"warning": 25, "critical": 12}
    },
    "custom/update": {
      "exec": "n=$(xbps-install -Mun 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"$n\" || echo ''",
      "interval": 1800,
      "format": " {}",
      "tooltip": false,
      "on-click": "kitty -e auxo-update"
    },
    "tray": {"spacing": 8, "icon-size": 15}
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 60,
    "margin-bottom": 8,
    "exclusive": true,
    "modules-center": ["image#launcher", "image#files", "image#firefox", "image#terminal", "image#steam",
                       "image#discord", "image#settings", "wlr/taskbar"],
    "image#launcher": {"path": "/usr/share/icons/Papirus/64x64/apps/applications-all.svg", "size": 44,
                       "tooltip": false, "on-click": "pkill wofi || wofi --show drun --conf ~/.config/wofi/spotlight --style ~/.config/wofi/spotlight.css"},
    "image#files": {"path": "/usr/share/icons/Papirus/64x64/apps/system-file-manager.svg", "size": 44,
                    "tooltip": false, "on-click": "thunar"},
    "image#firefox": {"path": "/usr/share/icons/Papirus/64x64/apps/firefox.svg", "size": 44,
                      "tooltip": false, "on-click": "firefox"},
    "image#terminal": {"path": "/usr/share/icons/Papirus/64x64/apps/utilities-terminal.svg", "size": 44,
                       "tooltip": false, "on-click": "kitty"},
    "image#steam": {"path": "/usr/share/icons/Papirus/64x64/apps/steam.svg", "size": 44, "tooltip": false,
                    "on-click": "steam || notify-send 'Steam isn’t installed' 'sudo auxo-tweak gaming on'"},
    "image#discord": {"path": "/usr/share/icons/Papirus/64x64/apps/discord.svg", "size": 44, "tooltip": false,
                      "on-click": "flatpak run com.discordapp.Discord || notify-send 'Discord isn’t installed' 'sudo auxo-tweak apps discord'"},
    "image#settings": {"path": "/usr/share/icons/Papirus/64x64/apps/preferences-system.svg", "size": 44,
                       "tooltip": false, "on-click": "auxo-settings"},
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 44,
      "icon-theme": "Papirus-Dark",
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close",
      "ignore-list": ["firefox", "kitty", "thunar", "Thunar", "steam", "com.discordapp.Discord", "auxo-settings"]
    }
  }
]
