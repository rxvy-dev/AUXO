// Auxo Hyprland · Mac style: a menu bar on top and a dock at the bottom.
// auxo: bars stay where they are (Auxo Settings' bar position doesn't move these two)
[
  {
    "name": "menubar",
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "modules-left": [
      "custom/auxo",
      "hyprland/window",
      "hyprland/workspaces"
    ],
    "modules-right": [
      "tray",
      "custom/update",
      "bluetooth",
      "network",
      "pulseaudio",
      "battery",
      "custom/search",
      "custom/control",
      "clock"
    ],
    "custom/auxo": {
      "format": "\u25b2",
      "tooltip": false,
      "on-click": "~/.config/waybar/auxo-menu.sh"
    },
    "hyprland/window": {
      "format": "{class}",
      "max-length": 30,
      "separate-outputs": true,
      "rewrite": {
        "^$": "Desktop",
        "firefox": "Firefox",
        "kitty": "Terminal",
        "thunar": "Files",
        "Thunar": "Files",
        "steam": "Steam",
        "com.discordapp.Discord": "Discord",
        "discord": "Discord",
        "auxo-settings": "Auxo Settings",
        "org.kde.dolphin": "Files",
        "code-oss": "Code"
      }
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-scroll-up": "hyprctl dispatch workspace e-1",
      "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "\uf6a9",
      "format-icons": {
        "default": [
          "\uf026",
          "\uf027",
          "\uf028"
        ]
      },
      "tooltip-format": "{volume}%",
      "on-click": "auxo-sound",
      "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
      "format-wifi": "\uf1eb",
      "format-ethernet": "\uf6ff",
      "format-disconnected": "\uf071",
      "tooltip-format": "{essid} {ipaddr}",
      "on-click": "kitty -e nmtui"
    },
    "bluetooth": {
      "format": "\uf293",
      "format-disabled": "\uf293",
      "format-connected": "\uf293 {num_connections}",
      "on-click": "blueman-manager"
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": [
        "\uf244",
        "\uf243",
        "\uf242",
        "\uf241",
        "\uf240"
      ],
      "states": {
        "warning": 25,
        "critical": 12
      }
    },
    "custom/update": {
      "exec": "n=$(xbps-install -Mun 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"$n\" || echo ''",
      "interval": 1800,
      "format": "\uf021 {}",
      "tooltip": false,
      "on-click": "kitty -e auxo-update"
    },
    "tray": {
      "spacing": 8,
      "icon-size": 15
    },
    "custom/search": {
      "format": "\uf002",
      "tooltip": false,
      "on-click": "pkill wofi || wofi --show drun --conf ~/.config/wofi/spotlight --style ~/.config/wofi/spotlight.css"
    },
    "custom/control": {
      "format": "\uf1de",
      "tooltip": false,
      "on-click": "auxo-control --style mac"
    }
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 68,
    "margin-bottom": 10,
    "exclusive": true,
    "modules-center": [
      "image#launcher",
      "group/pins",
      "wlr/taskbar"
    ],
    "image#launcher": {
      "path": "/usr/share/icons/Papirus/64x64/apps/applications-all.svg",
      "size": 48,
      "tooltip": false,
      "on-click": "auxo-launcher --style mac"
    },
    "include": [
      "~/.config/waybar/pins-48.jsonc"
    ]
  }
]
